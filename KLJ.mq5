input double InpADXTrendLevel = 25.0;
input group "====== Multi-Timeframe ======"
input ENUM_TIMEFRAMES InpMTF1 = PERIOD_MN1;
input ENUM_TIMEFRAMES InpMTF2 = PERIOD_W1;
input ENUM_TIMEFRAMES InpMTF3 = PERIOD_D1;
input ENUM_TIMEFRAMES InpMTF4 = PERIOD_H4;
input ENUM_TIMEFRAMES InpMTF5 = PERIOD_H1;
input group "====== Zone Colors ======"
input color InpColorOB = clrFireBrick;
input color InpColorOB_Bear = clrCrimson;
input color InpColorFVG = clrMediumOrchid;
input color InpColorDemand = clrSeaGreen;
input color InpColorSupply = clrDodgerBlue;
input color InpColorBreaker = clrGold;
input color InpColorPremium = clrIndianRed;
input color InpColorDiscount = clrForestGreen;
input color InpColorEQ = clrSilver;
input color InpColorFib = clrDarkGray;
input color InpColorOTE = clrAqua;
input group "====== DEBUGGING ======"
input bool InpShowDebugAlerts = false;
input bool InpLogSignalDetails = true;
input group "====== SIGNAL GATE AUDIT (why is there no signal?) ======"
input bool InpShowGateAudit = true;        // dashboard: per-gate survival + top blocker
input int  InpGateAuditLogEveryBars = 0;   // log the audit every N closed bars (0 = off)
input group "====== REAL-TIME MODE ======"
input bool InpRealTimeZones = true;
input bool InpUpdateEveryTick = true;
input bool InpRealTimeFractal = true; // draws provisional markers only; never feeds decisions
input group "====== PREVIEW LATENCY (NON-AUTHORITATIVE) ======"
input int InpMinRightConfirmBars = 1; // preview only; confirmed fractals always use N right bars
input bool InpShowEarlyBreakPreview = true; // non-authoritative live break preview
input double InpEarlyBreakBufferPoints = 0.0; // extra points required beyond structure price
input bool InpShowEarlyBreakTrigger = true; // show the same authoritative structure level before the break

input group "====== SETUP -> RETEST -> CONFIRMED (NEW v5.2.0) ======"
input bool InpUseRetestLifecycle = true;
input double InpInvalidateBufferATR = 0.3;
input bool InpAlertOnSetupReady = false;
input bool InpShowEntryPreview = true; // live entry preview on retest; non-authoritative
input bool InpAlertOnEntryPreview = true; // alert once per setup when live retest becomes directional
input bool InpInvalidateOnOppositeMSS = true; // closed opposite MSS cancels active setup and releases opposite scan
input group "====== MTF EXECUTION ENTRY (TACTICAL, NON-AUTHORITATIVE) ======"
input bool InpUseMTFExecutionEntry = true;
input bool InpAutoExecutionTF = true;
input ENUM_TIMEFRAMES InpExecutionTF = PERIOD_M5;
input double InpMTFEntryMaxDistanceATR = 1.0;
input bool InpAlertOnMTFExecutionEntry = true;
input bool InpShowMTFExecutionEntry = true;
input group "====== v6.4.1 SIGNAL VISIBILITY / ENTRIES ======"
input bool   InpShowEntries             = true;   // draw CONFIRMED entries as arrows + label on the chart
input bool   InpShowEntryPreviewMarks   = true;   // draw PREVIEW (live/unconfirmed) entries as hollow markers
input bool   InpShowSLTP                = true;   // draw Entry / SL / TP1 / TP2 lines + price labels
input double InpMinStrength             = 0.0;    // 0-100 minimum quality score required to DRAW a mark (0 = draw all)
input bool   InpRequireInstitutionalConfirm = false;  // true: top-down/institutional grade becomes a HARD veto (legacy behaviour)
input bool   InpShowTacticalEntries     = true;   // draw the MTF (tactical) entry: arrow + label, not only an HLINE
input bool   InpChaseFilter             = true;   // late-entry filter: distance from close to the entry edge in ATR
input double InpChaseMaxATR             = 1.50;   // beyond this x ATR the entry is stale -> "LATE - wait for retest"
input double InpEntryLabelATR           = 0.45;   // arrow/label offset from the bar, in ATR
input bool   InpAlertOnConfirmed        = true;   // Alert() popup on CONFIRMED (once per signal)
input bool   InpAlertPushOnConfirmed    = false;  // SendNotification() push on CONFIRMED
input bool   InpAlertOnSignalBar        = true;   // tactical alert/label/arrow anchor on the signal bar (exec bar = false)
input bool   InpShowZREEntryMarks       = true;   // draw ZRE zone-reaction entries as marks (secondary layer)
//--- v6.4.1 label stack: entries must survive a crowded chart.
input bool   InpHideLabelIfNoRoom       = false;  // true: hide a text label when no free pixel slot exists (v6.1.3 behaviour)
//--- v6.4.2 AUDIT switches (Phase 2 proof logging + Phase 3 filters).
input bool   InpDebugLog                = false;  // Phase-2 proof log: every direction decision + every veto reason
input bool   InpVetoContrarySignalDirection = false; // true: a zone whose ROLE contradicts the candidate direction is refused (default: logged only)
input int    InpSignalDedupCooldownBars = 3;      // minimum bars between two marks of the same zone+direction key
input bool   InpProximityFilter         = true;   // refuse an entry that sits right under strong resistance (BUY) / right over strong support (SELL)
input double InpProximityMaxATR         = 0.35;   // ...within this many ATR of the opposing edge
input int    InpLabelFontSize           = 0;      // chart label font (0 = per-element default, 7 recommended with Clean)
input int    InpMaxChartObjects         = 0;      // hard cap on QSMC_* chart objects per pass (0 = 1200, 900 with Clean)
input int    InpMaxZonesPerSide         = 5;      // demand / supply boxes drawn per side (Clean forces 2)
input bool   InpDeclutterMode           = false;  // "Clean" preset in one switch: fewest zones, small labels, capped objects

input group "====== v5.4.0 Performance & Stability ======"
input bool   InpUseIncrementalDetection = true;
input int    InpMaxStructuresKeep      = 30;
input int    InpMaxLiquidityKeep       = 40;
input int    InpMaxFVGKeep             = 25;
input int    InpMaxZonesKeep           = 20;
input int    InpRetestTimeoutBars      = 40;    // was 25; retest window (docs/SIGNAL_VISIBILITY_DIAGNOSIS.md)
input double InpRetestMaxDistanceATR   = 4.0;   // was 2.5; retest reach (docs/SIGNAL_VISIBILITY_DIAGNOSIS.md)
input bool   InpSmartObjectManagement  = true;
input bool   InpLogLifecycleTransitions = false;

input group "====== v5.6.6 RUNTIME / CAUSAL VALIDATION ======"
input bool InpRuntimeNoLookaheadAudit = true;
input int  InpRuntimeAuditBars = 500;

input group "====== v5.6.6 ADVANCED CAUSAL SWEEP ENGINE ======"
input bool   InpUseAdvancedSweepEngine      = true;
input double InpSweepEntryMinScore          = 75.0;
input int    InpSweepEntryMaxBarsAfterSweep = 3;
input double InpSweepEntryMinRR             = 1.50;
input bool   InpUseMergeSortRanking         = true;
input bool   InpUseMemoizedDP               = true;
input bool   InpUseFibonacciDP              = true;
input bool   InpUseCausalGraphOptimizer      = true;
input bool   InpUseDijkstraPathSearch         = true;
input bool   InpUseBellmanFordValidation      = true;
input bool   InpUseBeamSearch                 = true;
input int    InpBeamWidth                     = 5;
input int    InpGraphMaxPathHops              = 8;
input double InpGraphTemporalPenaltyATR       = 0.04;
input double InpGraphConflictPenalty          = 2.50;
input double InpGraphCausalReward             = 3.00;
input bool   InpRejectGraphNegativeCycle      = true;
input bool   InpRequireGraphAgreement         = false;
input bool   InpUseCausalDPOptimizer           = true;

input group "====== v5.6.9 CAUSAL DIAGNOSTICS ======"
input int    InpWatchMinQuality            = 75;

input group "====== v5.6.8 ALGORITHMIC CONFLUENCE ENGINE ======"
input bool   InpUseEvidenceIndependence      = true;
input bool   InpUseRegimeAdaptiveScoring     = true;
input bool   InpUseContextualCandleScoring   = true;
input double InpRegimeExpansionBonus         = 1.05;
input double InpRegimeTrendBonus             = 1.03;
input double InpRegimeRangePenalty           = 0.92;
input double InpRegimeCompressionPenalty     = 0.88;

input group "====== v6.0 PRIME LEVEL ENGINE (diagnostic-only) ======"
// PrimeLevelEngine: prime-number-derived price levels as an OPTIONAL
// statistical/confluence feature. Per design, this must never gate or
// authorize entry -- it only ever contributes a small, capped bonus to the
// diagnostic score, exactly like the existing EMA/VWAP confluence bonus.
input bool   InpUsePrimeLevels           = true;
input int    InpPrimeLevelCount          = 25;    // how many prime-derived levels to generate per side
input double InpPrimeLevelToleranceATR   = 0.15;  // proximity tolerance, ATR-normalized
input double InpPrimeScoreMaxBonus       = 2.0;   // hard cap on final_score contribution (points)
input bool   InpUseRelationshipMatrix    = true;
input double InpRelationshipScoreMaxBonus = 2.0;  // hard cap on final_score contribution (points)
input double InpMTFConflictPenalty       = 4.0;   // hard cap on final_score penalty for MTF_CONFLICT (points)

input group "====== v5.6.5 UNIVERSAL INSTRUMENT ADAPTER ======"
input bool InpUniversalInstrumentMode = true;
input bool InpUseExchangeTickSize      = true;
input bool InpUseBrokerStopsGeometry   = true;

input group "====== v5.6.3 Causal Institutional Sequence ======"
input bool   InpInstitutionalSequence       = true;
input int    InpSweepToStructureMaxBars     = 8;
input bool   InpRequireMSSAfterSweep         = false; // was true; MSS-only anchor was the top blocker (docs/SIGNAL_VISIBILITY_DIAGNOSIS.md)
input bool   InpAllowFVGEntryZone            = true;
input int    InpOrderZonePreSweepBars        = 1;
input bool   InpBlockEquilibriumEntries      = true;
input double InpEquilibriumBufferATR         = 0.15;
input bool   InpUseEMAVWAPConfluence         = true;
input double InpMaxStopATR                   = 4.0;   // was 3.0; also reused by ZRE (docs/SIGNAL_VISIBILITY_DIAGNOSIS.md)
input double InpMinRR1                       = 1.5;   // v6.4.2: audit required 1.5 (was 2.0) for TP1
input int    InpBlacklistExpiryBars          = 200;

input group "====== v5.6.3 Causal Event Graph ======"
input int    InpMaxCausalEventsKeep          = 160;
input int    InpAnchorSearchBars             = 60;
input double InpCausalDisplacementBodyATR    = 0.35;  // was 0.50; impulse/FVG body gate (docs/SIGNAL_VISIBILITY_DIAGNOSIS.md)
input bool   InpRequireCausalFVGBody          = true;
input bool   InpPreferMSSAnchor               = true;
input bool   InpEnableCausalInvariantChecks   = true;
input int    InpReplayAuditEveryBars          = 50;    // 0 disables incremental-vs-full audit

input group "====== v5.8.0 QUANT ENGINE (diagnostic-only) ======"
// The quantitative layer measures and classifies observable market data.
// It NEVER authorizes, gates or blocks an entry: the causal architecture
// of v5.6-v5.7 remains the only authority. All features are closed-bar,
// ATR-normalized and deterministic (identical on replay/refresh/restart).
input bool                 InpUseQuantEngine        = true;   // Master switch for the quant layer
input int                  InpATRBaselineBars       = 50;     // ATR baseline SMA window
input int                  InpATRPercentileBars     = 200;    // ATR percentile ranking window
input double               InpATRLowRatio           = 0.75;   // LOW volatility ratio  (ATR/baseline)
input double               InpATRHighRatio          = 1.30;   // HIGH volatility ratio
input double               InpATRExtremeRatio       = 2.00;   // EXTREME volatility ratio
input int                  InpVolumeAvgBars         = 20;     // Volume baseline window
input double               InpVolumeSpikeRatio      = 1.60;   // Volume spike threshold (x baseline)
input ENUM_QUANT_VOL_SOURCE InpQuantVolumeSource   = QVS_TICK; // Volume source (VWAP + features)
input ENUM_VWAP_RESET      InpVWAPReset             = VWAP_RESET_DAILY; // VWAP reset anchor (default = v5.7.5 behavior)
input ENUM_TIMEFRAMES      InpQuantEMATF            = PERIOD_CURRENT;   // EMA Slow TF for quant context (>chart TF = MTF, closed candles only)
input int                  InpEMASlopeBars          = 5;      // EMA slope lookback (closed bars)
input double               InpEMASlopeFlatATR       = 0.02;   // |slope|/ATR below this = FLAT
input double               InpLateEntryMaxATR       = 1.50;   // Late-entry risk threshold (ATR from zone)

input group "====== v5.8.0 ENTRY QUALITY ENGINE ======"
// Transparent soft-score model (Phase 21). The hard gates remain the
// existing causal/retest/confirmation architecture and are mirrored,
// never duplicated. Soft scores only RANK valid candidates.
input bool   InpShowEntryQualityPanel = true;   // Show STRUCTURAL/CONTEXT/EXECUTION/GEOMETRY rows
input double InpQualityHighThreshold  = 75.0;   // final blend >= this  -> HIGH_QUALITY
input double InpQualityAPlusThreshold = 88.0;   // final blend >= this  -> A_PLUS

input group "====== v5.8.0 ANALYTICAL SCALING (NO ORDERS, EVER) ======"
// Purely analytical/visual scaling plan. No OrderSend, no position
// modification: this is an INDICATOR.
input bool   InpUseAnalyticalScaling = true;   // Master switch for scale-in/out analysis
input double InpScale0AllocationPct  = 40.0;   // Initial allocation %
input double InpScale1AllocationPct  = 30.0;   // Scale 1 allocation % (requires NEW evidence)
input double InpScale2AllocationPct  = 30.0;   // Scale 2 allocation % (requires NEW evidence)
input double InpTP1ExitPct           = 25.0;   // TP1 exit % of position
input double InpTP2ExitPct           = 30.0;   // TP2 exit % of position
input double InpTP3ExitPct           = 45.0;   // TP3 exit % of position
input bool   InpShowScaleLevels      = true;   // Draw analytical scale trigger levels
input bool   InpUseBreakevenAnalysis = true;   // Breakeven analysis (display only)
input bool   InpAlertOnQuantEvents   = true;   // Alerts: TP reached / scale ready / BE / invalidation

input group "====== v5.8.0 REFERENCE RISK (theoretical, analytical) ======"
input double InpRiskRefVolume        = 0.10;   // Reference volume for theoretical risk (units)

input group "====== QUANTUM SMC INTELLIGENCE ENGINE (v6.0.0) ======"
input bool   InpUseCandleIntelligence       = true;  // Enable 15-point candle confirmation engine
input bool   InpUseInstitutionalBehavior    = true;  // Enable Institutional Behavior sequence analyzer
input bool   InpUseHistoricalAnalysis       = true;  // Track closed-bar setup outcomes & statistics
input int    InpMinHistoricalSampleSize     = 30;    // Minimum sample size for statistical validity

enum ENUM_MVP_MODE
{
   MVP_MODE_MASTER  = 0, // Master daily composite
   MVP_MODE_SESSION = 1, // Asia / London / New York
   MVP_MODE_BOTH    = 2, // Sessions AND daily master
   MVP_MODE_VISIBLE = 3, // Visible range
   MVP_MODE_FIXED   = 4, // Fixed bar count
   MVP_MODE_WEEKLY  = 5  // Weekly master
};

enum ENUM_MVP_ANCHOR
{
   MVP_ANCHOR_BROKER  = 0, // Broker day (00:00 server)
   MVP_ANCHOR_LONDON  = 1, // London session open
   MVP_ANCHOR_NEWYORK = 2  // New York session open
};

enum ENUM_MVP_DISTRIB
{
   MVP_DIST_TRIANGLE = 0, // Triangle at typical price (H+L+C)/3
   MVP_DIST_UNIFORM  = 1  // Uniform across the bar range
};

input group "====== v6.2.0 MASTER VOLUME PROFILE (observational) ======"
// Closed-bar volume-at-price. Never authorizes, gates or scores an entry.
// Tick volume is the honest default on FX/CFD. The buy/sell split is the
// close location inside each bar, not exchange bid/ask delta.
input bool                  InpUseMasterVolumeProfile = true;  // Master Volume Profile on/off
input ENUM_MVP_MODE         InpMVPMode                = MVP_MODE_BOTH; // Profile mode
input ENUM_MVP_ANCHOR       InpMVPDayAnchor           = MVP_ANCHOR_BROKER; // Master day boundary
input ENUM_QUANT_VOL_SOURCE InpMVPVolumeSource        = QVS_TICK; // Volume source
input ENUM_MVP_DISTRIB      InpMVPDistribution        = MVP_DIST_TRIANGLE; // Bar volume distribution
input double                InpMVPValueAreaPct        = 70.0;  // Value area percent (50-90)
input double                InpMVPRowATR              = 0.10;  // Row height as a fraction of ATR
input int                   InpMVPRowTicks            = 0;     // Fixed row in ticks (0 = ATR auto)
input int                   InpMVPWidthPct            = 14;    // Histogram width, percent of visible bars
input int                   InpMVPDayLookback         = 2;     // Trading days of master context
input int                   InpMVPSessionLookback     = 1;     // Sessions kept per region
input int                   InpMVPWeekLookback        = 4;     // Weeks of weekly context
input int                   InpMVPFixedBars           = 120;   // Bars in fixed-range mode
input int                   InpMVPMinBars             = 3;     // Minimum closed bars to publish a profile
input bool                  InpMVPShowHistogram       = true;  // Draw the volume histogram
input bool                  InpMVPShowSplit           = true;  // Buy/sell close-location split
input bool                  InpMVPShowValueArea       = true;  // Shade the active value area
input bool                  InpMVPShowHistory         = true;  // Prior POC / VAH / VAL lines
input bool                  InpMVPShowHistoryHistogram= false; // Also draw prior histograms
input bool                  InpMVPShowNakedPOC        = true;  // Untouched POC rays
input bool                  InpMVPShowNodes           = true;  // HVN / LVN ticks on the active profile
input bool                  InpMVPShowLegend          = true;  // Top-right readout
input double                InpMVPHVNFraction         = 0.60;  // HVN >= this fraction of POC volume
input double                InpMVPLVNFraction         = 0.35;  // LVN <= this fraction of median row
input bool                  InpMVPRunSelfTest         = true;  // Run the numeric self-test at init

input group "====== v6.6.0 SMART-MONEY VP / VWAP / VOLUME EVIDENCE ======"
// Reuses the existing chart-timeframe MVP, anchored VWAP and candle-volume
// calculations. Evidence is causal/closed-bar and only replaces sub-scores
// inside existing quality buckets; it cannot create or authorize a setup.
input bool InpUseSmartMoneyVolumeEvidence = true; // Blend closed-bar evidence into existing score groups
input bool InpSMFRunSelfTest              = true; // Deterministic synthetic scenario tests at init
input int  InpSMFReplayAuditEveryBars     = 50;   // 0 disables as-of profile replay checks
input int  InpSMFReplayAuditSamples       = 4;    // Samples per replay audit (1-8)

enum ENUM_ZRE_ENTRY_MODE
{
   ZRE_ENTRY_CLOSE     = 0,   // close of the rejection bar
   ZRE_ENTRY_ZONE_EDGE = 1    // near edge of the zone
};

input group "====== v6.3.0 ZONE REACTION ENGINE ======"
// Observational. Never creates, mutates, invalidates or authorizes a setup;
// entry authority stays with CalculateAITradeSetup / ManageSetupLifecycle.
// Every confirmed ZRE fact is read on the closed bar (rates_total-2) only.
// The 0-100 numbers are evidence-quality scores, not a win rate.
input bool   InpUseZRE                 = true;   // Zone Reaction Engine on/off
input int    InpZREMaxZones            = 6;      // Keep at most this many zones (1-12)
input int    InpZREMinZoneScore        = 60;     // Minimum ZONE STRENGTH to keep a zone (0-100)
input double InpZREZonePadATR          = 0.10;   // Half-height given to single-price levels, x ATR
input double InpZREMaxZoneATR          = 1.50;   // Merging never builds a zone taller than this x ATR
input int    InpZREFreshBars           = 96;     // Zone is "fresh" up to this many bars (M30: 2 days)
input bool   InpZRERunSelfTest         = true;   // Run ZRE_SelfTest() at init
input bool   InpZREDebugLog            = false;  // Print the zone list on every rebuild
// ---- Stage 2: zone states and arrival alerts (closed-bar facts; live = PREVIEW)
input double InpZREApproachATR         = 0.75;   // APPROACHING when the close is within this x ATR of the zone
input double InpZREBreakATR            = 0.30;   // BROKEN when a close is beyond the zone by more than this x ATR
input int    InpZREExpireBars          = 600;    // Zone older than this many bars is EXPIRED (age known only)
input bool   InpZREAlertPopup          = true;   // Alert() popup
input bool   InpZREAlertPush           = false;  // SendNotification() push
input bool   InpZREAlertSound          = false;  // PlaySound("alert.wav")
input int    InpZREAlertMinStrength    = 70;     // Alert only for zones with ZONE STRENGTH >= this
input bool   InpZREAlertApproaching    = false;  // Also alert on APPROACHING (noisy)
// ---- Stage 3: rejection on the CLOSED bar (a wick alone is never a rejection)
input double InpZREMaxPenetrationATR   = 0.35;   // Max wick penetration through the far zone edge, x ATR
input double InpZREMinWick             = 0.50;   // Rejection wick >= this fraction of the bar range
input bool   InpZREInsideReclaim       = false;  // false: close must reclaim the near zone edge; true: the midpoint suffices
input int    InpZREMinEvidence         = 2;      // Independent evidence groups required (wick/engulf/sweep/volume/displacement)
input double InpZREVolSupportRatio     = 1.10;   // Volume ratio counted as supporting evidence
// ---- Stage 4-5: ZONE REACTION SCORE and projected path
input int    InpZREMinScore            = 65;     // Minimum ZONE REACTION SCORE (0-100, evidence quality) for a signal
input ENUM_ZRE_ENTRY_MODE InpZREEntryMode = ZRE_ENTRY_CLOSE; // Entry = rejection close or zone edge
input int    InpZREProjectBars         = 16;     // Projection lines/arrows end after this many bars, then are deleted
input double InpZREStopZoneATR         = 0.40;   // STOP ZONE height at TP3, x ATR
input bool   InpZREShowPath            = true;   // Draw the projected path of a confirmed reaction
input bool   InpZREShowPreview         = true;   // Draw the live PREVIEW (unconfirmed) label
// ---- Stage 6: strongest-entry selection
input double InpZREConflictGap         = 8.0;    // BUY vs SELL closer than this many score points = NO TRADE
input int    InpZREFreshEntryBars      = 3;      // A signal is a selectable entry for this many bars
input int    InpZREWeakZoneScore       = 75;     // Zone strength below this is weak against a clear HTF bias

input group "====== v6.5.0 REACTION SIGNAL LAYER (RXN) ======"
// Sits BETWEEN raw ZRE observation and final execution authority. It classifies
// market state; it NEVER places, sizes, confirms or authorizes a trade.
//   ZONE -> LIQUIDITY -> REJECTION -> DISPLACEMENT -> STRUCTURE -> [RXN] -> CORE
// Every value below is closed-bar and availability-gated. The 0-100 numbers are
// EVIDENCE QUALITY. They are not a win rate and not a forecast: this system has
// never been statistically calibrated and nothing here claims otherwise.
// No existing default above is changed by this layer (audit section 23.1).
input bool   InpUseRXN                    = true;  // Reaction Signal Layer on/off (false = exact v6.4.2 behaviour)
input int    InpRXNTrackBars              = 24;    // Closed bars a reaction track is recomputed over (same window as TopDown_React30)
input int    InpRXNConfirmWindowBars      = 12;    // Displacement/structure must land within this many bars AFTER the rejection
input int    InpRXNAcceptBars             = 2;     // Consecutive closes beyond the far edge = MAINTAINED breakout (CASE A), not a rejection
input int    InpRXNMinZoneIntrinsic       = 60;    // Intrinsic zone quality needed to recover a level ZRE's min-score filter dropped
input int    InpRXNMaxZoneExtra           = 6;     // Recovered/tail zones RXN may evaluate beyond InpZREMaxZones (detection, not drawing)
// ---- level thresholds on RXN REACTION SCORE (evidence quality, 0-100) ----
input int    InpRXNMinReactionScore       = 45;    // LEVEL 1 WATCH -> LEVEL 2 REACTION ("the market reacted")
input int    InpRXNMinStrongScore         = 58;    // LEVEL 2 -> LEVEL 3 STRONG REACTION (requires displacement)
input int    InpRXNMinConfirmedScore      = 68;    // LEVEL 3 -> LEVEL 4 CONFIRMED (requires displacement AND structure)
input int    InpRXNPromoteScore           = 72;    // A CONFIRMED opposite reaction may release an UNCONFIRMED armed setup at/above this
// ---- volatility regime adaptation (reuses g_quant.vol_class; no new classifier) ----
input double InpRXNPenetrationVolMult     = 2.0;   // EXTREME volatility only: multiplier on InpZREMaxPenetrationATR (a news sweep is physically deeper)
input double InpRXNDispBodyRatioExtreme   = 0.70;  // EXTREME volatility only: body/range needed for displacement (raw range is noise there)
// ---- ownership bridge (audit BUG-05) ----
input bool   InpRXNPromoteOpposite        = true;  // A CONFIRMED opposite reaction may release an ARMED/PREVIEW setup (false = observe-only coexistence)
// ---- visibility / diagnostics ----
input bool   InpRXNShowReaction           = true;  // Draw LEVEL >= 2 reaction labels on the chart
input bool   InpRXNShowSuppression        = true;  // Show WHY a candidate was not promoted (never a bare "NO TRADE")
input bool   InpRXNAlerts                 = true;  // Alert on LEVEL >= 2, one per (zone, level, origin bar)
input bool   InpRXNDebug                  = false; // Print the [REACTION DEBUG] block for every candidate
input bool   InpRXNRunSelfTest            = true;  // Run RXN_SelfTest() at init

#define PFX "QSMC_"
#define MAX_CAUSAL_CHILDREN 8

//--- bit masking
#define BIT_MSS           (1<<0)
#define BIT_BOS           (1<<1)
#define BIT_CHOCH         (1<<2)
#define BIT_STRONG_OB     (1<<3)
#define BIT_LIQUIDITY     (1<<4)
#define BIT_FVG           (1<<5)
#define BIT_OTE           (1<<6)
#define BIT_HTF_BIAS      (1<<7)
#define BIT_KILLZONE      (1<<8)
#define BIT_DEMAND_ZONE   (1<<9)
#define BIT_JUDAS         (1<<10)
#define MAX_GRAPH_LINKS   16
#define MAX_CAUSAL_HOPS   6

//+------------------------------------------------------------------+
//|                                                                  |
//|  v6.1.0  PREDICTIVE MARKET INTELLIGENCE (PMI) ENGINE             |
//|                                                                  |
//|  CAUSAL MULTI-TIMEFRAME MARKET INTELLIGENCE & PRICE-PATH         |
//|  RESEARCH LAYER.                                                  |
//|                                                                  |
//|  CONTRACT (see docs/PREDICTIVE_ENGINE_AUDIT.md, section 7):       |
//|   - READ-ONLY with respect to the entry authority. The only       |
//|     function that can influence what the user reads as "entry     |
//|     ready" is PMI_EntryGate(), and it can only TIGHTEN           |
//|     (authoritative_ready AND pmi_chain_complete AND data_ok).    |
//|   - Every function is a pure function of the canonical           |
//|     chronological arrays plus an explicit as_of bar bound.       |
//|     No price data from any bar > as_of is ever read.             |
//|   - Every derived outcome has a measurement horizon and a        |
//|     censoring flag; censored samples are counted and excluded,   |
//|     never silently included in a hit rate.                       |
//|   - No weighted score is ever called a probability. Observed     |
//|     frequencies are labelled ANALOGUE HIT RATE with sample size, |
//|     period, symbol and timeframe disclosed.                      |
//|   - No trading functions. Indicator only.                        |
//|                                                                  |
//+------------------------------------------------------------------+

//====================================================================
// v6.1.0 PMI — CONSTANTS
//====================================================================
#define PMI_TF_COUNT            8      // W1 D1 H4 H1 M30 M15 M5 M1
#define PMI_FV_DIM              22     // market-state feature-vector dimension
#define PMI_MAX_PATHS           3      // A / B / C conditional price paths
#define PMI_MAX_COND_STATS      8      // conditional statistics slots
#define PMI_MAX_MISSING         8      // missing-condition slots
#define PMI_MAX_TREE_RECURSION  24     // hard safety cap (independent of InpPMIMaxTreeDepth)
#define PMI_NODE_NONE           -1     // "null" node index in the g_pmi_nodes[] pool
#define PMI_TREE_AXES           8      // feature partitioning axes
//--- Causal sequence stages (Phase 10). stageIndex in MarketState uses these.
#define PMI_STAGE_NONE          0
#define PMI_STAGE_LIQUIDITY     1
#define PMI_STAGE_SWEEP         2
#define PMI_STAGE_DISPLACEMENT  3
#define PMI_STAGE_MSS           4
#define PMI_STAGE_ZONE          5
#define PMI_STAGE_RETEST        6
#define PMI_STAGE_LTF           7
#define PMI_STAGE_ENTRY         8   // complete chain: entry-ready at chain level

#define PMI_DIGEST_RING         64     // per-closed-bar published digests kept for replay audit
#define PMI_MAX_LEVELS_AUDIT    40     // levels captured per digest for the replay audit
#define PMI_MAX_EVENT_LOG       200    // in-memory structured event log ring

//--- structure event types (Phase 6)
#define PMI_STRUCT_NONE         0
#define PMI_STRUCT_BOS          1
#define PMI_STRUCT_CHOCH        2
#define PMI_STRUCT_MSS          3

//--- liquidity status (Phase 7)
enum ENUM_PMI_LIQ_STATUS
{
   PMI_LIQ_UNTOUCHED   = 0,
   PMI_LIQ_APPROACHED  = 1,
   PMI_LIQ_SWEPT       = 2,
   PMI_LIQ_CONSUMED    = 3,
   PMI_LIQ_INVALIDATED = 4
};

//--- market regime (Phase 13)
enum ENUM_PMI_REGIME
{
   PMI_REGIME_UNKNOWN     = 0,
   PMI_REGIME_TREND_UP    = 1,
   PMI_REGIME_TREND_DOWN  = 2,
   PMI_REGIME_RANGE       = 3,
   PMI_REGIME_EXPANSION   = 4,
   PMI_REGIME_CONTRACTION = 5,
   PMI_REGIME_CHOP        = 6
};

//--- volatility regime (Phase 13, reuses the v5.8.0 classification vocabulary)
enum ENUM_PMI_VOLREGIME
{
   PMI_VOL_LOW     = 0,
   PMI_VOL_NORMAL  = 1,
   PMI_VOL_HIGH    = 2,
   PMI_VOL_EXTREME = 3
};

//--- sessions (Phase 14). Internally UTC (no local clock, no DST guessing
//--- beyond the broker offset already modelled by the existing engine).
enum ENUM_PMI_SESSION
{
   PMI_SESS_OFF     = 0,
   PMI_SESS_ASIA    = 1,
   PMI_SESS_LONDON  = 2,
   PMI_SESS_OVERLAP = 3,   // London / New York overlap
   PMI_SESS_NEWYORK = 4
};

//--- v6.5.1 SESSION AUDIT (F-04): the PMI session windows, stated once as
//--- named UTC hour bounds instead of as magic numbers inside an if-chain.
//--- These are the bounds the classifier ACTUALLY implements. The previous
//--- comment block claimed ASIA 00:00-09:00 and NEW YORK 12:00-21:00, but the
//--- branch order returned LONDON for 07:00-09:00 and OVERLAP for 12:00-16:00,
//--- so Asia really ended at 07:00 and New York really started at 16:00. The
//--- last branch (`h>=16 && h<21 -> NEWYORK`) was unreachable dead code.
//--- NOTE: these are FIXED reference market clocks in UTC. They are deliberately
//--- NOT the same model as the user-configurable killzones (InpAsianStart,
//--- InpLondonKillZoneStart, InpNewYorkKillZoneStart) that drive IsInSession();
//--- the divergence is documented in docs/KLJ_V6.5.1_FORENSIC_AUDIT.md.
#define PMI_UTC_ASIA_START     0
#define PMI_UTC_ASIA_END       7
#define PMI_UTC_LONDON_START   7
#define PMI_UTC_LONDON_END     12
#define PMI_UTC_OVERLAP_START  12
#define PMI_UTC_OVERLAP_END    16
#define PMI_UTC_NY_START       16
#define PMI_UTC_NY_END         21

//--- conditional price-path status (Phase 18)
enum ENUM_PMI_PATH_STATUS
{
   PMI_PATH_WAITING     = 0,
   PMI_PATH_ACTIVE      = 1,
   PMI_PATH_INVALIDATED = 2,
   PMI_PATH_COMPLETED   = 3
};

//--- no-trade codes (Phase 23)
enum ENUM_PMI_NO_TRADE
{
   PMI_NT_NONE                    = 0,
   PMI_NT_INSUFFICIENT_HISTORY    = 1,
   PMI_NT_DATA_QUALITY            = 2,
   PMI_NT_HTF_CONFLICT            = 3,
   PMI_NT_NO_LIQUIDITY            = 4,
   PMI_NT_SWEEP_WITHOUT_DISPLACE  = 5,
   PMI_NT_DISPLACE_WITHOUT_MSS    = 6,
   PMI_NT_MSS_WITHOUT_ZONE        = 7,
   PMI_NT_ZONE_INVALIDATED        = 8,
   PMI_NT_RETEST_MISSING          = 9,
   PMI_NT_LTF_CONFIRM_MISSING     = 10,
   PMI_NT_POOR_RR                 = 11,
   PMI_NT_INSUFFICIENT_SAMPLE     = 12,
   PMI_NT_CONFLICTING_PATHS       = 13,
   PMI_NT_CAUSAL_ORDER_BROKEN     = 14
};

//--- tree partitioning axes (Phase 16)
enum ENUM_PMI_TREE_AXIS
{
   PMI_AXIS_CONTEXT_DIR  = 0,   // HTF direction at segment start
   PMI_AXIS_PREMIUM_DISC = 1,   // D1 premium/discount at segment start
   PMI_AXIS_VOLATILITY   = 2,   // ATR ratio at segment start
   PMI_AXIS_SWEEP_DIR    = 3,   // last sweep direction before segment start
   PMI_AXIS_DISPLACEMENT = 4,   // displacement strength at segment start
   PMI_AXIS_MSS          = 5,   // MSS state at segment start
   PMI_AXIS_SESSION      = 6,   // session at segment start
   PMI_AXIS_STRUCTURE    = 7,   // chart structure direction at segment start
   PMI_AXIS_TIME         = 8    // fallback: index midpoint (always valid)
};

//====================================================================
// v6.1.0 PMI — INPUTS (new group; nothing existing is renamed or changed)
//====================================================================
input group "====== v6.1.0 PREDICTIVE MARKET INTELLIGENCE (research layer) ======"
// The PMI layer is an observation/research layer. It never authorizes a
// trade by itself: PMI_EntryGate() can only narrow the existing
// authoritative decision, never widen it.
input bool   InpUsePredictiveEngine     = true;   // Master switch for the PMI layer
input bool   InpShowPredictivePanel     = true;   // Draw the market-intelligence panel
input bool   InpDockPMIPanel              = true;   // Dock at lower-left, outside the newest candles
input bool   InpPMIPanelCollapsible       = true;
input int    InpPMIPanelX               = 8;      // Panel X distance (pixels)
input int    InpPMIPanelY               = 420;    // Panel Y distance (pixels)
input int    InpPMIPanelRefreshTicks    = 3;      // panel refresh (ticks) between closed bars
input int    InpPMIFractalN             = 3;      // Swing fractal N for PMI structure events
input int    InpPMIMTFWindow            = 200;    // Closed HTF bars analysed per timeframe
input int    InpPMILiquidityToleranceATR100 = 15; // level "approached" tolerance (ATR/100; 15 = 0.15 ATR)
input int    InpPMISweepDepthMinATR100  = 8;      // min sweep penetration, ATR/100 (8 = 0.08 ATR)
input int    InpPMISweepToMSSBars       = 12;     // sweep -> MSS causal lookback (bars)
input int    InpPMIOutcomeHorizonBars   = 60;     // analogue outcome measurement horizon (bars)
input int    InpPMIRiskATR100           = 100;    // reference risk = ATR * value/100 (100 = 1.0 ATR)
input int    InpPMITargetR100           = 200;    // analogue "target reached" threshold in R (200 = 2.0R)
input int    InpPMIKNearest             = 40;     // nearest historical analogues used for statistics
input int    InpPMIMinSamples           = 30;     // minimum sample size before a rate is published
input int    InpPMISnapshotCap          = 1500;   // retained feature-vector snapshots (ring)
input int    InpPMIMaxTreeDepth         = 6;      // recursive research tree maximum depth
input int    InpPMIMinTreeSegment       = 24;     // recursive research tree minimum segment (bars)
input bool   InpPMIIncrementalTree      = true;   // update the tree incrementally (never per tick)
input int    InpPMITreeRebuildEveryBars = 20;     // periodic full tree rebuild (bars); 0 = never
input bool   InpPMILogCSV               = false;  // write structured CSV research log
input bool   InpPMILogEvents            = false;  // print structured event log lines
input bool   InpPMIRunReplayAudit       = true;   // run the candle-by-candle replay audit
input int    InpPMIReplayAuditEveryBars = 25;     // replay audit cadence (bars)
input int    InpPMIReplayAuditBars      = 300;    // bars re-derived per replay audit
input bool   InpPMIRunSelfTestOnInit    = true;   // run the scenario self-test (Tests 1-4) at init
input bool   InpPMIRunWalkForward       = true;   // build the walk-forward (descriptive) report
input int    InpPMIWalkForwardFolds     = 3;      // TRAIN / VALIDATION / OOS folds (descriptive only)

//====================================================================
// SIGNAL OUTCOME LOG (Phase 1 measurement) - inputs
// Appended after every existing input so positional iCustom() callers
// keep their parameter order. Measurement only: nothing here gates,
// creates, mutates or authorizes a setup.
//====================================================================
enum ENUM_SIGLOG_ENTRY
{
   SIGLOG_ENTRY_PUBLISHED    = 0,   // limit at the published entry (filled only when a later bar trades through it)
   SIGLOG_ENTRY_SIGNAL_CLOSE = 1    // market fill at the close of the signal bar
};

input group "====== SIGNAL OUTCOME LOG (measurement only) ======"
// Outcomes are measured on bars AFTER the signal bar only. The CSV holds
// observed results of a logged sample; it is not a forecast.
input bool              InpSigLogCSV           = false;  // Write the per-signal outcome CSV (off = no file I/O)
input bool              InpSigLogCore          = true;   // CSV: log Layer A confirmed setups (source CORE)
input bool              InpSigLogZRE           = true;   // CSV: log Zone Reaction Engine signals (source ZRE)
input bool              InpSigLogZREShadow     = true;   // CSV: also log ZRE reactions rejected ONLY by the score gate (status SHADOW)
input ENUM_SIGLOG_ENTRY InpSigLogEntryRef      = SIGLOG_ENTRY_PUBLISHED; // Entry model used to measure R
input int               InpSigLogHorizonBars   = 60;     // Measurement window in bars (same default as the PMI horizon); then TIMEOUT at the close
input bool              InpSigLogCommonFolder  = true;   // Write to Terminal\Common\Files (false = MQL5\Files)
input string            InpSigLogFilePrefix    = "QSMC_signals"; // File name = prefix_SYMBOL_TF.csv
input bool              InpExportSignalBuffers = true;   // Fill hidden calculation buffers 3-14 (read by QSMC_Tester.mq5; nothing is drawn)
input bool              InpSigLogRunSelfTest   = true;   // Run SigLog_SelfTest() at init (diagnostic print only)

