  {
   SWEEP_NONE        = 0,
   SWEEP_WEAK        = 1,
   SWEEP_VALID       = 2,
   SWEEP_HIGH_QUALITY= 3
  };

// Analytical breakeven state (Phase 33). Display only.
enum ENUM_BE_STATE
  {
   BE_NOT_READY = 0,
   BE_CANDIDATE = 1,
   BE_CONFIRMED = 2
  };

