//+------------------------------------------------------------------+

//====================================================================
// SMALL CONFIRMED-FRACTAL / OB LOOKUP HELPERS
// (declared API kept total; used by flexible-mode tooling)
//====================================================================
bool IsFractalHigh(const double &h[],const int i,const int n,const int total)
{
   if(i<n || i+n>total-2) return false; // confirmed: fully inside closed bars
   for(int k=i-n;k<=i+n;k++)
   {
      if(k==i || k<0) continue;
      if(k<=i && h[k]>h[i]) return false;
      if(k>i && h[k]>=h[i]) return false;
   }
   return true;
}
bool IsFractalLow(const double &l[],const int i,const int n,const int total)
{
   if(i<n || i+n>total-2) return false;
   for(int k=i-n;k<=i+n;k++)
   {
      if(k==i || k<0) continue;
      if(k<=i && l[k]<l[i]) return false;
      if(k>i && l[k]<=l[i]) return false;
   }
   return true;
}
int FindLastBearishOB(const double &o[],const double &c[],const int from,const int lookback)
{
   for(int i=MathMin(from,ArraySize(g_order_blocks)-1);i>=0 && i>from-lookback;i--)
      if(!g_order_blocks[i].bullish && g_order_blocks[i].state!="MITIGATED")
         return i;
   return -1;
}
int FindLastBullishOB(const double &o[],const double &c[],const int from,const int lookback)
{
   for(int i=MathMin(from,ArraySize(g_order_blocks)-1);i>=0 && i>from-lookback;i--)
      if(g_order_blocks[i].bullish && g_order_blocks[i].state!="MITIGATED")
         return i;
   return -1;
}
string L_Trim(const string s)
{
   int a=0,b=StringLen(s)-1;
   while(a<=b && (StringGetCharacter(s,a)==' '||StringGetCharacter(s,a)==9)) a++;
   while(b>=a && (StringGetCharacter(s,b)==' '||StringGetCharacter(s,b)==9)) b--;
   return StringSubstr(s,a,MathMax(0,b-a+1));
}

//===== v6.2.0 MASTER VOLUME PROFILE =====================================
// Observational volume-at-price. Closed bars only (index rates_total-2).
// The forming bar is never read. This layer does not score, gate, mutate
// or authorize a setup — entry authority stays with the causal engine.
//
// Volume source is tick volume unless real volume is requested AND present.
// The buy/sell split is the close location inside each bar's range
// (close-location), not exchange bid/ask delta. The legend says so.
//
// Numeric spec: tools/mvp_model_test.py (triangle mass, grid, POC, value
// area, HVN/LVN, naked-row touch). Same formulas, same tie-breaks.
//==========================================================================
#define MVP_MAX_ROWS      80
#define MVP_MAX_PROFILES  16
#define MVP_MAX_NAKED     8
#define MVP_MAX_NODES     4

struct SMVPConfig
{
   ENUM_MVP_MODE   mode;
   ENUM_MVP_ANCHOR anchor;
   bool   triangle;
   bool   split;
   bool   show_hist;
   bool   show_hist_h;
   bool   show_histogram;
   bool   show_va;
   bool   show_naked;
   bool   show_nodes;
   bool   show_legend;
   bool   rich;
   double va_pct;
   double row_atr;
   double hvn_frac;
   double lvn_frac;
   int    row_ticks;
   int    width_pct;
   int    day_lb;
   int    sess_lb;
   int    week_lb;
   int    fixed_bars;
   int    min_bars;
};

struct SMVPProfile
{
   bool     valid;
   bool     developing;
   bool     dock_right;
   int      rows;
   int      poc_row;
   int      va_lo;
   int      va_hi;
   int      hvn_n;
   int      lvn_n;
   int      bar_start;
   int      bar_end;
   double   row_size;
   double   price_lo;
   double   total;
   double   buy_total;
   double   sell_total;
   double   poc;
   double   vah;
   double   val;
   double   vwap;
   double   peak;
   double   hvn_px[MVP_MAX_NODES];
   double   lvn_px[MVP_MAX_NODES];
   double   vol[MVP_MAX_ROWS];
   double   buy[MVP_MAX_ROWS];
   double   sell[MVP_MAX_ROWS];
   datetime t_start;
   datetime t_end;
};

SMVPConfig  g_mvp_cfg;
SMVPProfile g_mvp[MVP_MAX_PROFILES];
string      g_mvp_tag[MVP_MAX_PROFILES];
int         g_mvp_color[MVP_MAX_PROFILES];
int         g_mvp_count=0;
int         g_mvp_active=-1;
datetime    g_mvp_built_time=0;
int         g_mvp_view_sig=0;
bool        g_mvp_live=false;
bool        g_mvp_use_real=false;
string      g_mvp_source_label="TICK";
double      g_mvp_nk_px[MVP_MAX_NAKED];
datetime    g_mvp_nk_from[MVP_MAX_NAKED];
string      g_mvp_nk_tag[MVP_MAX_NAKED];
int         g_mvp_nk_n=0;

void MVP_LoadConfig()
{
   g_mvp_cfg.mode=InpMVPMode;
   g_mvp_cfg.anchor=InpMVPDayAnchor;
   g_mvp_cfg.triangle=(InpMVPDistribution==MVP_DIST_TRIANGLE);
   g_mvp_cfg.split=InpMVPShowSplit;
   g_mvp_cfg.show_histogram=InpMVPShowHistogram;
   g_mvp_cfg.show_va=InpMVPShowValueArea;
   g_mvp_cfg.show_legend=InpMVPShowLegend;
   g_mvp_cfg.show_hist=InpMVPShowHistory;
   g_mvp_cfg.show_hist_h=InpMVPShowHistoryHistogram;
   g_mvp_cfg.show_naked=InpMVPShowNakedPOC;
   g_mvp_cfg.show_nodes=InpMVPShowNodes;
   g_mvp_cfg.rich=!InpUltraCleanMode;
   double va=InpMVPValueAreaPct;
   if(va<50.0 || va>90.0) va=70.0;
   g_mvp_cfg.va_pct=va/100.0;
   double ra=InpMVPRowATR;
   if(ra<0.02 || ra>2.0) ra=0.10;
   g_mvp_cfg.row_atr=ra;
   int rt=InpMVPRowTicks;
   if(rt<0) rt=0;
   if(rt>5000) rt=5000;
   g_mvp_cfg.row_ticks=rt;
   int w=InpMVPWidthPct;
   if(w<6) w=6;
   if(w>30) w=30;
   g_mvp_cfg.width_pct=w;
   int d=InpMVPDayLookback;
   if(d<1) d=1;
   if(d>10) d=10;
   g_mvp_cfg.day_lb=d;
   int s=InpMVPSessionLookback;
   if(s<1) s=1;
   if(s>6) s=6;
   g_mvp_cfg.sess_lb=s;
   int wk=InpMVPWeekLookback;
   if(wk<1) wk=1;
   if(wk>8) wk=8;
   g_mvp_cfg.week_lb=wk;
   int fb=InpMVPFixedBars;
   if(fb<10) fb=10;
   if(fb>5000) fb=5000;
   g_mvp_cfg.fixed_bars=fb;
   int mb=InpMVPMinBars;
   if(mb<1) mb=1;
   if(mb>100) mb=100;
   g_mvp_cfg.min_bars=mb;
   double hf=InpMVPHVNFraction;
   if(hf<0.30 || hf>0.95) hf=0.60;
   g_mvp_cfg.hvn_frac=hf;
   double lf=InpMVPLVNFraction;
   if(lf<0.05 || lf>0.80) lf=0.35;
   g_mvp_cfg.lvn_frac=lf;
   // Ultra Clean keeps one active profile readable and drops the history.
   if(!g_mvp_cfg.rich)
   {
      g_mvp_cfg.show_hist=false;
      g_mvp_cfg.show_hist_h=false;
      g_mvp_cfg.show_nodes=false;
      g_mvp_cfg.show_naked=false;
      g_mvp_cfg.split=false;
   }
}

double MVP_Tick()
{
   double tick=g_instrument.tick_size;
   if(tick<=0.0) tick=SymbolInfoDouble(_Symbol,SYMBOL_TRADE_TICK_SIZE);
   if(tick<=0.0) tick=_Point;
   if(tick<=0.0) tick=0.00001;
   return tick;
}

double MVP_SnapRound(const double value, const double tick)
{
   if(tick<=0.0) return value;
   double n=MathFloor(value/tick+0.5);
   if(n<1.0) n=1.0;
   return n*tick;
}

double MVP_SnapUp(const double value, const double tick)
{
   if(tick<=0.0) return value;
   double n=MathCeil(value/tick-1e-12);
   if(n<1.0) n=1.0;
   return n*tick;
}

// Triangular density on [L,H] with mode M, mass inside [a0,b0].
// Peak-at-endpoint and out-of-range queries are defined (see the model test).
double MVP_TriangleMass(const double L, const double M, const double H,
                        const double a0, const double b0)
{
   if(b0<=a0 || H<=L) return 0.0;
   double a=a0, b=b0;
   if(a<L) a=L;
   if(b>H) b=H;
   if(b<=a) return 0.0;
   double mode=M;
   if(mode<L) mode=L;
   if(mode>H) mode=H;
   double span=H-L;
   double height=2.0/span;
   double total=0.0;
   if(mode>L)
   {
      double la=a, lb=b;
      if(la<L) la=L;
      if(lb>mode) lb=mode;
      if(lb>la)
      {
         double c=height/(mode-L);
         total+=c*0.5*(((lb-L)*(lb-L))-((la-L)*(la-L)));
      }
   }
   if(H>mode)
   {
      double ra=a, rb=b;
      if(ra<mode) ra=mode;
      if(rb>H) rb=H;
      if(rb>ra)
      {
         double c=height/(H-mode);
         double fb=H*rb-0.5*rb*rb;
         double fa=H*ra-0.5*ra*ra;
         total+=c*(fb-fa);
      }
   }
   if(total<0.0) total=0.0;
   return total;
}

bool MVP_PrepareGrid(SMVPProfile &p, const double price_min, const double price_max,
                     const double base_row, const double tick_in)
{
   double tick=(tick_in>0.0?tick_in:1e-8);
   double pmin=price_min, pmax=price_max;
   if(pmax<pmin) { double tmp=pmin; pmin=pmax; pmax=tmp; }
   if(!MathIsValidNumber(pmin) || !MathIsValidNumber(pmax)) return false;
   double span=pmax-pmin;
   if(span<tick) span=tick;
   double base=(base_row>tick?base_row:tick);
   base=MVP_SnapRound(base, tick);
   int mult=1;
   while(span>base*mult*(MVP_MAX_ROWS-2) && mult<256)
      mult*=2;
   double row_size=base*mult;
   double price_lo=MathFloor(pmin/row_size+1e-9)*row_size;
   double hi_edge=MathFloor(pmax/row_size+1e-9)*row_size;
   int rows=(int)MathFloor((hi_edge-price_lo)/row_size+1e-9)+1;
   if(rows<1) rows=1;
   if(rows>MVP_MAX_ROWS)
   {
      row_size=MVP_SnapUp(span/(MVP_MAX_ROWS-1), tick);
      price_lo=MathFloor(pmin/row_size+1e-9)*row_size;
      hi_edge=MathFloor(pmax/row_size+1e-9)*row_size;
      rows=(int)MathFloor((hi_edge-price_lo)/row_size+1e-9)+1;
      if(rows<1) rows=1;
      if(rows>MVP_MAX_ROWS) rows=MVP_MAX_ROWS;
   }
   p.price_lo=price_lo;
   p.row_size=row_size;
   p.rows=rows;
   p.total=0.0;
   p.buy_total=0.0;
   p.sell_total=0.0;
   p.valid=false;
   for(int i=0;i<MVP_MAX_ROWS;i++)
   {
      p.vol[i]=0.0;
      p.buy[i]=0.0;
      p.sell[i]=0.0;
   }
   return (row_size>0.0 && rows>0);
}

void MVP_Accumulate(SMVPProfile &p, const double low, const double high,
                    const double open_px, const double close_px, const double volume,
                    const bool triangle)
{
   if(volume<=0.0 || p.rows<=0 || p.row_size<=0.0) return;
   double lo=low, hi=high;
   if(hi<lo) { double tmp=lo; lo=hi; hi=tmp; }
   double rng=hi-lo;
   double buy_frac=0.5;
   if(rng>0.0) buy_frac=(close_px-lo)/rng;
   else if(close_px>open_px) buy_frac=1.0;
   else if(close_px<open_px) buy_frac=0.0;
   if(buy_frac<0.0) buy_frac=0.0;
   if(buy_frac>1.0) buy_frac=1.0;
   double buy_vol=volume*buy_frac;
   double sell_vol=volume-buy_vol;
   if(rng<=0.0)
   {
      int i=(int)MathFloor((lo-p.price_lo)/p.row_size+1e-9);
      if(i>=0 && i<p.rows)
      {
         p.vol[i]+=volume;
         p.buy[i]+=buy_vol;
         p.sell[i]+=sell_vol;
      }
      return;
   }
   double mode=(hi+lo+close_px)/3.0;
   if(mode<lo) mode=lo;
   if(mode>hi) mode=hi;
   for(int i=0;i<p.rows;i++)
   {
      double bot=p.price_lo+i*p.row_size;
      double top=bot+p.row_size;
      if(hi<=bot || lo>=top) continue;
      double w;
      if(triangle)
         w=MVP_TriangleMass(lo, mode, hi, bot, top);
      else
      {
         double a=(lo>bot?lo:bot);
         double b=(hi<top?hi:top);
         w=(b-a)/rng;
      }
      if(w<=0.0) continue;
      p.vol[i]+=volume*w;
      p.buy[i]+=buy_vol*w;
      p.sell[i]+=sell_vol*w;
   }
}

void MVP_SelectNodes(const int &idx[], const double &vol[], const int n,
                     const bool strongest, SMVPProfile &p, const bool hvn)
{
   bool used[];
   ArrayResize(used, n);
   for(int i=0;i<n;i++) used[i]=false;
   int keep=0;
   int limit=(n<MVP_MAX_NODES?n:MVP_MAX_NODES);
   while(keep<limit)
   {
      int best=-1;
      for(int i=0;i<n;i++)
      {
         if(used[i]) continue;
         if(best<0) { best=i; continue; }
         bool better;
         if(strongest)
            better=(vol[i]>vol[best]+1e-12) ||
                   (MathAbs(vol[i]-vol[best])<=1e-12 && idx[i]<idx[best]);
         else
            better=(vol[i]<vol[best]-1e-12) ||
                   (MathAbs(vol[i]-vol[best])<=1e-12 && idx[i]<idx[best]);
         if(better) best=i;
      }
      if(best<0) break;
      used[best]=true;
      double px=p.price_lo+(idx[best]+0.5)*p.row_size;
      if(hvn) p.hvn_px[keep]=px;
      else    p.lvn_px[keep]=px;
      keep++;
   }
   if(hvn) p.hvn_n=keep;
   else    p.lvn_n=keep;
}

void MVP_Finalize(SMVPProfile &p, const double va_pct, const double hvn_frac, const double lvn_frac)
{
   p.valid=false;
   p.hvn_n=0;
   p.lvn_n=0;
   if(p.rows<=0) return;
   int first=0;
   while(first<p.rows && p.vol[first]<=0.0) first++;
   int last=p.rows-1;
   while(last>first && p.vol[last]<=0.0) last--;
   if(first>=p.rows || last<first) return;
   if(first>0 || last<p.rows-1)
   {
      int n=last-first+1;
      if(first>0)
      {
         for(int i=0;i<n;i++)
         {
            p.vol[i]=p.vol[first+i];
            p.buy[i]=p.buy[first+i];
            p.sell[i]=p.sell[first+i];
         }
         p.price_lo+=first*p.row_size;
      }
      for(int i=n;i<p.rows;i++)
      {
         p.vol[i]=0.0;
         p.buy[i]=0.0;
         p.sell[i]=0.0;
      }
      p.rows=n;
   }
   p.total=0.0;
   p.buy_total=0.0;
   p.sell_total=0.0;
   for(int i=0;i<p.rows;i++)
   {
      p.total+=p.vol[i];
      p.buy_total+=p.buy[i];
      p.sell_total+=p.sell[i];
   }
   if(p.total<=0.0) return;
   double peak=p.vol[0];
   for(int i=1;i<p.rows;i++)
      if(p.vol[i]>peak) peak=p.vol[i];
   double vwap_num=0.0;
   for(int i=0;i<p.rows;i++)
      vwap_num+=p.vol[i]*(p.price_lo+(i+0.5)*p.row_size);
   double vwap=vwap_num/p.total;
   double tol=1e-9*MathMax(1.0, peak);
   int best=-1;
   double best_dist=0.0;
   for(int i=0;i<p.rows;i++)
   {
      if(p.vol[i]<peak-tol) continue;
      double center=p.price_lo+(i+0.5)*p.row_size;
      double dist=MathAbs(center-vwap);
      if(best<0 || dist<best_dist-1e-12 || (MathAbs(dist-best_dist)<=1e-12 && i<best))
      {
         best=i;
         best_dist=dist;
      }
   }
   if(best<0) return;
   int poc=best;
   p.poc_row=poc;
   p.peak=p.vol[poc];
   p.poc=p.price_lo+(poc+0.5)*p.row_size;
   p.vwap=vwap;
   double target=va_pct*p.total;
   if(target<p.vol[poc]) target=p.vol[poc];
   int lo=poc, hi=poc;
   double acc=p.vol[poc];
   int guard=0;
   while(acc+1e-9<target && guard<=p.rows+2)
   {
      guard++;
      double up=(hi+1<p.rows?p.vol[hi+1]:-1.0);
      double dn=(lo-1>=0?p.vol[lo-1]:-1.0);
      if(up<0.0 && dn<0.0) break;
      if(up>dn) { hi++; acc+=up; }
      else if(dn>up) { lo--; acc+=dn; }
      else if(up>=0.0 && dn>=0.0) { hi++; lo--; acc+=up+dn; }
      else if(up>=0.0) { hi++; acc+=up; }
      else { lo--; acc+=dn; }
   }
   p.va_lo=lo;
   p.va_hi=hi;
   p.val=p.price_lo+lo*p.row_size;
   p.vah=p.price_lo+(hi+1)*p.row_size;
   double tmp[];
   ArrayResize(tmp, p.rows);
   int pn=0;
   for(int i=0;i<p.rows;i++)
      if(p.vol[i]>0.0) tmp[pn++]=p.vol[i];
   for(int i=1;i<pn;i++)
   {
      double key=tmp[i];
      int j=i-1;
      while(j>=0 && tmp[j]>key) { tmp[j+1]=tmp[j]; j--; }
      tmp[j+1]=key;
   }
   double median=0.0;
   if(pn>0)
   {
      if((pn%2)==1) median=tmp[pn/2];
      else median=0.5*(tmp[pn/2-1]+tmp[pn/2]);
   }
   int h_idx[]; double h_vol[];
   int l_idx[]; double l_vol[];
   ArrayResize(h_idx, p.rows); ArrayResize(h_vol, p.rows);
   ArrayResize(l_idx, p.rows); ArrayResize(l_vol, p.rows);
   int hn=0, ln=0;
   for(int i=1;i<p.rows-1;i++)
   {
      if(i==poc) continue;
      if(p.vol[i]>p.vol[i-1] && p.vol[i]>=p.vol[i+1] &&
         p.vol[i]>=hvn_frac*peak && p.vol[i]>0.0)
      {
         h_idx[hn]=i; h_vol[hn]=p.vol[i]; hn++;
      }
      if(p.vol[i]<p.vol[i-1] && p.vol[i]<=p.vol[i+1] &&
         p.vol[i]>0.0 && p.vol[i]<=lvn_frac*median)
      {
         l_idx[ln]=i; l_vol[ln]=p.vol[i]; ln++;
      }
   }
   MVP_SelectNodes(h_idx, h_vol, hn, true, p, true);
   MVP_SelectNodes(l_idx, l_vol, ln, false, p, false);
   p.valid=true;
}

double MVP_VolumeAt(const int bar)
{
   if(bar<0 || bar>=ArraySize(g_buf_tv)) return 0.0;
   if(g_mvp_use_real && bar<ArraySize(g_buf_rv) && g_buf_rv[bar]>0)
      return (double)g_buf_rv[bar];
   if(g_buf_tv[bar]>0) return (double)g_buf_tv[bar];
   return 0.0;
}

bool MVP_DecideReal(const int closed)
{
   if(InpMVPVolumeSource!=QVS_REAL) return false;
   int n=0, nz=0;
   int from=(closed-199>0?closed-199:0);
   for(int b=from; b<=closed && b<ArraySize(g_buf_rv); b++)
   {
      n++;
      if(g_buf_rv[b]>0) nz++;
   }
   return (n>0 && nz*5>=n);
}

double MVP_BaseRow(const int closed, const double tick)
{
   if(g_mvp_cfg.row_ticks>0) return g_mvp_cfg.row_ticks*tick;
   // Always anchor row-size to the profile's own as-of ATR. Using global
   // g_atr here made historical profile reconstruction depend on today's ATR.
   double atr=(closed>=0 && closed<ArraySize(g_atr_buf) ? g_atr_buf[closed] : 0.0);
   if(!MathIsValidNumber(atr) || atr<=0.0)
   {
      double acc=0.0;
      int n=0;
      int from=(closed-19>0?closed-19:0);
      for(int b=from; b<=closed && b<ArraySize(g_buf_h); b++)
      {
         acc+=g_buf_h[b]-g_buf_l[b];
         n++;
      }
      atr=(n>0?acc/n:tick*20.0);
   }
   return atr*g_mvp_cfg.row_atr;
}

bool MVP_BuildBars(SMVPProfile &p, const int bar_from, const int bar_to,
                   const double base_row, const double tick)
{
   ZeroMemory(p);
   if(bar_from<0 || bar_to<bar_from || bar_to>=ArraySize(g_buf_h)) return false;
   double pmin=g_buf_l[bar_from];
   double pmax=g_buf_h[bar_from];
   for(int b=bar_from; b<=bar_to; b++)
   {
      if(g_buf_l[b]<pmin) pmin=g_buf_l[b];
      if(g_buf_h[b]>pmax) pmax=g_buf_h[b];
   }
   if(!MVP_PrepareGrid(p, pmin, pmax, base_row, tick)) return false;
   for(int b=bar_from; b<=bar_to; b++)
      MVP_Accumulate(p, g_buf_l[b], g_buf_h[b], g_buf_o[b], g_buf_c[b],
                     MVP_VolumeAt(b), g_mvp_cfg.triangle);
   MVP_Finalize(p, g_mvp_cfg.va_pct, g_mvp_cfg.hvn_frac, g_mvp_cfg.lvn_frac);
   if(!p.valid) return false;
   p.bar_start=bar_from;
   p.bar_end=bar_to;
   p.t_start=g_buf_t[bar_from];
   p.t_end=g_buf_t[bar_to];
   return true;
}

int MVP_AddProfile(const int bar_from, const int bar_to, const string tag,
                   const int color_id, const bool dock, const bool developing,
                   const double base_row, const double tick)
{
   if(g_mvp_count>=MVP_MAX_PROFILES) return -1;
   if(bar_from<0 || bar_to<bar_from) return -1;
   if(bar_to-bar_from+1<g_mvp_cfg.min_bars) return -1;
   int idx=g_mvp_count;
   if(!MVP_BuildBars(g_mvp[idx], bar_from, bar_to, base_row, tick)) return -1;
   g_mvp_tag[idx]=tag;
   g_mvp_color[idx]=color_id;
   g_mvp[idx].dock_right=dock;
   g_mvp[idx].developing=developing;
   g_mvp_count++;
   return idx;
}

datetime MVP_DayStart(const datetime t)
{
   if(g_mvp_cfg.anchor==MVP_ANCHOR_LONDON)
   {
      datetime a=SessionLocalDayStartServer(t, SESSION_LONDON, InpLondonStart);
      if(a>t) a-=86400;
      return a;
   }
   if(g_mvp_cfg.anchor==MVP_ANCHOR_NEWYORK)
   {
      datetime a=SessionLocalDayStartServer(t, SESSION_NEWYORK, InpNewYorkStart);
      if(a>t) a-=86400;
      return a;
   }
   return DayAnchor(t);
}

datetime MVP_WeekStart(const datetime t)
{
   MqlDateTime dt;
   TimeToStruct(t, dt);
   int back=(dt.day_of_week+6)%7;
   return DayAnchor(t-(datetime)back*86400);
}

// Overnight windows (start > end) attribute hours before `end` to the
// previous local date, so Friday 22:00 and Saturday 02:00 stay one session
// and Monday does not merge into Friday.
int MVP_OvernightDateKey(const datetime local, const int start_hour, const int end_hour)
{
   if(start_hour>end_hour)
   {
      MqlDateTime dt;
      TimeToStruct(local, dt);
      if(dt.hour<end_hour) return DateKey(local-86400);
   }
   return DateKey(local);
}

int MVP_SessionKey(const datetime server_time, const ENUM_SESSION_ID sess)
{
   datetime local=SessionLocalTime(server_time, sess);
   int start_hour=InpAsianStart;
   int end_hour=InpAsianEnd;
   if(sess==SESSION_LONDON) { start_hour=InpLondonStart; end_hour=InpLondonEnd; }
   else if(sess==SESSION_NEWYORK) { start_hour=InpNewYorkStart; end_hour=InpNewYorkEnd; }
   return MVP_OvernightDateKey(local, start_hour, end_hour);
}

bool MVP_FindPeriod(const int closed, const int back, const bool weekly,
                    int &bar_from, int &bar_to)
{
   bar_from=-1;
   bar_to=-1;
   if(closed<0 || closed>=ArraySize(g_buf_t)) return false;
   datetime target=(weekly?MVP_WeekStart(g_buf_t[closed]):MVP_DayStart(g_buf_t[closed]));
   int found=0;
   int b=closed;
   int guard=0;
   if(back>0)
   {
      while(b>=0 && found<back && guard<100000)
      {
         guard++;
         datetime ds=(weekly?MVP_WeekStart(g_buf_t[b]):MVP_DayStart(g_buf_t[b]));
         if(ds<target)
         {
            found++;
            target=ds;
            if(found==back) break;
         }
         b--;
      }
      if(found!=back) return false;
   }
   for(int i=closed; i>=0 && guard<120000; i--)
   {
      guard++;
      datetime ds=(weekly?MVP_WeekStart(g_buf_t[i]):MVP_DayStart(g_buf_t[i]));
      if(ds==target)
      {
         if(bar_to<0) bar_to=i;
         bar_from=i;
      }
      else if(bar_from>=0 && ds<target)
         break;
   }
   return (bar_from>=0 && bar_to>=bar_from);
}

void MVP_BuildDays(const int closed, const double base_row, const double tick)
{
   int lb=g_mvp_cfg.day_lb;
   if(!g_mvp_cfg.show_hist) lb=1;
   for(int back=0; back<lb; back++)
   {
      int f=0, t=0;
      if(!MVP_FindPeriod(closed, back, false, f, t)) continue;
      string tag=(back==0?"MASTER":"D-"+IntegerToString(back));
      MVP_AddProfile(f, t, tag, 0, back==0, back==0, base_row, tick);
   }
}

void MVP_BuildWeeks(const int closed, const double base_row, const double tick)
{
   int lb=g_mvp_cfg.week_lb;
   if(!g_mvp_cfg.show_hist) lb=1;
   for(int back=0; back<lb; back++)
   {
      int f=0, t=0;
      if(!MVP_FindPeriod(closed, back, true, f, t)) continue;
      string tag=(back==0?"WEEK":"W-"+IntegerToString(back));
      MVP_AddProfile(f, t, tag, 4, back==0, back==0, base_row, tick);
   }
}

void MVP_CollectSessionRuns(const int closed, const ENUM_SESSION_ID sess,
                            const int lookback, int &from_out[], int &to_out[], int &n_out)
{
   n_out=0;
   ArrayResize(from_out, lookback);
   ArrayResize(to_out, lookback);
   int raw=0;
   int b=closed;
   int guard=0;
   while(b>=0 && n_out<lookback && raw<lookback*6 && guard<100000)
   {
      guard++;
      if(!IsInSession(g_buf_t[b], sess)) { b--; continue; }
      int key=MVP_SessionKey(g_buf_t[b], sess);
      int to=b;
      while(b>=0 && IsInSession(g_buf_t[b], sess) && MVP_SessionKey(g_buf_t[b], sess)==key)
         b--;
      int from=b+1;
      raw++;
      if(to-from+1<g_mvp_cfg.min_bars) continue;
      from_out[n_out]=from;
      to_out[n_out]=to;
      n_out++;
   }
}

void MVP_BuildOneSession(const int closed, const ENUM_SESSION_ID sess, const string name,
                         const int color_id, const int lookback,
                         const double base_row, const double tick)
{
   int froms[], tos[];
   int n=0;
   MVP_CollectSessionRuns(closed, sess, lookback, froms, tos, n);
   for(int k=0; k<n; k++)
   {
      string tag=name;
      if(k>0) tag=name+"-"+IntegerToString(k);
      bool dev=(tos[k]==closed);
      MVP_AddProfile(froms[k], tos[k], tag, color_id, false, dev, base_row, tick);
   }
}

void MVP_DockNewestSession()
{
   int best=-1;
   for(int i=0;i<g_mvp_count;i++)
   {
      if(g_mvp_color[i]<1 || g_mvp_color[i]>3 || !g_mvp[i].valid) continue;
      if(best<0 || g_mvp[i].t_end>g_mvp[best].t_end ||
         (g_mvp[i].t_end==g_mvp[best].t_end && g_mvp_color[i]>g_mvp_color[best]))
         best=i;
   }
   for(int i=0;i<g_mvp_count;i++)
      if(g_mvp_color[i]>=1 && g_mvp_color[i]<=3)
         g_mvp[i].dock_right=(i==best);
}

void MVP_BuildSessions(const int closed, const double base_row, const double tick, const bool dock_newest)
{
   if(!dock_newest && !g_mvp_cfg.show_hist) return;
   int lb=g_mvp_cfg.sess_lb;
   if(!g_mvp_cfg.show_hist) lb=1;
   MVP_BuildOneSession(closed, SESSION_ASIA, "ASIA", 1, lb, base_row, tick);
   MVP_BuildOneSession(closed, SESSION_LONDON, "LONDON", 2, lb, base_row, tick);
   MVP_BuildOneSession(closed, SESSION_NEWYORK, "NY", 3, lb, base_row, tick);
   if(dock_newest) MVP_DockNewestSession();
}

void MVP_BuildVisible(const int closed, const double base_row, const double tick)
{
   int f=(closed-99>0?closed-99:0);
   int t=closed;
   long first_vis=ChartGetInteger(0, CHART_FIRST_VISIBLE_BAR);
   long vis=ChartGetInteger(0, CHART_VISIBLE_BARS);
   int total=ArraySize(g_buf_t);
   // Same reading as SafeLeftPanelWidth(): FIRST_VISIBLE_BAR is the series
   // index of the leftmost (oldest) visible bar. Series 0 is the forming bar,
   // which is clamped out below so it never enters the profile.
   if(first_vis>=0 && vis>1 && total>0)
   {
      long newest=first_vis-vis+1;
      if(newest<0) newest=0;
      if(first_vis>=total) first_vis=total-1;
      int chrono_left=(int)(total-1-first_vis);
      int chrono_right=(int)(total-1-newest);
      if(chrono_left<0) chrono_left=0;
      if(chrono_right>closed) chrono_right=closed;
      if(chrono_left>chrono_right) chrono_left=chrono_right;
      f=chrono_left;
      t=chrono_right;
   }
   MVP_AddProfile(f, t, "VRVP", 5, true, true, base_row, tick);
}

void MVP_BuildFixed(const int closed, const double base_row, const double tick)
{
   int t=closed;
   int f=t-g_mvp_cfg.fixed_bars+1;
   if(f<0) f=0;
   MVP_AddProfile(f, t, "FIXED", 5, true, true, base_row, tick);
}

void MVP_AssignActive()
{
   g_mvp_active=-1;
   for(int i=0;i<g_mvp_count;i++)
      if(g_mvp[i].valid && g_mvp[i].dock_right) { g_mvp_active=i; return; }
   for(int i=0;i<g_mvp_count;i++)
      if(g_mvp[i].valid)
      {
         g_mvp[i].dock_right=true;
         g_mvp_active=i;
         return;
      }
}

void MVP_CollectNaked(const int closed)
{
   g_mvp_nk_n=0;
   if(!g_mvp_cfg.show_naked) return;
   for(int i=0;i<g_mvp_count && g_mvp_nk_n<MVP_MAX_NAKED;i++)
   {
      if(!g_mvp[i].valid || g_mvp[i].developing || g_mvp[i].row_size<=0.0) continue;
      double bot=g_mvp[i].price_lo+g_mvp[i].poc_row*g_mvp[i].row_size;
      double top=bot+g_mvp[i].row_size;
      bool touched=false;
      int end_b=g_mvp[i].bar_end;
      for(int b=end_b+1; b<=closed && b<ArraySize(g_buf_h); b++)
      {
         if(g_buf_h[b]>=bot && g_buf_l[b]<=top) { touched=true; break; }
      }
      if(touched) continue;
      int k=g_mvp_nk_n;
      g_mvp_nk_px[k]=g_mvp[i].poc;
      g_mvp_nk_from[k]=g_mvp[i].t_end;
      g_mvp_nk_tag[k]=g_mvp_tag[i];
      g_mvp_nk_n++;
   }
}

int MVP_ViewSignature()
{
   int a=(int)ChartGetInteger(0, CHART_FIRST_VISIBLE_BAR);
   int b=(int)ChartGetInteger(0, CHART_VISIBLE_BARS);
   int c=(int)ChartGetInteger(0, CHART_SCALE);
   return a^(b<<10)^(c<<20);
}

void MVP_Rebuild(const int rates_total)
{
   MVP_LoadConfig();
   g_mvp_count=0;
   g_mvp_active=-1;
   g_mvp_nk_n=0;
   int closed=rates_total-2;
   if(closed<1) return;
   double tick=MVP_Tick();
   g_mvp_use_real=MVP_DecideReal(closed);
   if(g_mvp_use_real) g_mvp_source_label="REAL";
   else if(InpMVPVolumeSource==QVS_REAL) g_mvp_source_label="TICK*";
   else g_mvp_source_label="TICK";
   double base=MVP_BaseRow(closed, tick);
   if(g_mvp_cfg.mode==MVP_MODE_VISIBLE)
      MVP_BuildVisible(closed, base, tick);
   else if(g_mvp_cfg.mode==MVP_MODE_FIXED)
      MVP_BuildFixed(closed, base, tick);
   else if(g_mvp_cfg.mode==MVP_MODE_WEEKLY)
      MVP_BuildWeeks(closed, base, tick);
   else if(g_mvp_cfg.mode==MVP_MODE_SESSION)
      MVP_BuildSessions(closed, base, tick, true);
   else
   {
      MVP_BuildDays(closed, base, tick);
      if(g_mvp_cfg.mode==MVP_MODE_BOTH)
         MVP_BuildSessions(closed, base, tick, false);
   }
   MVP_AssignActive();
   MVP_CollectNaked(closed);
   g_mvp_view_sig=MVP_ViewSignature();
}

void MVP_EnsureDecisionSnapshot(const int rates_total,const bool force_rebuild)
{
   if(!InpUseMasterVolumeProfile || rates_total<3) return;
   // In non-visual Tester/optimization runs, the viewport-only display profile
   // is intentionally skipped; SMF uses its deterministic rolling as-of profile.
   if(InpMVPMode==MVP_MODE_VISIBLE &&
      (MQLInfoInteger(MQL_OPTIMIZATION)!=0 ||
       (MQLInfoInteger(MQL_TESTER)!=0 && MQLInfoInteger(MQL_VISUAL_MODE)==0))) return;
   if(ArraySize(g_buf_h)<rates_total || ArraySize(g_buf_l)<rates_total ||
      ArraySize(g_buf_o)<rates_total || ArraySize(g_buf_c)<rates_total ||
      ArraySize(g_buf_t)<rates_total || ArraySize(g_buf_tv)<rates_total) return;
   int closed=rates_total-2;
   if(closed<1 || closed+1>=ArraySize(g_buf_t)) return;
   datetime decision_bar_time=g_buf_t[closed];
   bool view_changed=(InpMVPMode==MVP_MODE_VISIBLE && MVP_ViewSignature()!=g_mvp_view_sig);
   bool rebuild=(force_rebuild || view_changed || g_mvp_built_time!=decision_bar_time ||
                 (g_mvp_built_time==0 && g_mvp_count==0));
   // The force flag is set only for a new bar, initial attach, or an explicit
   // full rebuild; ordinary same-bar redraws reuse the closed-bar snapshot.
   if(!rebuild) return;
   long profile_start_us=(long)GetMicrosecondCount();
   MVP_Rebuild(rates_total);
   g_smf_profile_builds++;
   SMF_RecordProfileTime(profile_start_us);
   g_mvp_built_time=decision_bar_time;
}

void MVP_Clear()
{
   ObjectsDeleteAll(0, PFX+"MVP_");
   g_mvp_count=0;
   g_mvp_active=-1;
   g_mvp_nk_n=0;
   g_mvp_built_time=0;
   g_mvp_live=false;
}

void MVP_Rect(const string name, const datetime t1, const double p1,
              const datetime t2, const double p2, const color col, const string tip)
{
   datetime a=t1, b=t2;
   double hi=p1, lo=p2;
   if(b<a) { datetime tmp=a; a=b; b=tmp; }
   if(lo>hi) { double tmp=hi; hi=lo; lo=tmp; }
   if(b<=a) b=a+60;
   if(ObjectFind(0, name)<0)
      ObjectCreate(0, name, OBJ_RECTANGLE, 0, a, hi, b, lo);
   ObjectMove(0, name, 0, a, hi);
   ObjectMove(0, name, 1, b, lo);
   ObjectSetInteger(0, name, OBJPROP_COLOR, col);
   ObjectSetInteger(0, name, OBJPROP_FILL, true);
   ObjectSetInteger(0, name, OBJPROP_BACK, true);
   ObjectSetInteger(0, name, OBJPROP_SELECTABLE, false);
   ObjectSetInteger(0, name, OBJPROP_HIDDEN, true);
   ObjectSetInteger(0, name, OBJPROP_WIDTH, 1);
   ObjectSetInteger(0, name, OBJPROP_ZORDER, 0);
   ObjectSetString(0, name, OBJPROP_TOOLTIP, tip);
}

void MVP_Line(const string name, const datetime t1, const datetime t2,
              const double price, const color col, const int style, const int width,
              const bool ray, const string tip)
{
   if(!MathIsValidNumber(price)) return;
   datetime a=t1, b=t2;
   if(b<=a) b=a+60;
   DrawFibLine(name, a, b, price, col, style, width);
   ObjectSetInteger(0, name, OBJPROP_RAY_RIGHT, ray);
   ObjectSetInteger(0, name, OBJPROP_BACK, false);
   ObjectSetInteger(0, name, OBJPROP_ZORDER, 6);
   ObjectSetInteger(0, name, OBJPROP_SELECTABLE, false);
   ObjectSetInteger(0, name, OBJPROP_HIDDEN, true);
   ObjectSetString(0, name, OBJPROP_TOOLTIP, tip);
}

void MVP_Tag(const string name, const datetime tm, const double price, const string text, const color col)
{
   if(!MathIsValidNumber(price) || text=="") return;
   DrawTextLabel(name, tm, price, text, col, true, 8);
   ObjectSetString(0, name, OBJPROP_FONT, "Consolas");
   ObjectSetInteger(0, name, OBJPROP_ZORDER, 8);
   ObjectSetInteger(0, name, OBJPROP_BACK, false);
}

void MVP_Label(const string name, const int x, const int y, const string text,
               const color col, const int size)
{
   if(ObjectFind(0, name)<0)
      ObjectCreate(0, name, OBJ_LABEL, 0, 0, 0);
   ObjectSetInteger(0, name, OBJPROP_CORNER, CORNER_LEFT_UPPER);
   ObjectSetInteger(0, name, OBJPROP_XDISTANCE, x);
   ObjectSetInteger(0, name, OBJPROP_YDISTANCE, y);
   ObjectSetString(0, name, OBJPROP_TEXT, text);
   ObjectSetInteger(0, name, OBJPROP_COLOR, col);
   ObjectSetInteger(0, name, OBJPROP_FONTSIZE, size);
   ObjectSetString(0, name, OBJPROP_FONT, "Consolas");
   ObjectSetInteger(0, name, OBJPROP_SELECTABLE, false);
   ObjectSetInteger(0, name, OBJPROP_HIDDEN, true);
   ObjectSetInteger(0, name, OBJPROP_BACK, false);
   ObjectSetInteger(0, name, OBJPROP_ZORDER, 12);
}

color MVP_PocColor(const int color_id)
{
   if(color_id==1) return clrAqua;
   if(color_id==2) return clrDodgerBlue;
   if(color_id==3) return clrKhaki;
   if(color_id==4) return clrSilver;
   return clrGold;
}

string MVP_Px(const double price)
{
   return DoubleToString(price, _Digits);
}

void MVP_HistSpan(const int idx, const int closed, datetime &t_left, datetime &t_right, bool &grow_right)
{
   int sec=PeriodSeconds();
   if(sec<=0) sec=60;
   if(!g_mvp[idx].dock_right)
   {
      long span=(long)(g_mvp[idx].t_end-g_mvp[idx].t_start);
      if(span<sec*4) span=sec*4;
      long width=span*38/100;
      if(width<sec) width=sec;
      t_left=g_mvp[idx].t_start;
      t_right=g_mvp[idx].t_start+(datetime)width;
      grow_right=true;
      return;
   }
   if(g_mvp_cfg.mode==MVP_MODE_VISIBLE)
   {
      long span=(long)(g_mvp[idx].t_end-g_mvp[idx].t_start);
      if(span<sec*4) span=sec*4;
      int pct=g_mvp_cfg.width_pct;
      if(pct<8) pct=8;
      long width=span*pct/100;
      if(width<sec*4) width=sec*4;
      t_right=g_mvp[idx].t_end+(datetime)sec;
      long left=(long)t_right-width;
      t_left=(left>0?(datetime)left:0);
      grow_right=false;
      return;
   }
   int vis=(int)ChartGetInteger(0, CHART_VISIBLE_BARS);
   if(vis<10) vis=40;
   int span_bars=vis*g_mvp_cfg.width_pct/100;
   if(span_bars<4) span_bars=4;
   if(span_bars>24) span_bars=24;
   long width=(long)span_bars*sec;
   datetime edge=g_buf_t[closed]+(datetime)sec;
   if(ChartGetInteger(0, CHART_SHIFT)!=0)
   {
      t_left=edge;
      t_right=edge+(datetime)width;
      grow_right=true;
   }
   else
   {
      t_right=edge;
      long left=(long)edge-width;
      t_left=(left>0?(datetime)left:0);
      grow_right=false;
   }
}

color MVP_RowColor(const int idx, const int row, const bool buy_side)
{
   double peak=g_mvp[idx].peak;
   double inten=(peak>0.0?g_mvp[idx].vol[row]/peak:0.0);
   if(inten<0.0) inten=0.0;
   if(inten>1.0) inten=1.0;
   bool in_va=(row>=g_mvp[idx].va_lo && row<=g_mvp[idx].va_hi);
   int fg=(in_va?20:8)+(int)MathRound((in_va?40.0:16.0)*inten);
   if(fg>72) fg=72;
   if(fg<6) fg=6;
   color base=clrDodgerBlue;
   if(g_mvp_cfg.split) base=(buy_side?clrLimeGreen:clrTomato);
   return BlendAgainstChartBackground(base, fg);
}

void MVP_DrawHistogram(const int idx, const int closed)
{
   if(!g_mvp_cfg.show_histogram || !g_mvp[idx].valid || g_mvp[idx].peak<=0.0) return;
   if(!g_mvp[idx].dock_right && !g_mvp_cfg.show_hist_h) return;
   datetime t_left=0, t_right=0;
   bool grow_right=true;
   MVP_HistSpan(idx, closed, t_left, t_right, grow_right);
   long full=(long)t_right-(long)t_left;
   if(full<1) return;
   for(int row=0; row<g_mvp[idx].rows; row++)
   {
      if(g_mvp[idx].vol[row]<=0.0) continue;
      // Prior histograms drop the thin tail so a full history does not
      // create hundreds of invisible rectangles. The active profile keeps
      // every traded row.
      if(!g_mvp[idx].dock_right && g_mvp[idx].vol[row]<g_mvp[idx].peak*0.04) continue;
      long row_w=(long)MathRound((double)full*g_mvp[idx].vol[row]/g_mvp[idx].peak);
      if(row_w<1) continue;
      if(row_w>full) row_w=full;
      double bot=g_mvp[idx].price_lo+row*g_mvp[idx].row_size;
      double top=bot+g_mvp[idx].row_size;
      string tip=g_mvp_tag[idx]+" "+MVP_Px(bot)+"-"+MVP_Px(top);
      if(!g_mvp_cfg.split)
      {
         datetime a, b;
         if(grow_right) { a=t_left; b=t_left+(datetime)row_w; }
         else { b=t_right; a=t_right-(datetime)row_w; }
         MVP_Rect(PFX+"MVP_H"+IntegerToString(idx)+"T"+IntegerToString(row),
                  a, top, b, bot, MVP_RowColor(idx, row, true), tip);
         continue;
      }
      long sell_w=0;
      if(g_mvp[idx].vol[row]>0.0)
         sell_w=(long)MathRound((double)row_w*g_mvp[idx].sell[row]/g_mvp[idx].vol[row]);
      if(sell_w<0) sell_w=0;
      if(sell_w>row_w) sell_w=row_w;
      long buy_w=row_w-sell_w;
      datetime sell_l, sell_r, buy_l, buy_r;
      if(grow_right)
      {
         sell_l=t_left;
         sell_r=t_left+(datetime)sell_w;
         buy_l=sell_r;
         buy_r=sell_r+(datetime)buy_w;
      }
      else
      {
         buy_r=t_right;
         buy_l=t_right-(datetime)buy_w;
         sell_r=buy_l;
         sell_l=buy_l-(datetime)sell_w;
      }
      if(sell_w>0)
         MVP_Rect(PFX+"MVP_H"+IntegerToString(idx)+"S"+IntegerToString(row),
                  sell_l, top, sell_r, bot, MVP_RowColor(idx, row, false), tip+" sell");
      if(buy_w>0)
         MVP_Rect(PFX+"MVP_H"+IntegerToString(idx)+"B"+IntegerToString(row),
                  buy_l, top, buy_r, bot, MVP_RowColor(idx, row, true), tip+" buy");
   }
}

bool MVP_PocIsNaked(const int idx)
{
   for(int k=0;k<g_mvp_nk_n;k++)
   {
      if(g_mvp_nk_from[k]!=g_mvp[idx].t_end) continue;
      if(MathAbs(g_mvp_nk_px[k]-g_mvp[idx].poc)<=g_mvp[idx].row_size*0.51)
         return true;
   }
   return false;
}

datetime MVP_SegmentEnd(const datetime t1, const datetime t2)
{
   int sec=PeriodSeconds();
   if(sec<=0) sec=60;
   datetime end=t2+(datetime)sec;
   if(end<t1+(datetime)(sec*4)) end=t1+(datetime)(sec*4);
   return end;
}

void MVP_DrawProfileLevels(const int idx, const int closed)
{
   if(!g_mvp[idx].valid) return;
   bool active=(idx==g_mvp_active);
   if(!active && !g_mvp_cfg.show_hist) return;
   int sec=PeriodSeconds();
   if(sec<=0) sec=60;
   datetime t1=g_mvp[idx].t_start;
   datetime t2=MVP_SegmentEnd(t1, g_mvp[idx].t_end);
   bool ray=active;
   color poc_col=MVP_PocColor(g_mvp_color[idx]);
   string tag=g_mvp_tag[idx];
   if(!MVP_PocIsNaked(idx))
   {
      int style=(active?STYLE_SOLID:STYLE_DOT);
      int width=(active?2:1);
      MVP_Line(PFX+"MVP_L"+IntegerToString(idx)+"P", t1, t2, g_mvp[idx].poc,
               poc_col, style, width, ray,
               tag+" POC "+MVP_Px(g_mvp[idx].poc));
   }
   MVP_Line(PFX+"MVP_L"+IntegerToString(idx)+"H", t1, t2, g_mvp[idx].vah,
            clrOrange, STYLE_DASH, 1, ray, tag+" VAH "+MVP_Px(g_mvp[idx].vah));
   MVP_Line(PFX+"MVP_L"+IntegerToString(idx)+"V", t1, t2, g_mvp[idx].val,
            clrOrange, STYLE_DASH, 1, ray, tag+" VAL "+MVP_Px(g_mvp[idx].val));
   if(!active || !g_mvp_cfg.show_legend)
   {
      datetime tag_t=(active?g_buf_t[closed]:t1);
      MVP_Tag(PFX+"MVP_TG"+IntegerToString(idx), tag_t, g_mvp[idx].poc,
              "POC "+tag, poc_col);
   }
}

void MVP_DrawNaked(const int closed)
{
   if(!g_mvp_cfg.show_naked) return;
   int sec=PeriodSeconds();
   if(sec<=0) sec=60;
   datetime now_t=g_buf_t[closed];
   for(int k=0;k<g_mvp_nk_n;k++)
   {
      datetime t1=g_mvp_nk_from[k];
      datetime t2=t1+(datetime)sec;
      if(t2<t1) t2=t1+60;
      string tip="nPOC "+g_mvp_nk_tag[k]+" "+MVP_Px(g_mvp_nk_px[k])+" untouched";
      MVP_Line(PFX+"MVP_NR"+IntegerToString(k), t1, t2, g_mvp_nk_px[k],
               clrGoldenrod, STYLE_DASH, 1, true, tip);
      MVP_Tag(PFX+"MVP_NK"+IntegerToString(k), now_t, g_mvp_nk_px[k],
              "nPOC "+g_mvp_nk_tag[k], clrGoldenrod);
   }
}

void MVP_DrawNodes(const int idx)
{
   if(!g_mvp_cfg.show_nodes || idx!=g_mvp_active || !g_mvp[idx].valid) return;
   int sec=PeriodSeconds();
   if(sec<=0) sec=60;
   datetime t1=g_mvp[idx].t_end;
   datetime t2=t1+(datetime)(sec*3);
   int n=0;
   for(int k=0;k<g_mvp[idx].hvn_n && n<MVP_MAX_NODES;k++)
   {
      double px=g_mvp[idx].hvn_px[k];
      if(MathAbs(px-g_mvp[idx].poc)<g_mvp[idx].row_size*0.25) continue;
      MVP_Line(PFX+"MVP_ND"+IntegerToString(n), t1, t2, px, clrAqua, STYLE_SOLID, 2, false,
               "HVN "+MVP_Px(px));
      n++;
   }
   for(int k=0;k<g_mvp[idx].lvn_n && n<MVP_MAX_NODES*2;k++)
   {
      double px=g_mvp[idx].lvn_px[k];
      MVP_Line(PFX+"MVP_ND"+IntegerToString(n), t1, t2, px, clrMagenta, STYLE_SOLID, 2, false,
               "LVN "+MVP_Px(px));
      n++;
   }
}

void MVP_DrawValueBox(const int idx)
{
   if(!g_mvp_cfg.show_va || !g_mvp[idx].valid) return;
   int sec=PeriodSeconds();
   if(sec<=0) sec=60;
   datetime t1=g_mvp[idx].t_start;
   datetime t2=g_mvp[idx].t_end+(datetime)sec;
   if(t2<t1+(datetime)(sec*2)) t2=t1+(datetime)(sec*2);
   color col=BlendAgainstChartBackground(clrGold, 12);
   MVP_Rect(PFX+"MVP_VA", t1, g_mvp[idx].vah, t2, g_mvp[idx].val, col,
            g_mvp_tag[idx]+" value area "+IntegerToString((int)MathRound(g_mvp_cfg.va_pct*100.0))+"%");
}

void MVP_DrawLegend(const int idx, const bool waiting)
{
   if(!g_mvp_cfg.show_legend) return;
   int chart_w=(int)ChartGetInteger(0, CHART_WIDTH_IN_PIXELS);
   if(chart_w<240) return;
   int scale_pad=64;
   if(ChartGetInteger(0, CHART_SHOW_PRICE_SCALE)==0) scale_pad=6;
   int box_w=196;
   int box_h=58;
   int box_x=chart_w-scale_pad-box_w-6;
   if(box_x<g_badge_x+g_badge_w+8) return;
   string bg=PFX+"MVP_LEGBOX";
   if(ObjectFind(0, bg)<0)
      ObjectCreate(0, bg, OBJ_RECTANGLE_LABEL, 0, 0, 0);
   ObjectSetInteger(0, bg, OBJPROP_CORNER, CORNER_LEFT_UPPER);
   ObjectSetInteger(0, bg, OBJPROP_XDISTANCE, box_x);
   ObjectSetInteger(0, bg, OBJPROP_YDISTANCE, 4);
   ObjectSetInteger(0, bg, OBJPROP_XSIZE, box_w);
   ObjectSetInteger(0, bg, OBJPROP_YSIZE, box_h);
   ObjectSetInteger(0, bg, OBJPROP_BGCOLOR, (color)0x0C0C12);
   ObjectSetInteger(0, bg, OBJPROP_COLOR, clrGold);
   ObjectSetInteger(0, bg, OBJPROP_BORDER_TYPE, BORDER_FLAT);
   ObjectSetInteger(0, bg, OBJPROP_WIDTH, 1);
   ObjectSetInteger(0, bg, OBJPROP_BACK, false);
   ObjectSetInteger(0, bg, OBJPROP_SELECTABLE, false);
   ObjectSetInteger(0, bg, OBJPROP_HIDDEN, true);
   ObjectSetInteger(0, bg, OBJPROP_ZORDER, 11);
   ObjectSetString(0, bg, OBJPROP_TOOLTIP,
      "Buy/sell split is close location inside each bar, not exchange bid/ask. Volume source: "+g_mvp_source_label+". Chart shift parks the histogram in the right margin.");
   int x=box_x+8;
   int y=8;
   if(waiting || idx<0 || !g_mvp[idx].valid)
   {
      MVP_Label(PFX+"MVP_LEG0", x, y, "MASTER VOLUME", clrWhite, 8);
      MVP_Label(PFX+"MVP_LEG1", x, y+13, "not enough closed bars", clrSilver, 8);
      MVP_Label(PFX+"MVP_LEG2", x, y+26, "source "+g_mvp_source_label, clrDimGray, 8);
      MVP_Label(PFX+"MVP_LEG3", x, y+39, "observational only", clrDimGray, 8);
      return;
   }
   string title=g_mvp_tag[idx]+" VOLUME";
   string state=(g_mvp[idx].developing?"DEV":"CLOSED");
   string l2="POC  "+MVP_Px(g_mvp[idx].poc);
   string l3="VAH "+MVP_Px(g_mvp[idx].vah)+"  VAL "+MVP_Px(g_mvp[idx].val);
   string dlt="";
   if(g_mvp_cfg.split && g_mvp[idx].total>0.0)
   {
      double delta=(g_mvp[idx].buy_total-g_mvp[idx].sell_total)/g_mvp[idx].total*100.0;
      dlt=(delta>=0.0?"+":"")+DoubleToString(delta, 0)+"% buy";
   }
   else
      dlt="total";
   string l4=state+"  "+g_mvp_source_label+"  "+dlt;
   color dcol=clrSilver;
   if(g_mvp_cfg.split && g_mvp[idx].total>0.0)
   {
      double delta=(g_mvp[idx].buy_total-g_mvp[idx].sell_total)/g_mvp[idx].total*100.0;
      if(delta>=5.0) dcol=clrLimeGreen;
      else if(delta<=-5.0) dcol=clrTomato;
   }
   MVP_Label(PFX+"MVP_LEG0", x, y, title, clrWhite, 8);
   MVP_Label(PFX+"MVP_LEG1", x, y+13, l2, clrGold, 8);
   MVP_Label(PFX+"MVP_LEG2", x, y+26, l3, clrOrange, 8);
   MVP_Label(PFX+"MVP_LEG3", x, y+39, l4, dcol, 8);
}

void MVP_Draw(const int rates_total)
{
   ObjectsDeleteAll(0, PFX+"MVP_");
   int closed=rates_total-2;
   if(closed<1 || closed>=ArraySize(g_buf_t))
   {
      MVP_DrawLegend(-1, true);
      return;
   }
   if(g_mvp_active<0 || g_mvp_active>=g_mvp_count || !g_mvp[g_mvp_active].valid)
   {
      MVP_DrawLegend(-1, true);
      g_mvp_live=true;
      return;
   }
   MVP_DrawValueBox(g_mvp_active);
   for(int i=0;i<g_mvp_count;i++)
      if(i!=g_mvp_active) MVP_DrawHistogram(i, closed);
   MVP_DrawHistogram(g_mvp_active, closed);
   for(int i=0;i<g_mvp_count;i++)
      if(i!=g_mvp_active) MVP_DrawProfileLevels(i, closed);
   MVP_DrawNaked(closed);
   MVP_DrawProfileLevels(g_mvp_active, closed);
   MVP_DrawNodes(g_mvp_active);
   MVP_DrawLegend(g_mvp_active, false);
   g_mvp_live=true;
}

void MVP_Update(const int rates_total, const bool force_rebuild, const bool force_draw)
{
   if(!InpUseMasterVolumeProfile)
   {
      if(g_mvp_live) MVP_Clear();
      return;
   }
   if(MQLInfoInteger(MQL_OPTIMIZATION)!=0) return;
   if(MQLInfoInteger(MQL_TESTER)!=0 && MQLInfoInteger(MQL_VISUAL_MODE)==0) return;
   if(rates_total<3) return;
   if(ArraySize(g_buf_h)<rates_total || ArraySize(g_buf_l)<rates_total ||
      ArraySize(g_buf_o)<rates_total || ArraySize(g_buf_c)<rates_total ||
      ArraySize(g_buf_t)<rates_total || ArraySize(g_buf_tv)<rates_total)
      return;
   int closed=rates_total-2;
   if(closed<1) return;
   bool view_changed=false;
   if(InpMVPMode==MVP_MODE_VISIBLE)
      view_changed=(MVP_ViewSignature()!=g_mvp_view_sig);
   bool rebuild=force_rebuild || view_changed || g_mvp_built_time!=g_buf_t[closed] ||
                (g_mvp_count==0 && g_mvp_built_time==0);
   bool draw=rebuild || force_draw;
   if(!draw) return;
   if(rebuild)
   {
      MVP_Rebuild(rates_total);
      g_mvp_built_time=g_buf_t[closed];
   }
   MVP_Draw(rates_total);
   ResolveChartLabelCollisions();
}

//====================================================================
// v6.6.0 SMART-MONEY PROFILE / VWAP / VOLUME-PROXY EVIDENCE
// All calculations consume the canonical chronological arrays and the
// last closed bar only. This block is observational/contextual; causal
// sequence, geometry, lifecycle, and entry authority remain unchanged.
//====================================================================

double SMF_Clamp(const double value,const double lo,const double hi)
{
   if(value<lo) return lo;
   if(value>hi) return hi;
   return value;
}

void SMF_AddNote(string &dst,const string note,const int max_len=700)
{
   if(note=="") return;
   if(dst!="") dst+="; ";
   dst+=note;
   if(StringLen(dst)>max_len) dst=StringSubstr(dst,0,max_len-3)+"...";
}

ulong SMF_HashString(const string value,ulong seed=1469598103934665603)
{
   ulong hash=seed;
   for(int i=0;i<StringLen(value);i++)
   {
      hash^=(ulong)StringGetCharacter(value,i);
      hash*=1099511628211;
   }
   return hash;
}

string SMF_OrderFlowDisclosure()
{
   return "VOLUME PROXY ONLY; TRUE BID/ASK / AGGRESSOR FLOW UNAVAILABLE";
}

string SMF_MVPSourceLabel(const bool use_real)
{
   if(use_real) return "REAL TOTAL VOLUME (NO BID/ASK)";
   if(InpMVPVolumeSource==QVS_REAL) return "TICK-FALLBACK TOTAL VOLUME";
   return "TICK VOLUME";
}

bool SMF_CausalTimeValid(const datetime availability_time,const datetime decision_time)
{
   return (availability_time>0 && decision_time>0 && availability_time<=decision_time);
}

bool SMF_ProfileAsOfValid(const int profile_end_bar,const int decision_bar,
                          const datetime profile_available_time,const datetime decision_time)
{
   return (profile_end_bar>=0 && decision_bar>=0 && profile_end_bar<=decision_bar &&
           SMF_CausalTimeValid(profile_available_time,decision_time));
}

void SMF_ResetEvidence(SSmartMoneyEvidence &e)
{
   e.enabled=false; e.valid=false; e.causal_ok=true; e.closed_bar=-1; e.direction=0;
   e.candle_close_location=0.5; e.candle_body_ratio=0.0; e.candle_wick_ratio=0.0;
   e.candle_confirms_buy=false; e.candle_confirms_sell=false;
   e.candle_is_displacement=false; e.candle_effort_result_proxy=false;
   e.decision_time=0; e.profile_start_time=0; e.profile_end_time=0;
   e.profile_available_time=0; e.vwap_available_time=0; e.volume_available_time=0;
   e.event_available_time=0; e.profile_start_bar=-1; e.profile_end_bar=-1;
   e.profile_poc=0.0; e.profile_vah=0.0; e.profile_val=0.0; e.profile_row_size=0.0;
   e.profile_hvn_count=0; e.profile_lvn_count=0;
   for(int i=0;i<SMF_PROFILE_NODE_MAX;i++)
   { e.profile_hvn[i]=0.0; e.profile_lvn[i]=0.0; }
   e.vwap_value=0.0; e.previous_vwap=0.0; e.volume_ratio=0.0; e.volume_average=0.0;
   e.profile_integrated_score=50.0; e.profile_score=50; e.vwap_score=50; e.flow_score=0;
   e.profile_valid=false; e.vwap_valid=false; e.volume_valid=false;
   e.profile_touch=false; e.profile_boundary_touch=false; e.profile_node_touch=false;
   e.profile_rejection=false; e.vwap_touch=false; e.vwap_event=false;
   e.vwap_reclaim=false; e.vwap_rejection=false; e.vwap_aligned=false;
   e.volume_expansion=false; e.flow_directional=false; e.absorption_proxy=false;
   e.displacement=false; e.causal_chain_ok=false; e.structure_ok=false; e.zone_ok=false;
   e.retest_ok=false; e.rr_ok=false; e.authority_ok=false; e.conflict=false; e.forming=false;
   e.integrate_profile=false; e.integrate_vwap=false; e.integrate_flow=false;
   e.shared_bar_cluster=false; e.true_bid_ask_available=false; e.profile_fingerprint=0;
   e.profile_tag=""; e.profile_source="UNAVAILABLE"; e.volume_source="UNAVAILABLE";
   e.vwap_source="UNAVAILABLE"; e.profile_response="UNAVAILABLE";
   e.vwap_response="UNAVAILABLE"; e.flow_response="UNAVAILABLE";
   e.conflict_reason=""; e.integration_note=""; e.status="NO DATA";
   e.missing_reason=""; e.event_provenance="";
   e.sweep_event_id=""; e.displacement_event_id=""; e.structure_event_id="";
   e.zone_event_id=""; e.provenance="";
}

void SMF_ResetState()
{
   SMF_ResetEvidence(g_smf);
   SMF_ResetEvidence(g_smf_snapshot);
   for(int i=0;i<SMF_REPLAY_RING_SIZE;i++)
   {
      g_smf_replay_ring[i].valid=false;
      g_smf_replay_ring[i].decision_bar=-1;
      g_smf_replay_ring[i].decision_time=0;
      g_smf_replay_ring[i].profile_start_bar=-1;
      g_smf_replay_ring[i].profile_end_bar=-1;
      g_smf_replay_ring[i].profile_start_time=0;
      g_smf_replay_ring[i].profile_end_time=0;
      g_smf_replay_ring[i].profile_available_time=0;
      g_smf_replay_ring[i].profile_poc=0.0;
      g_smf_replay_ring[i].profile_vah=0.0;
      g_smf_replay_ring[i].profile_val=0.0;
      g_smf_replay_ring[i].profile_row_size=0.0;
      g_smf_replay_ring[i].profile_fingerprint=0;
      g_smf_replay_ring[i].profile_tag="";
      g_smf_replay_ring[i].profile_source="";
   }
   g_smf_replay_head=0; g_smf_replay_count=0;
   g_smf_replay_checks=0; g_smf_replay_passes=0; g_smf_replay_failures=0;
   g_smf_profile_builds=0; g_smf_profile_cache_hits=0;
   g_smf_last_us=0; g_smf_avg_us=0;
   g_smf_profile_last_us=0; g_smf_profile_avg_us=0;
   g_smf_replay_status="NOT RUN";
   g_smf_current_audit_time=0; g_smf_current_audit_ok=true;
}

void SMF_RecordProfileTime(const long start_us)
{
   long elapsed=(long)GetMicrosecondCount()-start_us;
   if(elapsed<0) elapsed=0;
   g_smf_profile_last_us=elapsed;
   g_smf_profile_avg_us=(g_smf_profile_avg_us<=0 ? elapsed :
                          (g_smf_profile_avg_us*7+elapsed)/8);
}

ulong SMF_ProfileFingerprint(const SMVPProfile &p,const string tag,const string source)
{
   string row=StringFormat("SMFVP|%s|%s|%d|%d|%I64d|%I64d|%d|%.12f|%.12f|%.12f|%.12f|%.12f|%.12f|%d|%d|%d|%d|%.6f",
      tag,source,p.bar_start,p.bar_end,(long)p.t_start,(long)p.t_end,p.rows,
      p.poc,p.vah,p.val,p.price_lo,p.row_size,p.total,p.poc_row,p.va_lo,p.va_hi,
      (int)InpMVPDistribution,InpMVPValueAreaPct);
   ulong hash=SMF_HashString(row);
   string cfg="CFG|"+IntegerToString((int)g_mvp_cfg.mode)+
      "|"+IntegerToString((int)g_mvp_cfg.anchor)+"|"+(g_mvp_cfg.triangle?"TRI":"UNIFORM")+
      "|"+DoubleToString(g_mvp_cfg.va_pct,8)+"|"+DoubleToString(g_mvp_cfg.row_atr,8)+
      "|"+IntegerToString(g_mvp_cfg.row_ticks)+"|"+IntegerToString(g_mvp_cfg.min_bars)+
      "|"+IntegerToString(g_mvp_cfg.fixed_bars)+"|"+IntegerToString(g_mvp_cfg.day_lb)+
      "|"+IntegerToString(g_mvp_cfg.sess_lb)+"|"+IntegerToString(g_mvp_cfg.week_lb)+
      "|"+(g_mvp_cfg.show_hist?"HIST":"CURRENT")+
      "|"+DoubleToString(g_mvp_cfg.hvn_frac,8)+"|"+DoubleToString(g_mvp_cfg.lvn_frac,8);
   hash=SMF_HashString(cfg,hash);
   for(int i=0;i<p.rows && i<MVP_MAX_ROWS;i++)
   {
      string cell=StringFormat("|%d:%.10f:%.10f:%.10f",i,p.vol[i],p.buy[i],p.sell[i]);
      hash=SMF_HashString(cell,hash);
   }
   for(int i=0;i<p.hvn_n && i<MVP_MAX_NODES;i++)
      hash=SMF_HashString(StringFormat("|HVN%d:%.10f",i,p.hvn_px[i]),hash);
   for(int i=0;i<p.lvn_n && i<MVP_MAX_NODES;i++)
      hash=SMF_HashString(StringFormat("|LVN%d:%.10f",i,p.lvn_px[i]),hash);
   return hash;
}

// Re-derive one profile using bars no later than `asof`. For VISIBLE mode the
// evidence engine uses a deterministic rolling window, not the chart viewport.
bool SMF_BuildProfileAsOf(const int asof,SMVPProfile &p,string &tag,bool &use_real)
{
   ZeroMemory(p);
   tag=""; use_real=false;
   if(!InpUseMasterVolumeProfile || asof<1 || asof>=ArraySize(g_buf_t) ||
      asof>=ArraySize(g_buf_h) || asof>=ArraySize(g_buf_l) || asof+1>=ArraySize(g_buf_t))
      return false;

   long profile_start_us=(long)GetMicrosecondCount();
   g_smf_profile_builds++;
   MVP_LoadConfig();
   double tick=MVP_Tick();
   use_real=MVP_DecideReal(asof);
   bool saved_real=g_mvp_use_real;
   g_mvp_use_real=use_real;
   double base_row=MVP_BaseRow(asof,tick);
   int from=-1,to=-1;

   if(g_mvp_cfg.mode==MVP_MODE_VISIBLE)
   {
      int window=MathMax(10,g_mvp_cfg.fixed_bars);
      from=MathMax(0,asof-window+1); to=asof; tag="VISIBLE-ROLL";
   }
   else if(g_mvp_cfg.mode==MVP_MODE_FIXED)
   {
      from=MathMax(0,asof-g_mvp_cfg.fixed_bars+1); to=asof; tag="FIXED";
   }
   else if(g_mvp_cfg.mode==MVP_MODE_WEEKLY)
   {
      if(MVP_FindPeriod(asof,0,true,from,to)) tag="WEEK";
   }
   else if(g_mvp_cfg.mode==MVP_MODE_SESSION)
   {
      ENUM_SESSION_ID sessions[3]; sessions[0]=SESSION_ASIA;
      sessions[1]=SESSION_LONDON; sessions[2]=SESSION_NEWYORK;
      string names[3]; names[0]="ASIA"; names[1]="LONDON"; names[2]="NY";
      int colors[3]; colors[0]=1; colors[1]=2; colors[2]=3;
      int lookback=(g_mvp_cfg.show_hist?g_mvp_cfg.sess_lb:1);
      int best_to=-1,best_color=-1;
      for(int si=0;si<3;si++)
      {
         int froms[],tos[],n=0;
         MVP_CollectSessionRuns(asof,sessions[si],lookback,froms,tos,n);
         if(n<=0) continue;
         if(tos[0]>best_to || (tos[0]==best_to && colors[si]>best_color))
         {
            from=froms[0]; to=tos[0]; best_to=to; best_color=colors[si];
            tag=names[si];
         }
      }
   }
   else
   {
      if(MVP_FindPeriod(asof,0,false,from,to)) tag="MASTER";
   }

   bool ok=false;
   if(from>=0 && to>=from && to<=asof && to-from+1>=g_mvp_cfg.min_bars)
   {
      ok=MVP_BuildBars(p,from,to,base_row,tick);
      if(ok) p.developing=(to==asof);
   }
   g_mvp_use_real=saved_real;
   SMF_RecordProfileTime(profile_start_us);
   if(!ok) { ZeroMemory(p); tag=""; return false; }
   return (p.valid && p.bar_end<=asof && p.bar_end+1<ArraySize(g_buf_t));
}

void SMF_CopyProfile(SMVPProfile &dst,const SMVPProfile &src)
{
   ZeroMemory(dst);
   dst.valid=src.valid; dst.developing=src.developing; dst.dock_right=src.dock_right;
   dst.rows=src.rows; dst.poc_row=src.poc_row; dst.va_lo=src.va_lo; dst.va_hi=src.va_hi;
   dst.hvn_n=src.hvn_n; dst.lvn_n=src.lvn_n;
   dst.bar_start=src.bar_start; dst.bar_end=src.bar_end;
   dst.row_size=src.row_size; dst.price_lo=src.price_lo; dst.total=src.total;
   dst.buy_total=src.buy_total; dst.sell_total=src.sell_total;
   dst.poc=src.poc; dst.vah=src.vah; dst.val=src.val; dst.vwap=src.vwap; dst.peak=src.peak;
   dst.t_start=src.t_start; dst.t_end=src.t_end;
   for(int i=0;i<MVP_MAX_NODES;i++)
   { dst.hvn_px[i]=src.hvn_px[i]; dst.lvn_px[i]=src.lvn_px[i]; }
   for(int i=0;i<MVP_MAX_ROWS;i++)
   { dst.vol[i]=src.vol[i]; dst.buy[i]=src.buy[i]; dst.sell[i]=src.sell[i]; }
}

bool SMF_ProfileAtDecision(const int asof,SMVPProfile &p,string &tag,bool &use_real)
{
   ZeroMemory(p); tag=""; use_real=false;
   if(!InpUseMasterVolumeProfile) return false;
   if(asof==g_rates_total-2 && asof>=0 && asof<ArraySize(g_buf_t) &&
      g_mvp_built_time==g_buf_t[asof] && InpMVPMode!=MVP_MODE_VISIBLE &&
      g_mvp_active>=0 && g_mvp_active<g_mvp_count && g_mvp[g_mvp_active].valid &&
      g_mvp[g_mvp_active].bar_end<=asof)
   {
      SMF_CopyProfile(p,g_mvp[g_mvp_active]);
      tag=g_mvp_tag[g_mvp_active]; use_real=g_mvp_use_real;
      g_smf_profile_cache_hits++;
      return true;
   }
   bool ok=SMF_BuildProfileAsOf(asof,p,tag,use_real);
   return ok;
}

// Candidate-relative value-area context; a touch alone is explicitly weak.
int SMF_ProfileScore(const SMVPProfile &p,const int direction,const double high,
                     const double low,const double close_px,const double close_loc,
                     const double atr,bool &touch,bool &boundary_touch,
                     bool &node_touch,bool &rejection,string &response)
{
   touch=false; boundary_touch=false; node_touch=false; rejection=false;
   response="PROFILE NEUTRAL";
   if(!p.valid || p.rows<=0 || p.row_size<=0.0 || (direction!=1 && direction!=-1))
      return 50;
   double tol=MathMax(_Point*2.0,MathMax(p.row_size*1.25,atr*0.08));
   bool val_touch=(low<=p.val+tol && high>=p.val-tol);
   bool vah_touch=(low<=p.vah+tol && high>=p.vah-tol);
   bool poc_touch=(low<=p.poc+tol && high>=p.poc-tol);
   boundary_touch=(val_touch || vah_touch || poc_touch);
   bool hvn_touch=false,lvn_touch=false;
   double touched_hvn=0.0,touched_lvn=0.0;
   for(int i=0;i<p.hvn_n && i<SMF_PROFILE_NODE_MAX;i++)
      if(low<=p.hvn_px[i]+tol && high>=p.hvn_px[i]-tol)
      { if(!hvn_touch) touched_hvn=p.hvn_px[i]; hvn_touch=true; }
   for(int i=0;i<p.lvn_n && i<SMF_PROFILE_NODE_MAX;i++)
      if(low<=p.lvn_px[i]+tol && high>=p.lvn_px[i]-tol)
      { if(!lvn_touch) touched_lvn=p.lvn_px[i]; lvn_touch=true; }
   node_touch=(hvn_touch || lvn_touch);
   touch=(boundary_touch || node_touch);

   int score=50;
   if(direction>0)
   {
      bool swept=(low<p.val-MathMax(_Point,p.row_size*0.15));
      rejection=(val_touch && close_px>p.val && close_loc>=0.60) ||
                (swept && close_px>p.val && close_loc>=0.55);
      if(rejection)
      { score=95; response=(swept?"VAL SWEEP / RECLAIM":"VAL REJECTION"); }
      else if(val_touch)
      { score=42; response="VAL TOUCH / NO REJECTION"; }
      else if(close_px<p.val-tol)
      { score=20; response="BELOW VAL / BUY LOCATION OPPOSED"; }
      else if(close_px>p.vah+tol)
      { score=76; response="ACCEPTED ABOVE VAH"; }
      else if(close_px<=p.poc)
      { score=64; response="IN VALUE / DISCOUNT SIDE"; }
      else
      { score=52; response=(poc_touch?"POC ROTATION":"IN VALUE / ABOVE POC"); }
   }
   else
   {
      bool swept=(high>p.vah+MathMax(_Point,p.row_size*0.15));
      rejection=(vah_touch && close_px<p.vah && close_loc<=0.40) ||
                (swept && close_px<p.vah && close_loc<=0.45);
      if(rejection)
      { score=95; response=(swept?"VAH SWEEP / REJECTION":"VAH REJECTION"); }
      else if(vah_touch)
      { score=42; response="VAH TOUCH / NO REJECTION"; }
      else if(close_px>p.vah+tol)
      { score=20; response="ABOVE VAH / SELL LOCATION OPPOSED"; }
      else if(close_px<p.val-tol)
      { score=76; response="ACCEPTED BELOW VAL"; }
      else if(close_px>=p.poc)
      { score=64; response="IN VALUE / PREMIUM SIDE"; }
      else
      { score=52; response=(poc_touch?"POC ROTATION":"IN VALUE / BELOW POC"); }
   }
   // HVN/LVN identify location only: neither node touch nor node type gives
   // directional credit without a separately-confirmed VAH/VAL response.
   if(hvn_touch)
      response+=StringFormat("; HVN %.5f LOCATION (NON-DIRECTIONAL)",touched_hvn);
   if(lvn_touch)
      response+=StringFormat("; LVN %.5f LOCATION (NON-DIRECTIONAL)",touched_lvn);
   return score;
}

int SMF_FlowProxyScore(const bool volume_expansion,const double volume_ratio,
                       const double directional_close_location,const bool candle_confirms)
{
   if(!volume_expansion || !candle_confirms || volume_ratio<1.30) return 0;
   double v=SMF_Clamp((volume_ratio-1.30)/(2.50-1.30)*100.0,0.0,100.0);
   double d=SMF_Clamp((directional_close_location-0.50)/0.40*100.0,0.0,100.0);
   if(d<=0.0 || v<=0.0) return 0;
   return (int)MathRound(MathSqrt(v*d));
}

bool SMF_IsAbsorptionProxy(const bool volume_expansion,const double volume_ratio,
                           const double body_ratio,const double wick_body_ratio)
{
   return (volume_expansion && volume_ratio>=1.50 && body_ratio<=0.40 && wick_body_ratio>=0.80);
}

int SMF_FindReplayRecord(const datetime decision_time)
{
   if(decision_time<=0) return -1;
   for(int k=0;k<g_smf_replay_count;k++)
   {
      int idx=(g_smf_replay_head-1-k+SMF_REPLAY_RING_SIZE)%SMF_REPLAY_RING_SIZE;
      if(g_smf_replay_ring[idx].valid && g_smf_replay_ring[idx].decision_time==decision_time)
         return idx;
   }
   return -1;
}

void SMF_StoreReplayRecord(const int closed,const SSmartMoneyEvidence &e)
{
   if(!e.profile_valid || closed<0 || closed+1>=ArraySize(g_buf_t)) return;
   int idx=SMF_FindReplayRecord(e.decision_time);
   bool fresh=(idx<0);
   if(fresh) idx=g_smf_replay_head;
   g_smf_replay_ring[idx].valid=true;
   g_smf_replay_ring[idx].decision_bar=closed;
   g_smf_replay_ring[idx].decision_time=e.decision_time;
   g_smf_replay_ring[idx].profile_start_bar=e.profile_start_bar;
   g_smf_replay_ring[idx].profile_end_bar=e.profile_end_bar;
   g_smf_replay_ring[idx].profile_start_time=e.profile_start_time;
   g_smf_replay_ring[idx].profile_end_time=e.profile_end_time;
   g_smf_replay_ring[idx].profile_available_time=e.profile_available_time;
   g_smf_replay_ring[idx].profile_poc=e.profile_poc;
   g_smf_replay_ring[idx].profile_vah=e.profile_vah;
   g_smf_replay_ring[idx].profile_val=e.profile_val;
   g_smf_replay_ring[idx].profile_row_size=e.profile_row_size;
   g_smf_replay_ring[idx].profile_fingerprint=e.profile_fingerprint;
   g_smf_replay_ring[idx].profile_tag=e.profile_tag;
   g_smf_replay_ring[idx].profile_source=e.profile_source;
   if(fresh)
   {
      g_smf_replay_head=(g_smf_replay_head+1)%SMF_REPLAY_RING_SIZE;
      g_smf_replay_count=MathMin(SMF_REPLAY_RING_SIZE,g_smf_replay_count+1);
   }
}

bool SMF_AuditReplayRecord(const SSMFReplayRecord &rec)
{
   g_smf_replay_checks++;
   int asof=rec.decision_bar;
   int total=ArraySize(g_buf_t);
   if(asof<0 || asof+1>=total || g_buf_t[asof+1]!=rec.decision_time)
   {
      int decision_open=ChartClosedBarAtTime(g_buf_t,total,rec.decision_time);
      asof=decision_open-1;
   }
   if(asof<1 || asof+1>=total || g_buf_t[asof+1]!=rec.decision_time ||
      !SMF_ProfileAsOfValid(rec.profile_end_bar,rec.decision_bar,
                            rec.profile_available_time,rec.decision_time))
   {
      // If history indices shifted, validate the reconstructed index against
      // the immutable timestamps rather than assuming an old array offset.
      if(asof<1 || asof+1>=total || g_buf_t[asof+1]!=rec.decision_time ||
         rec.profile_end_time>g_buf_t[asof] || rec.profile_available_time>rec.decision_time)
      { g_smf_replay_failures++; return false; }
   }
   if(rec.profile_available_time>rec.decision_time || rec.profile_end_time>g_buf_t[asof])
   { g_smf_replay_failures++; return false; }

   SMVPProfile replay; string tag=""; bool real=false;
   bool ok=SMF_BuildProfileAsOf(asof,replay,tag,real);
   string source=SMF_MVPSourceLabel(real);
   if(!ok || replay.bar_end>asof || replay.bar_end+1>=ArraySize(g_buf_t))
   { g_smf_replay_failures++; return false; }
   datetime avail=g_buf_t[replay.bar_end+1];
   ulong fingerprint=SMF_ProfileFingerprint(replay,tag,source);
   bool same=(SMF_ProfileAsOfValid(replay.bar_end,asof,avail,rec.decision_time) &&
              tag==rec.profile_tag && source==rec.profile_source &&
              replay.bar_start==rec.profile_start_bar && replay.bar_end==rec.profile_end_bar &&
              replay.t_start==rec.profile_start_time && replay.t_end==rec.profile_end_time &&
              MathAbs(replay.poc-rec.profile_poc)<=_Point*0.1 &&
              MathAbs(replay.vah-rec.profile_vah)<=_Point*0.1 &&
              MathAbs(replay.val-rec.profile_val)<=_Point*0.1 &&
              MathAbs(replay.row_size-rec.profile_row_size)<=_Point*0.1 &&
              fingerprint==rec.profile_fingerprint);
   if(same) g_smf_replay_passes++;
   else     g_smf_replay_failures++;
   return same;
}

bool SMF_ReplayCheckCurrent(const int closed)
{
   if(!g_smf_snapshot.profile_valid) return true;
   if(g_smf_current_audit_time==g_smf_snapshot.decision_time)
      return g_smf_current_audit_ok;
   g_smf_current_audit_time=g_smf_snapshot.decision_time;
   g_smf_current_audit_ok=false;
   int idx=SMF_FindReplayRecord(g_smf_snapshot.decision_time);
   if(idx<0)
   {
      g_smf_replay_status="CURRENT BASELINE MISSING";
      g_smf_replay_failures++;
      return false;
   }
   SSMFReplayRecord rec=g_smf_replay_ring[idx];
   g_smf_replay_checks++;
   bool ok=(rec.decision_time==g_smf_snapshot.decision_time &&
      (rec.decision_bar==closed || rec.decision_time==g_smf_snapshot.decision_time) &&
      SMF_ProfileAsOfValid(g_smf_snapshot.profile_end_bar,closed,
         g_smf_snapshot.profile_available_time,g_smf_snapshot.decision_time) &&
      g_smf_snapshot.profile_end_time<=g_buf_t[closed] &&
      rec.profile_start_time==g_smf_snapshot.profile_start_time &&
      rec.profile_end_time==g_smf_snapshot.profile_end_time &&
      rec.profile_available_time==g_smf_snapshot.profile_available_time &&
      rec.profile_fingerprint==g_smf_snapshot.profile_fingerprint &&
      rec.profile_tag==g_smf_snapshot.profile_tag &&
      rec.profile_source==g_smf_snapshot.profile_source &&
      MathAbs(rec.profile_poc-g_smf_snapshot.profile_poc)<=_Point*0.1 &&
      MathAbs(rec.profile_vah-g_smf_snapshot.profile_vah)<=_Point*0.1 &&
      MathAbs(rec.profile_val-g_smf_snapshot.profile_val)<=_Point*0.1);
   if(ok) g_smf_replay_passes++;
   else g_smf_replay_failures++;
   g_smf_current_audit_ok=ok;
   g_smf_replay_status=(ok?"CURRENT SNAPSHOT PASS":"CURRENT SNAPSHOT FAIL");
   return ok;
}

void SMF_ReplayAuditRecent(const int closed)
{
   if(InpSMFReplayAuditEveryBars<=0 || closed<0 ||
      (closed%InpSMFReplayAuditEveryBars)!=0) return;
   int want=(int)MathMax(1,MathMin(8,InpSMFReplayAuditSamples));
   int stride=(int)MathMax(1,InpSMFReplayAuditEveryBars/MathMax(1,want));
   int checked=0,passed=0;
   bool deterministic_checked=false;
   for(int sample=0;sample<want;sample++)
   {
      int b=closed-sample*stride;
      if(b<1 || b+1>=ArraySize(g_buf_t)) continue;
      datetime decision=g_buf_t[b+1];
      int idx=SMF_FindReplayRecord(decision);
      if(idx>=0)
      {
         SSMFReplayRecord rec=g_smf_replay_ring[idx];
         checked++;
         if(SMF_AuditReplayRecord(rec)) passed++;
         continue;
      }
      // Initial attachment has no old ring records. Reconstruct selected
      // historical bars strictly as-of each decision boundary instead of
      // silently reporting "no replay" for all loaded history.
      SMVPProfile replay; string tag=""; bool real=false;
      bool ok=SMF_BuildProfileAsOf(b,replay,tag,real);
      if(!ok || replay.bar_end+1>=ArraySize(g_buf_t)) continue; // configured profile unavailable
      checked++; g_smf_replay_checks++;
      datetime available=g_buf_t[replay.bar_end+1];
      string source=SMF_MVPSourceLabel(real);
      bool causal=(SMF_ProfileAsOfValid(replay.bar_end,b,available,decision) &&
                   replay.t_end<=g_buf_t[b]);
      bool deterministic=true;
      if(!deterministic_checked && causal)
      {
         deterministic_checked=true;
         SMVPProfile again; string again_tag=""; bool again_real=false;
         deterministic=(SMF_BuildProfileAsOf(b,again,again_tag,again_real) &&
            again_tag==tag && SMF_MVPSourceLabel(again_real)==source &&
            SMF_ProfileFingerprint(again,again_tag,SMF_MVPSourceLabel(again_real))==
            SMF_ProfileFingerprint(replay,tag,source));
      }
      if(causal && deterministic) {passed++; g_smf_replay_passes++;}
      else g_smf_replay_failures++;
   }
   if(checked<=0) g_smf_replay_status="NO AS-OF PROFILE SNAPSHOTS AVAILABLE";
   else if(passed==checked)
      g_smf_replay_status=StringFormat("PASS %d/%d AS-OF REPLAY",passed,checked);
   else
      g_smf_replay_status=StringFormat("FAIL %d/%d AS-OF REPLAY",passed,checked);
}

void SMF_UpdateSnapshot(const int rates_total,const bool force)
{
   if(!InpUseSmartMoneyVolumeEvidence)
   {
      SMF_ResetEvidence(g_smf); SMF_ResetEvidence(g_smf_snapshot);
      g_smf.status="DISABLED"; g_smf_snapshot.status="DISABLED";
      return;
   }
   int closed=rates_total-2;
   if(closed<3 || closed+1>=ArraySize(g_buf_t)) return;
   if(!force && g_smf_snapshot.closed_bar==closed &&
      g_smf_snapshot.decision_time==g_buf_t[closed+1]) return;
   g_smf_current_audit_time=0; g_smf_current_audit_ok=true;
   long start_us=(long)GetMicrosecondCount();
   SMF_ResetEvidence(g_smf_snapshot);
   SSmartMoneyEvidence e; SMF_ResetEvidence(e);
   e.enabled=true; e.closed_bar=closed; e.decision_time=g_buf_t[closed+1];
   double atr=(closed<ArraySize(g_atr_buf) && g_atr_buf[closed]>0.0 ? g_atr_buf[closed] : g_atr);
   SCandleIntelligence ci=AnalyzeCandleIntelligence(closed,g_buf_o,g_buf_h,g_buf_l,g_buf_c,
                                                      g_buf_tv,g_buf_rv,atr);
   if(InpUseCandleIntelligence) g_candle_intel=ci;
   e.candle_close_location=ci.close_location;
   e.candle_body_ratio=ci.body_range_ratio;
   e.candle_wick_ratio=ci.wick_rejection;
   e.candle_confirms_buy=ci.confirms_buy; e.candle_confirms_sell=ci.confirms_sell;
   e.candle_is_displacement=ci.is_displacement;
   e.candle_effort_result_proxy=ci.absorption_behavior;
   e.volume_ratio=ci.volume_ratio; e.volume_average=ci.volume_average;
   e.volume_source=(ci.volume_source==""?"UNAVAILABLE":ci.volume_source);
   e.volume_expansion=ci.volume_expansion;
   e.volume_valid=(ci.valid && ci.volume_average>0.0 && ci.volume_ratio>=0.0);
   if(e.volume_valid) e.volume_available_time=e.decision_time;

   if(closed<ArraySize(BufVWAP) && BufVWAP[closed]!=EMPTY_VALUE &&
      MathIsValidNumber(BufVWAP[closed]) && BufVWAP[closed]>0.0)
   {
      e.vwap_value=BufVWAP[closed];
      e.vwap_valid=true; e.vwap_available_time=e.decision_time;
      e.vwap_source=(g_vwap_source_label==""?"EXISTING ANCHORED VWAP":g_vwap_source_label);
      if(closed>0 && closed-1<ArraySize(BufVWAP) && BufVWAP[closed-1]!=EMPTY_VALUE &&
         MathIsValidNumber(BufVWAP[closed-1]) && BufVWAP[closed-1]>0.0)
         e.previous_vwap=BufVWAP[closed-1];
   }

   SMVPProfile profile; string profile_tag=""; bool profile_real=false;
   if(SMF_ProfileAtDecision(closed,profile,profile_tag,profile_real) &&
      profile.bar_end<=closed && profile.bar_end+1<ArraySize(g_buf_t))
   {
      e.profile_valid=true; e.profile_start_bar=profile.bar_start; e.profile_end_bar=profile.bar_end;
      e.profile_start_time=profile.t_start; e.profile_end_time=profile.t_end;
      e.profile_available_time=g_buf_t[profile.bar_end+1];
      e.profile_poc=profile.poc; e.profile_vah=profile.vah; e.profile_val=profile.val;
      e.profile_row_size=profile.row_size; e.profile_tag=profile_tag;
      e.profile_hvn_count=(int)MathMax(0,MathMin(SMF_PROFILE_NODE_MAX,profile.hvn_n));
      e.profile_lvn_count=(int)MathMax(0,MathMin(SMF_PROFILE_NODE_MAX,profile.lvn_n));
      for(int i=0;i<SMF_PROFILE_NODE_MAX;i++)
      {
         if(i<e.profile_hvn_count) e.profile_hvn[i]=profile.hvn_px[i];
         if(i<e.profile_lvn_count) e.profile_lvn[i]=profile.lvn_px[i];
      }
      e.profile_source=SMF_MVPSourceLabel(profile_real);
      e.profile_fingerprint=SMF_ProfileFingerprint(profile,profile_tag,e.profile_source);
   }

   e.valid=(e.profile_valid || e.vwap_valid || e.volume_valid);
   e.causal_ok=true;
   if(e.profile_valid)
   {
      if(!SMF_ProfileAsOfValid(e.profile_end_bar,closed,e.profile_available_time,e.decision_time) ||
         e.profile_end_time>g_buf_t[closed]) e.causal_ok=false;
   }
   if(e.vwap_valid && !SMF_CausalTimeValid(e.vwap_available_time,e.decision_time)) e.causal_ok=false;
   if(e.volume_valid && !SMF_CausalTimeValid(e.volume_available_time,e.decision_time)) e.causal_ok=false;
   e.status=(e.valid?"WATCH - NO CAUSAL SETUP":"NO DATA");
   e.provenance=SMF_OrderFlowDisclosure();
   if(e.profile_valid)
      SMF_AddNote(e.provenance,StringFormat("MVP %s %s POC %.5f VAH %.5f VAL %.5f; end %s avail %s",
         e.profile_tag,e.profile_source,e.profile_poc,e.profile_vah,e.profile_val,
         TimeToString(e.profile_end_time,TIME_DATE|TIME_MINUTES),
         TimeToString(e.profile_available_time,TIME_DATE|TIME_MINUTES)));
   if(e.vwap_valid)
      SMF_AddNote(e.provenance,StringFormat("VWAP %s %.5f avail %s",
         e.vwap_source,e.vwap_value,TimeToString(e.vwap_available_time,TIME_DATE|TIME_MINUTES)));
   if(e.volume_valid)
      SMF_AddNote(e.provenance,StringFormat("VOLUME PROXY %s ratio %.2fx baseline %.1f avail %s",
         e.volume_source,e.volume_ratio,e.volume_average,
         TimeToString(e.volume_available_time,TIME_DATE|TIME_MINUTES)));

   g_smf_snapshot=e;
   g_smf=e;
   if(e.profile_valid) SMF_StoreReplayRecord(closed,e);
   SMF_ReplayAuditRecent(closed);
   long elapsed=(long)GetMicrosecondCount()-start_us;
   g_smf_last_us=elapsed;
   g_smf_avg_us=(g_smf_avg_us<=0?elapsed:(g_smf_avg_us*7+elapsed)/8);
}

bool SMF_VWAPScore(const int closed,const int direction,const double atr,
                   int &score,bool &touch,bool &reclaim,bool &rejection,
                   bool &aligned,string &response)
{
   score=50; touch=false; reclaim=false; rejection=false; aligned=false; response="VWAP UNAVAILABLE";
   if(closed<2 || direction==0 || !g_smf_snapshot.vwap_valid ||
      closed>=ArraySize(BufVWAP) || closed>=ArraySize(g_buf_c)) return false;
   double v=BufVWAP[closed];
   double pv=BufVWAP[closed-1];
   if(v==EMPTY_VALUE || pv==EMPTY_VALUE || v<=0.0 || pv<=0.0) return false;
   double close_px=g_buf_c[closed],prev_close=g_buf_c[closed-1];
   double tol=MathMax(_Point*2.0,atr*0.08);
   touch=(g_buf_l[closed]<=v+tol && g_buf_h[closed]>=v-tol);
   if(direction>0)
   {
      aligned=(close_px>v);
      reclaim=(prev_close<=pv && close_px>v);
      rejection=(touch && close_px>v && g_smf_snapshot.candle_close_location>=0.60);
   }
   else
   {
      aligned=(close_px<v);
      reclaim=(prev_close>=pv && close_px<v);
      rejection=(touch && close_px<v && g_smf_snapshot.candle_close_location<=0.40);
   }
   bool accepted=true; int accept_n=0;
   for(int b=closed-2;b<=closed;b++)
   {
      if(b<0 || b>=ArraySize(BufVWAP) || b>=ArraySize(g_buf_c) || BufVWAP[b]==EMPTY_VALUE)
      { accepted=false; break; }
      bool side=(direction>0 ? g_buf_c[b]>BufVWAP[b] : g_buf_c[b]<BufVWAP[b]);
      if(side) accept_n++;
   }
   accepted=(accepted && accept_n==3);
   if(reclaim) {score=95; response=(direction>0?"VWAP RECLAIM":"VWAP REJECTION / RECLAIM DOWN");}
   else if(rejection) {score=88; response=(direction>0?"VWAP SUPPORT REJECTION":"VWAP RESISTANCE REJECTION");}
   else if(accepted) {score=74; response=(direction>0?"ACCEPTED ABOVE VWAP":"ACCEPTED BELOW VWAP");}
   else if(aligned) {score=62; response=(direction>0?"ABOVE VWAP":"BELOW VWAP");}
   else {score=25; response=(direction>0?"CLOSE BELOW VWAP":"CLOSE ABOVE VWAP");}
   return true;
}

string SMF_ClassifyStatus(const bool data_valid,const bool at_location,const bool rejection,
                          const bool flow_confirmed,const bool vwap_aligned,
                          const bool displacement,const bool structure_ok,const bool zone_ok,
                          const bool retest_ok,const bool rr_ok,const bool authority_ok,
                          const bool conflict,const bool forming,const bool causal_ok)
{
   if(!causal_ok) return "CAUSALITY FAIL";
   if(forming) return "WATCH / WAIT CLOSED BAR";
   if(conflict) return "CONFLICT / WATCH";
   if(authority_ok && structure_ok && zone_ok && retest_ok && rr_ok)
      return "EXECUTION READY (CORE AUTHORITY)";
   if(structure_ok && zone_ok) return "WAIT RETEST / CORE GATES";
   if(rejection && at_location && flow_confirmed && vwap_aligned && displacement)
      return "STRONG REACTION";
   if(rejection && at_location) return "REACTION";
   if(!data_valid) return "NO DATA / WATCH";
   if(at_location || flow_confirmed || vwap_aligned) return "WATCH";
   return "NO TRADE";
}

bool SMF_AddEventProvenance(const int event_index,const string label,
                            const datetime decision_time,string &summary,
                            datetime &max_availability)
{
   if(event_index<0) return true;
   if(event_index>=ArraySize(g_causal_events)) return false;
   SCausalEvent ev=g_causal_events[event_index];
   if(!SMF_CausalTimeValid(ev.availability_time,decision_time)) return false;
   if(ev.availability_time>max_availability) max_availability=ev.availability_time;
   SMF_AddNote(summary,StringFormat("%s=%s event %s avail %s",label,ev.id,
      TimeToString(ev.event_time,TIME_DATE|TIME_MINUTES),
      TimeToString(ev.availability_time,TIME_DATE|TIME_MINUTES)));
   return true;
}

void SMF_EvaluateCandidate(const int closed,const bool is_buy,
                           const double zone_top,const double zone_bottom,
                           const int sweep_event,const int displacement_event,
                           const int structure_event,const int zone_event,
                           const bool causal_chain_ok,const bool structure_ok,
                           const bool zone_ok,const bool retest_ok,const bool rr_ok,
                           const bool authority_ok,const bool forming)
{
   if(!InpUseSmartMoneyVolumeEvidence)
   {
      SMF_ResetEvidence(g_smf); g_smf.status="DISABLED"; return;
   }
   g_smf=g_smf_snapshot;
   g_smf.enabled=true;
   g_smf.direction=(is_buy?1:-1);
   g_smf.causal_chain_ok=causal_chain_ok; g_smf.structure_ok=structure_ok;
   g_smf.zone_ok=zone_ok; g_smf.retest_ok=retest_ok; g_smf.rr_ok=rr_ok;
   g_smf.authority_ok=authority_ok; g_smf.forming=forming;
   g_smf.true_bid_ask_available=false;
   g_smf.event_provenance="";
   g_smf.sweep_event_id=""; g_smf.displacement_event_id="";
   g_smf.structure_event_id=""; g_smf.zone_event_id="";
   g_smf.event_available_time=0;
   if(closed<0 || closed+1>=ArraySize(g_buf_t) ||
      g_smf_snapshot.closed_bar!=closed || g_smf_snapshot.decision_time!=g_buf_t[closed+1])
      g_smf.causal_ok=false;
   if(g_smf.profile_valid)
   {
      g_smf.profile_integrated_score=50.0;
      SMVPProfile p; ZeroMemory(p); p.valid=true; p.rows=1;
      p.poc=g_smf.profile_poc; p.vah=g_smf.profile_vah;
      p.val=g_smf.profile_val; p.row_size=g_smf.profile_row_size;
      p.hvn_n=g_smf.profile_hvn_count; p.lvn_n=g_smf.profile_lvn_count;
      for(int i=0;i<SMF_PROFILE_NODE_MAX;i++)
      { p.hvn_px[i]=g_smf.profile_hvn[i]; p.lvn_px[i]=g_smf.profile_lvn[i]; }
      if(!SMF_ProfileAsOfValid(g_smf.profile_end_bar,closed,
                               g_smf.profile_available_time,g_smf.decision_time) ||
         g_smf.profile_end_time>g_buf_t[closed])
         g_smf.causal_ok=false;
      else
      {
         double atr=(closed<ArraySize(g_atr_buf)?g_atr_buf[closed]:g_atr);
         g_smf.profile_score=SMF_ProfileScore(p,g_smf.direction,g_buf_h[closed],g_buf_l[closed],
              g_buf_c[closed],g_smf_snapshot.candle_close_location,atr,
              g_smf.profile_touch,g_smf.profile_boundary_touch,g_smf.profile_node_touch,
              g_smf.profile_rejection,g_smf.profile_response);
         if(zone_top>zone_bottom && zone_bottom<=p.vah && zone_top>=p.val)
            g_smf.profile_response+="; CAUSAL ZONE OVERLAPS VALUE";
      }
   }
   else
   {
      g_smf.profile_score=50; g_smf.profile_response="PROFILE UNAVAILABLE";
   }

   if(g_smf.vwap_valid)
   {
      double atr=(closed<ArraySize(g_atr_buf)?g_atr_buf[closed]:g_atr);
      int vs=50; bool vt=false,vr=false,vrej=false,va=false; string vdesc="";
      if(SMF_VWAPScore(closed,g_smf.direction,atr,vs,vt,vr,vrej,va,vdesc))
      {
         g_smf.vwap_score=vs; g_smf.vwap_touch=vt; g_smf.vwap_reclaim=vr;
         g_smf.vwap_rejection=vrej; g_smf.vwap_aligned=va;
         g_smf.vwap_event=(vt || vr || vrej); g_smf.vwap_response=vdesc;
      }
      else
      {
         g_smf.vwap_valid=false; g_smf.vwap_score=50; g_smf.vwap_response="VWAP HISTORY UNAVAILABLE";
      }
   }

   g_smf.volume_expansion=g_smf_snapshot.volume_expansion;
   g_smf.volume_ratio=g_smf_snapshot.volume_ratio;
   g_smf.volume_average=g_smf_snapshot.volume_average;
   bool candle_confirms=(is_buy?g_smf_snapshot.candle_confirms_buy:g_smf_snapshot.candle_confirms_sell);
   double directional_close=(is_buy ? g_smf_snapshot.candle_close_location :
                             1.0-g_smf_snapshot.candle_close_location);
   g_smf.flow_score=SMF_FlowProxyScore(g_smf.volume_expansion,g_smf.volume_ratio,
                                       directional_close,candle_confirms);
   g_smf.flow_directional=(g_smf.flow_score>0);
   g_smf.displacement=g_smf_snapshot.candle_is_displacement;
   g_smf.absorption_proxy=SMF_IsAbsorptionProxy(g_smf.volume_expansion,g_smf.volume_ratio,
      g_smf_snapshot.candle_body_ratio,g_smf_snapshot.candle_wick_ratio);
   if(g_smf.flow_directional)
      g_smf.flow_response=StringFormat("DIRECTIONAL VOLUME PROXY %.2fx (score %d/100)",
                                       g_smf.volume_ratio,g_smf.flow_score);
   else if(g_smf.absorption_proxy)
      g_smf.flow_response=StringFormat("EFFORT/RESULT PROXY %.2fx; NOT TRUE ABSORPTION",
                                       g_smf.volume_ratio);
   else if(g_smf.volume_expansion)
      g_smf.flow_response=StringFormat("VOLUME EXPANSION %.2fx; NO DIRECTIONAL CLOSE CONFIRMATION",
                                       g_smf.volume_ratio);
   else
      g_smf.flow_response=StringFormat("NORMAL TOTAL VOLUME %.2fx; PROXY ONLY",g_smf.volume_ratio);

   bool pstrong=(g_smf.profile_valid && g_smf.profile_score>=70);
   bool popposed=(g_smf.profile_valid && g_smf.profile_score<=30);
   bool vstrong=(g_smf.vwap_valid && g_smf.vwap_score>=70);
   bool vopposed=(g_smf.vwap_valid && g_smf.vwap_score<=30);
   if((pstrong && vopposed) || (vstrong && popposed))
   {
      g_smf.conflict=true;
      g_smf.conflict_reason="PROFILE / VWAP CONTEXT OPPOSES";
   }
   if(g_htf_bias!=0 && g_htf_bias!=g_smf.direction &&
      ((g_smf.vwap_valid && g_smf.vwap_score>=70) ||
       (g_smf.profile_valid && g_smf.profile_score>=70)))
   {
      g_smf.conflict=true;
      SMF_AddNote(g_smf.conflict_reason,"HTF BIAS OPPOSES SUPPORTIVE PROFILE/VWAP");
   }

   // Event clustering: when profile, VWAP, and/or the volume proxy react on
   // the same closed candle, only one existing score bucket receives that
   // cluster. The detailed evidence remains visible and auditable.
   g_smf.integrate_profile=(g_smf.profile_valid && !g_smf.conflict);
   g_smf.integrate_vwap=(g_smf.vwap_valid && !g_smf.conflict);
   g_smf.integrate_flow=(g_smf.flow_score>0);
   g_smf.profile_integrated_score=(double)g_smf.profile_score;
   if(g_smf.profile_boundary_touch && (g_smf.flow_score>0 || g_smf.vwap_event))
   {
      g_smf.shared_bar_cluster=true;
      if(g_smf.flow_score>0)
      {
         g_smf.integrate_flow=false;
         if(g_smf.profile_rejection)
            g_smf.profile_integrated_score=0.70*g_smf.profile_score+0.30*g_smf.flow_score;
         SMF_AddNote(g_smf.integration_note,"value-area/volume overlap: LIQUIDITY once; flow only blended on rejection");
      }
      if(g_smf.vwap_event)
      {
         g_smf.integrate_vwap=false;
         SMF_AddNote(g_smf.integration_note,"same-bar VWAP touch/reclaim subscore suppressed");
      }
   }
   else if(g_smf.vwap_event && g_smf.flow_score>0)
   {
      g_smf.shared_bar_cluster=true;
      g_smf.integrate_flow=false;
      SMF_AddNote(g_smf.integration_note,"VWAP/volume overlap: flow subscore suppressed to avoid duplicate context credit");
   }
   if(g_smf.conflict)
   {
      g_smf.integrate_profile=false; g_smf.integrate_vwap=false;
      SMF_AddNote(g_smf.integration_note,"conflicting location/context votes are disclosed, not averaged");
   }

   datetime max_avail=0;
   bool audit_ok=g_smf.causal_ok;
   if(g_smf.profile_valid)
   {
      audit_ok=(audit_ok && SMF_CausalTimeValid(g_smf.profile_available_time,g_smf.decision_time) &&
                g_smf.profile_end_bar<=closed && g_smf.profile_end_time<=g_buf_t[closed]);
      max_avail=(datetime)MathMax((long)max_avail,(long)g_smf.profile_available_time);
   }
   if(g_smf.vwap_valid)
   {
      audit_ok=(audit_ok && SMF_CausalTimeValid(g_smf.vwap_available_time,g_smf.decision_time));
      max_avail=(datetime)MathMax((long)max_avail,(long)g_smf.vwap_available_time);
   }
   if(g_smf.volume_valid)
   {
      audit_ok=(audit_ok && SMF_CausalTimeValid(g_smf.volume_available_time,g_smf.decision_time));
      max_avail=(datetime)MathMax((long)max_avail,(long)g_smf.volume_available_time);
   }
   g_smf.event_available_time=0;
   bool ev_ok=SMF_AddEventProvenance(sweep_event,"SWEEP",g_smf.decision_time,
                                     g_smf.event_provenance,g_smf.event_available_time);
   if(sweep_event>=0 && sweep_event<ArraySize(g_causal_events))
      g_smf.sweep_event_id=g_causal_events[sweep_event].id;
   ev_ok=(ev_ok && SMF_AddEventProvenance(displacement_event,"DISP",g_smf.decision_time,
                                     g_smf.event_provenance,g_smf.event_available_time));
   if(displacement_event>=0 && displacement_event<ArraySize(g_causal_events))
      g_smf.displacement_event_id=g_causal_events[displacement_event].id;
   ev_ok=(ev_ok && SMF_AddEventProvenance(structure_event,"STRUCT",g_smf.decision_time,
                                     g_smf.event_provenance,g_smf.event_available_time));
   if(structure_event>=0 && structure_event<ArraySize(g_causal_events))
      g_smf.structure_event_id=g_causal_events[structure_event].id;
   ev_ok=(ev_ok && SMF_AddEventProvenance(zone_event,"ZONE",g_smf.decision_time,
                                     g_smf.event_provenance,g_smf.event_available_time));
   if(zone_event>=0 && zone_event<ArraySize(g_causal_events))
      g_smf.zone_event_id=g_causal_events[zone_event].id;
   if(g_smf.event_available_time>0)
   {
      audit_ok=(audit_ok && SMF_CausalTimeValid(g_smf.event_available_time,g_smf.decision_time));
      max_avail=(datetime)MathMax((long)max_avail,(long)g_smf.event_available_time);
   }
   audit_ok=(audit_ok && ev_ok);
   g_smf.causal_ok=audit_ok;
   if(g_smf.profile_valid && !SMF_ReplayCheckCurrent(closed)) g_smf.causal_ok=false;

   g_smf.valid=(g_smf.profile_valid || g_smf.vwap_valid || g_smf.volume_valid);
   g_smf.status=SMF_ClassifyStatus(g_smf.valid,g_smf.profile_touch,g_smf.profile_rejection,
      g_smf.flow_directional,(g_smf.vwap_valid && g_smf.vwap_score>=60),g_smf.displacement,
      structure_ok,zone_ok,retest_ok,rr_ok,authority_ok,g_smf.conflict,forming,g_smf.causal_ok);
   g_smf.missing_reason="";
   if(!g_smf.profile_valid) SMF_AddNote(g_smf.missing_reason,"profile unavailable");
   else if(g_smf.profile_touch && !g_smf.profile_rejection)
      SMF_AddNote(g_smf.missing_reason,"profile touch has no closed-bar rejection");
   if(!g_smf.vwap_valid) SMF_AddNote(g_smf.missing_reason,"VWAP unavailable");
   if(!g_smf.volume_valid) SMF_AddNote(g_smf.missing_reason,"volume baseline unavailable");
   else if(g_smf.volume_expansion && !g_smf.flow_directional)
      SMF_AddNote(g_smf.missing_reason,"volume spike lacks directional close confirmation");
   if(!structure_ok) SMF_AddNote(g_smf.missing_reason,"causal structure/MSS missing");
   if(!zone_ok) SMF_AddNote(g_smf.missing_reason,"causal OB/FVG zone missing");
   if(structure_ok && zone_ok && !retest_ok) SMF_AddNote(g_smf.missing_reason,"waiting for later closed-bar retest");
   if(!rr_ok && structure_ok && zone_ok) SMF_AddNote(g_smf.missing_reason,"RR geometry not yet passed");
   if(g_smf.conflict) SMF_AddNote(g_smf.missing_reason,g_smf.conflict_reason);
   if(forming) SMF_AddNote(g_smf.missing_reason,"forming candle is not entry evidence");
   if(!g_smf.causal_ok) SMF_AddNote(g_smf.missing_reason,"availability/replay audit failed");

   g_smf.provenance=SMF_OrderFlowDisclosure();
   if(g_smf.profile_valid)
      SMF_AddNote(g_smf.provenance,StringFormat("MVP %s %s POC %.5f VAH %.5f VAL %.5f profile-end %s available %s",
         g_smf.profile_tag,g_smf.profile_source,g_smf.profile_poc,g_smf.profile_vah,g_smf.profile_val,
         TimeToString(g_smf.profile_end_time,TIME_DATE|TIME_MINUTES),
         TimeToString(g_smf.profile_available_time,TIME_DATE|TIME_MINUTES)));
   if(g_smf.vwap_valid)
      SMF_AddNote(g_smf.provenance,StringFormat("VWAP %s %.5f response %s available %s",
         g_smf.vwap_source,g_smf.vwap_value,g_smf.vwap_response,
         TimeToString(g_smf.vwap_available_time,TIME_DATE|TIME_MINUTES)));
   if(g_smf.volume_valid)
      SMF_AddNote(g_smf.provenance,StringFormat("VOLUME PROXY %s %.2fx ratio score %d available %s",
         g_smf.volume_source,g_smf.volume_ratio,g_smf.flow_score,
         TimeToString(g_smf.volume_available_time,TIME_DATE|TIME_MINUTES)));
   if(g_smf.event_provenance!="") SMF_AddNote(g_smf.provenance,g_smf.event_provenance);
   g_smf.provenance+=StringFormat("; decision %s; max availability %s",
      TimeToString(g_smf.decision_time,TIME_DATE|TIME_MINUTES),
      TimeToString((datetime)max_avail,TIME_DATE|TIME_MINUTES));
}

void SMF_RefreshDecisionView(const int rates_total)
{
   if(!InpUseSmartMoneyVolumeEvidence) return;
   int closed=rates_total-2;
   if(closed<1 || g_smf_snapshot.closed_bar!=closed) return;
   int sw=-1,dp=-1,st=-1,ze=-1;
   bool chain=false,structure=false,zone=false,retest=false,rr=false,authority=false;
   double ztop=0.0,zbot=0.0;
   int direction=0;
   if(InpUseRetestLifecycle && g_active_setup.active)
   {
      direction=(g_active_setup.is_buy?1:-1);
      sw=FindCausalEventById(g_active_setup.sweep_event_id);
      dp=FindCausalEventById(g_active_setup.displacement_event_id);
      st=FindCausalEventById(g_active_setup.structure_event_id);
      ze=FindCausalEventById(g_active_setup.zone_event_id);
      chain=(sw>=0 && dp>=0 && st>=0 && IsCausallyConnected(sw,dp) && IsCausallyConnected(dp,st));
      structure=(st>=0); zone=(ze>=0); ztop=g_active_setup.zone_top; zbot=g_active_setup.zone_bottom;
      retest=IsConfirmedSignalState(g_active_setup.state) &&
             g_active_setup.confirmed_bar>g_active_setup.created_bar;
      rr=(g_active_setup.rr1+1e-9>=InpMinRR1);
      authority=retest;
   }
   else if(g_trade_setup.valid || g_trade_setup.confirmation_pending)
   {
      direction=(g_trade_setup.is_buy?1:-1);
      sw=FindCausalEventById(g_trade_setup.sweep_event_id);
      dp=FindCausalEventById(g_trade_setup.displacement_event_id);
      st=FindCausalEventById(g_trade_setup.structure_event_id);
      ze=FindCausalEventById(g_trade_setup.zone_event_id);
      chain=(sw>=0 && dp>=0 && st>=0 && IsCausallyConnected(sw,dp) && IsCausallyConnected(dp,st));
      structure=(st>=0); zone=(ze>=0); ztop=g_trade_setup.zone_top; zbot=g_trade_setup.zone_bottom;
      retest=(g_trade_setup.confirmation_bar>g_trade_setup.created_bar &&
              g_trade_setup.confirmation_time>g_trade_setup.created_time);
      rr=(g_trade_setup.rr1+1e-9>=InpMinRR1);
      authority=(g_trade_setup.valid && !g_trade_setup.confirmation_pending && retest);
   }
   else if(g_causal_diag.directional_watch_available)
   {
      direction=(g_causal_diag.directional_watch_is_buy?1:-1);
      chain=(g_causal_diag.directional_watch_sweep_ok && g_causal_diag.directional_watch_disp_ok &&
             g_causal_diag.directional_watch_mss_ok);
      structure=g_causal_diag.directional_watch_mss_ok;
      zone=g_causal_diag.directional_watch_zone_ok;
   }
   else if(g_htf_bias!=0) direction=g_htf_bias;

   SMF_EvaluateCandidate(closed,direction>0,ztop,zbot,sw,dp,st,ze,
                         chain,structure,zone,retest,rr,authority,false);
   if(direction==0)
   {
      // Neutral dashboard state: independently identify a closed-bar VAL/VAH
      // reaction, but never infer a trade direction from confluence alone.
      g_smf.direction=0; g_smf.conflict=false; g_smf.conflict_reason="";
      g_smf.integrate_profile=false; g_smf.integrate_vwap=false; g_smf.integrate_flow=false;
      g_smf.flow_score=0; g_smf.flow_directional=false; g_smf.vwap_score=50;
      g_smf.vwap_reclaim=false; g_smf.vwap_rejection=false; g_smf.vwap_aligned=false;
      g_smf.profile_integrated_score=50.0; g_smf.missing_reason="";
      g_smf.integration_note="non-directional view; no score contribution";
      g_smf.flow_response=(g_smf.volume_expansion ?
         StringFormat("VOLUME EXPANSION %.2fx; DIRECTION NOT SELECTED (VOLUME PROXY)",g_smf.volume_ratio) :
         StringFormat("NORMAL TOTAL VOLUME %.2fx; VOLUME PROXY",g_smf.volume_ratio));
      if(g_smf.absorption_proxy) g_smf.flow_response+="; EFFORT/RESULT PROXY, NOT TRUE ABSORPTION";
      if(g_smf.profile_valid)
      {
         SMVPProfile view; ZeroMemory(view); view.valid=true; view.rows=1;
         view.poc=g_smf.profile_poc; view.vah=g_smf.profile_vah;
         view.val=g_smf.profile_val; view.row_size=g_smf.profile_row_size;
         view.hvn_n=g_smf.profile_hvn_count; view.lvn_n=g_smf.profile_lvn_count;
         for(int i=0;i<SMF_PROFILE_NODE_MAX;i++)
         { view.hvn_px[i]=g_smf.profile_hvn[i]; view.lvn_px[i]=g_smf.profile_lvn[i]; }
         double atr=(closed<ArraySize(g_atr_buf)?g_atr_buf[closed]:g_atr);
         bool bt=false,bbt=false,bnt=false,br=false;
         bool stouch=false,sbt=false,snt=false,sr=false;
         string bdesc="",sdesc="";
         int bscore=SMF_ProfileScore(view,1,g_buf_h[closed],g_buf_l[closed],g_buf_c[closed],
                     g_smf_snapshot.candle_close_location,atr,bt,bbt,bnt,br,bdesc);
         int sscore=SMF_ProfileScore(view,-1,g_buf_h[closed],g_buf_l[closed],g_buf_c[closed],
                     g_smf_snapshot.candle_close_location,atr,stouch,sbt,snt,sr,sdesc);
         g_smf.profile_touch=(bt || stouch);
         g_smf.profile_boundary_touch=(bbt || sbt);
         g_smf.profile_node_touch=(bnt || snt);
         g_smf.profile_rejection=(br || sr);
         if(br && !sr) {g_smf.profile_score=bscore; g_smf.profile_response=bdesc;}
         else if(sr && !br) {g_smf.profile_score=sscore; g_smf.profile_response=sdesc;}
         else if(g_buf_c[closed]<g_smf.profile_val)
         {g_smf.profile_score=25; g_smf.profile_response="BELOW VAL / NO CONFIRMED REACTION";}
         else if(g_buf_c[closed]>g_smf.profile_vah)
         {g_smf.profile_score=25; g_smf.profile_response="ABOVE VAH / NO CONFIRMED REACTION";}
         else {g_smf.profile_score=50; g_smf.profile_response="IN VALUE / NON-DIRECTIONAL";}
         if(g_smf.profile_node_touch && StringFind(g_smf.profile_response,"NON-DIRECTIONAL")<0)
            g_smf.profile_response+="; NODE LOCATION (NON-DIRECTIONAL)";
      }
      else
      {
         g_smf.profile_touch=false; g_smf.profile_boundary_touch=false;
         g_smf.profile_node_touch=false; g_smf.profile_rejection=false;
         g_smf.profile_response="PROFILE UNAVAILABLE"; g_smf.profile_score=50;
      }
      if(g_smf.vwap_valid)
      {
         double atr=(closed<ArraySize(g_atr_buf)?g_atr_buf[closed]:g_atr);
         double tol=MathMax(_Point*2.0,atr*0.08);
         g_smf.vwap_touch=(g_buf_l[closed]<=g_smf.vwap_value+tol &&
                            g_buf_h[closed]>=g_smf.vwap_value-tol);
         g_smf.vwap_event=g_smf.vwap_touch;
         g_smf.vwap_response=(g_buf_c[closed]>=g_smf.vwap_value?"ABOVE VWAP":"BELOW VWAP");
      }
      if(!g_smf.vwap_valid)
      {g_smf.vwap_touch=false; g_smf.vwap_event=false; g_smf.vwap_response="VWAP UNAVAILABLE";}
      if(!structure) SMF_AddNote(g_smf.missing_reason,"causal MSS/structure not present");
      if(!zone) SMF_AddNote(g_smf.missing_reason,"causal OB/FVG zone not present");
      if(g_smf.profile_touch && !g_smf.profile_rejection)
         SMF_AddNote(g_smf.missing_reason,"profile touch lacks rejection");
      if(g_smf.volume_expansion && !g_smf.flow_directional)
         SMF_AddNote(g_smf.missing_reason,"volume spike is non-directional proxy evidence");
      if(g_smf.valid && g_smf.causal_ok)
         g_smf.status=(g_smf.profile_rejection?"REACTION - NO CORE STRUCTURE":"WATCH - NO CORE STRUCTURE");
      else if(!g_smf.causal_ok) g_smf.status="CAUSALITY FAIL";
      else g_smf.status="NO DATA / WATCH";
      g_smf.provenance=SMF_OrderFlowDisclosure();
      if(g_smf.profile_valid)
         SMF_AddNote(g_smf.provenance,StringFormat("MVP %s %s POC %.5f VAH %.5f VAL %.5f available %s",
            g_smf.profile_tag,g_smf.profile_source,g_smf.profile_poc,g_smf.profile_vah,
            g_smf.profile_val,TimeToString(g_smf.profile_available_time,TIME_DATE|TIME_MINUTES)));
      if(g_smf.vwap_valid)
         SMF_AddNote(g_smf.provenance,StringFormat("VWAP %s %.5f available %s",
            g_smf.vwap_source,g_smf.vwap_value,
            TimeToString(g_smf.vwap_available_time,TIME_DATE|TIME_MINUTES)));
      if(g_smf.volume_valid)
         SMF_AddNote(g_smf.provenance,StringFormat("VOLUME PROXY %s ratio %.2fx available %s",
            g_smf.volume_source,g_smf.volume_ratio,
            TimeToString(g_smf.volume_available_time,TIME_DATE|TIME_MINUTES)));
      SMF_AddNote(g_smf.provenance,"NO CAUSAL SETUP AUTHORIZED BY THIS EVIDENCE LAYER");
   }
}

void SMF_CopyToFacts(const SSmartMoneyEvidence &src,SSMFSignalFacts &dst)
{
   dst.valid=src.valid; dst.causal_ok=src.causal_ok; dst.decision_bar=src.closed_bar;
   dst.direction=src.direction; dst.decision_time=src.decision_time;
   dst.availability_time=(src.event_available_time>src.profile_available_time ?
                           src.event_available_time : src.profile_available_time);
   if(src.vwap_available_time>dst.availability_time) dst.availability_time=src.vwap_available_time;
   if(src.volume_available_time>dst.availability_time) dst.availability_time=src.volume_available_time;
   if(dst.availability_time<=0) dst.availability_time=src.decision_time;
   dst.profile_available_time=src.profile_available_time;
   dst.vwap_available_time=src.vwap_available_time;
   dst.volume_available_time=src.volume_available_time;
   dst.event_available_time=src.event_available_time;
   dst.profile_poc=src.profile_poc; dst.profile_vah=src.profile_vah; dst.profile_val=src.profile_val;
   dst.profile_row_size=src.profile_row_size;
   dst.profile_hvn_count=src.profile_hvn_count; dst.profile_lvn_count=src.profile_lvn_count;
   for(int i=0;i<SMF_PROFILE_NODE_MAX;i++)
   { dst.profile_hvn[i]=src.profile_hvn[i]; dst.profile_lvn[i]=src.profile_lvn[i]; }
   dst.vwap_value=src.vwap_value;
   dst.volume_ratio=src.volume_ratio; dst.profile_score=src.profile_score;
   dst.vwap_score=src.vwap_score; dst.flow_score=src.flow_score;
   dst.integrate_profile=src.integrate_profile; dst.integrate_vwap=src.integrate_vwap;
   dst.integrate_flow=src.integrate_flow; dst.same_bar_cluster=src.shared_bar_cluster;
   dst.conflict=src.conflict; dst.profile_touch=src.profile_touch;
   dst.profile_boundary_touch=src.profile_boundary_touch;
   dst.profile_node_touch=src.profile_node_touch;
   dst.vwap_event=src.vwap_event; dst.volume_expansion=src.volume_expansion;
   dst.profile_fingerprint=src.profile_fingerprint; dst.profile_tag=src.profile_tag;
   dst.profile_source=src.profile_source; dst.volume_source=src.volume_source;
   dst.vwap_source=src.vwap_source; dst.profile_response=src.profile_response;
   dst.vwap_response=src.vwap_response; dst.flow_response=src.flow_response;
   dst.status=src.status; dst.sweep_event_id=src.sweep_event_id;
   dst.displacement_event_id=src.displacement_event_id;
   dst.structure_event_id=src.structure_event_id; dst.zone_event_id=src.zone_event_id;
   dst.provenance=src.provenance;
}

bool SMF_FactsEqual(const SSMFSignalFacts &a,const SSMFSignalFacts &b)
{
   double eps=MathMax(_Point*0.1,1e-10);
   if(a.profile_hvn_count!=b.profile_hvn_count || a.profile_lvn_count!=b.profile_lvn_count)
      return false;
   for(int i=0;i<SMF_PROFILE_NODE_MAX;i++)
      if(MathAbs(a.profile_hvn[i]-b.profile_hvn[i])>eps ||
         MathAbs(a.profile_lvn[i]-b.profile_lvn[i])>eps) return false;
   return (a.valid==b.valid && a.causal_ok==b.causal_ok && a.decision_bar==b.decision_bar &&
      a.direction==b.direction && a.decision_time==b.decision_time &&
      a.availability_time==b.availability_time &&
      a.profile_available_time==b.profile_available_time &&
      a.vwap_available_time==b.vwap_available_time &&
      a.volume_available_time==b.volume_available_time &&
      a.event_available_time==b.event_available_time &&
      MathAbs(a.profile_poc-b.profile_poc)<=eps && MathAbs(a.profile_vah-b.profile_vah)<=eps &&
      MathAbs(a.profile_val-b.profile_val)<=eps && MathAbs(a.profile_row_size-b.profile_row_size)<=eps &&
      MathAbs(a.vwap_value-b.vwap_value)<=eps && MathAbs(a.volume_ratio-b.volume_ratio)<=1e-8 &&
      a.profile_score==b.profile_score && a.vwap_score==b.vwap_score && a.flow_score==b.flow_score &&
      a.integrate_profile==b.integrate_profile && a.integrate_vwap==b.integrate_vwap &&
      a.integrate_flow==b.integrate_flow && a.same_bar_cluster==b.same_bar_cluster &&
      a.conflict==b.conflict && a.profile_touch==b.profile_touch &&
      a.profile_boundary_touch==b.profile_boundary_touch && a.profile_node_touch==b.profile_node_touch &&
      a.vwap_event==b.vwap_event &&
      a.volume_expansion==b.volume_expansion &&
      a.profile_fingerprint==b.profile_fingerprint && a.profile_tag==b.profile_tag &&
      a.profile_source==b.profile_source && a.volume_source==b.volume_source && a.vwap_source==b.vwap_source &&
      a.profile_response==b.profile_response && a.vwap_response==b.vwap_response &&
      a.flow_response==b.flow_response && a.status==b.status &&
      a.sweep_event_id==b.sweep_event_id && a.displacement_event_id==b.displacement_event_id &&
      a.structure_event_id==b.structure_event_id && a.zone_event_id==b.zone_event_id &&
      a.provenance==b.provenance);
}

bool SMF_FactsCausalValid(const SSMFSignalFacts &facts)
{
   if(!facts.valid) return true;
   if(facts.profile_hvn_count<0 || facts.profile_hvn_count>SMF_PROFILE_NODE_MAX ||
      facts.profile_lvn_count<0 || facts.profile_lvn_count>SMF_PROFILE_NODE_MAX) return false;
   for(int i=0;i<facts.profile_hvn_count;i++)
      if(!MathIsValidNumber(facts.profile_hvn[i]) || facts.profile_hvn[i]<=0.0) return false;
   for(int i=0;i<facts.profile_lvn_count;i++)
      if(!MathIsValidNumber(facts.profile_lvn[i]) || facts.profile_lvn[i]<=0.0) return false;
   if(!facts.causal_ok || facts.decision_time<=0 || facts.availability_time<=0 ||
      facts.availability_time>facts.decision_time) return false;
   if(facts.profile_available_time>0 && facts.profile_available_time>facts.decision_time) return false;
   if(facts.vwap_available_time>0 && facts.vwap_available_time>facts.decision_time) return false;
   if(facts.volume_available_time>0 && facts.volume_available_time>facts.decision_time) return false;
   if(facts.event_available_time>0 && facts.event_available_time>facts.decision_time) return false;
   return true;
}

ulong SMF_FactsDigest(const SSMFSignalFacts &facts)
{
   string row="SMFFACT|"+(facts.valid?"1":"0")+"|"+(facts.causal_ok?"1":"0")+
      "|"+IntegerToString(facts.direction)+"|"+IntegerToString((long)facts.decision_bar)+
      "|"+IntegerToString((long)facts.decision_time)+"|"+IntegerToString((long)facts.availability_time)+
      "|"+IntegerToString((long)facts.profile_available_time)+"|"+IntegerToString((long)facts.vwap_available_time)+
      "|"+IntegerToString((long)facts.volume_available_time)+"|"+IntegerToString((long)facts.event_available_time)+
      "|"+IntegerToString((long)facts.profile_fingerprint)+"|"+DoubleToString(facts.profile_poc,10)+
      "|"+DoubleToString(facts.profile_vah,10)+"|"+DoubleToString(facts.profile_val,10)+
      "|"+DoubleToString(facts.profile_row_size,10)+"|"+DoubleToString(facts.vwap_value,10)+
      "|"+DoubleToString(facts.volume_ratio,8)+"|"+IntegerToString(facts.profile_score)+
      "|"+IntegerToString(facts.vwap_score)+"|"+IntegerToString(facts.flow_score)+
      "|"+(facts.integrate_profile?"1":"0")+"|"+(facts.integrate_vwap?"1":"0")+
      "|"+(facts.integrate_flow?"1":"0")+"|"+(facts.same_bar_cluster?"1":"0")+
      "|"+(facts.conflict?"1":"0")+"|"+(facts.profile_touch?"1":"0")+
      "|"+(facts.vwap_event?"1":"0")+"|"+(facts.volume_expansion?"1":"0")+
      "|"+IntegerToString(facts.profile_hvn_count)+"|"+IntegerToString(facts.profile_lvn_count)+
      "|"+(facts.profile_boundary_touch?"1":"0")+"|"+(facts.profile_node_touch?"1":"0")+
      "|"+facts.profile_tag+"|"+facts.profile_source+"|"+facts.volume_source+"|"+facts.vwap_source+
      "|"+facts.profile_response+"|"+facts.vwap_response+"|"+facts.flow_response+"|"+facts.status+
      "|"+facts.sweep_event_id+"|"+facts.displacement_event_id+"|"+facts.structure_event_id+
      "|"+facts.zone_event_id+"|"+facts.provenance;
   for(int i=0;i<facts.profile_hvn_count && i<SMF_PROFILE_NODE_MAX;i++)
      row+="|HVN"+IntegerToString(i)+"="+DoubleToString(facts.profile_hvn[i],10);
   for(int i=0;i<facts.profile_lvn_count && i<SMF_PROFILE_NODE_MAX;i++)
      row+="|LVN"+IntegerToString(i)+"="+DoubleToString(facts.profile_lvn[i],10);
   return SMF_HashString(row);
}

string SMF_StateDigestString()
{
   string row="SMFSTATE|"+(g_smf.enabled?"1":"0")+"|"+(g_smf.valid?"1":"0")+
      "|"+(g_smf.causal_ok?"1":"0")+"|"+IntegerToString(g_smf.direction)+
      "|"+IntegerToString((long)g_smf.decision_time)+"|"+IntegerToString((long)g_smf.profile_available_time)+
      "|"+IntegerToString((long)g_smf.vwap_available_time)+"|"+IntegerToString((long)g_smf.volume_available_time)+
      "|"+IntegerToString(g_smf.profile_score)+"|"+IntegerToString(g_smf.vwap_score)+
      "|"+IntegerToString(g_smf.flow_score)+"|"+(g_smf.conflict?"1":"0")+
      "|"+(g_smf.integrate_profile?"1":"0")+"|"+(g_smf.integrate_vwap?"1":"0")+
      "|"+(g_smf.integrate_flow?"1":"0")+"|"+(g_smf.shared_bar_cluster?"1":"0")+
      "|"+IntegerToString((long)g_smf.profile_fingerprint)+"|"+DoubleToString(g_smf.profile_poc,10)+
      "|"+DoubleToString(g_smf.profile_vah,10)+"|"+DoubleToString(g_smf.profile_val,10)+
      "|"+DoubleToString(g_smf.vwap_value,10)+"|"+DoubleToString(g_smf.volume_ratio,8)+
      "|"+g_smf.profile_tag+"|"+g_smf.profile_source+"|"+g_smf.vwap_source+"|"+g_smf.volume_source+
      "|"+g_smf.profile_response+"|"+g_smf.vwap_response+"|"+g_smf.flow_response+
      "|"+g_smf.status+"|"+g_smf.integration_note+"|"+g_smf.event_provenance+
      "|"+(g_smf.profile_boundary_touch?"1":"0")+"|"+(g_smf.profile_node_touch?"1":"0");
   row+="|NODES="+IntegerToString(g_smf.profile_hvn_count)+":"+
      IntegerToString(g_smf.profile_lvn_count);
   for(int i=0;i<g_smf.profile_hvn_count && i<SMF_PROFILE_NODE_MAX;i++)
      row+="|HVN"+IntegerToString(i)+"="+DoubleToString(g_smf.profile_hvn[i],10);
   for(int i=0;i<g_smf.profile_lvn_count && i<SMF_PROFILE_NODE_MAX;i++)
      row+="|LVN"+IntegerToString(i)+"="+DoubleToString(g_smf.profile_lvn[i],10);
   row+="|ACTIVEFACTS="+IntegerToString((long)SMF_FactsDigest(g_active_setup.smf));
   row+="|TRADEFACTS="+IntegerToString((long)SMF_FactsDigest(g_trade_setup.smf));
   for(int i=0;i<ArraySize(g_confirmed_signal_journal);i++)
      row+="|JFACT="+g_confirmed_signal_journal[i].setup_id+":"+
           IntegerToString((long)SMF_FactsDigest(g_confirmed_signal_journal[i].smf));
   return row;
}

int SMF_AdjustCandleScore(const int score,const bool volume_expansion,
                          const int flow_score,const bool flow_integrated)
{
   if(!InpUseSmartMoneyVolumeEvidence || !volume_expansion) return (int)SMF_Clamp(score,0,100);
   // Replace, do not add to, the legacy +10 raw-spike component.
   int adjusted=MathMax(0,score-10);
   if(flow_integrated)
      adjusted+=(int)MathRound(10.0*SMF_Clamp(flow_score,0,100)/100.0);
   return (int)SMF_Clamp(adjusted,0,100);
}

void SMF_TestExpect(const bool ok,const string label,string &failure,int &passed)
{
   if(ok) passed++;
   else if(failure=="") failure=label;
}

bool SMF_TestBuildAsOfProfile(const int asof,const double future_volume,SMVPProfile &p)
{
   double lo[4]={100.00,100.20,99.90,80.00};
   double hi[4]={100.60,100.80,100.50,120.00};
   double op[4]={100.10,100.35,100.20,100.00};
   double cl[4]={100.45,100.55,100.00,110.00};
   double vol[4]={80.0,120.0,90.0,future_volume};
   if(asof<0 || asof>=4) return false;
   if(future_volume>1000.0)
   {
      lo[3]-=50.0; hi[3]+=50.0; op[3]+=25.0; cl[3]-=25.0;
   }
   double pmin=lo[0],pmax=hi[0];
   for(int b=1;b<=asof;b++)
   { if(lo[b]<pmin) pmin=lo[b]; if(hi[b]>pmax) pmax=hi[b]; }
   if(!MVP_PrepareGrid(p,pmin,pmax,0.10,0.01)) return false;
   for(int b=0;b<=asof;b++)
      MVP_Accumulate(p,lo[b],hi[b],op[b],cl[b],vol[b],false);
   MVP_Finalize(p,0.70,0.60,0.35);
   if(!p.valid) return false;
   p.bar_start=0; p.bar_end=asof;
   p.t_start=(datetime)1700000000;
   p.t_end=p.t_start+(datetime)(asof*60);
   return true;
}

bool SMF_SelfTest()
{
   string failure=""; int passed=0;
   SMVPProfile p; ZeroMemory(p);
   p.valid=true; p.rows=8; p.poc=101.0; p.val=100.0; p.vah=102.0; p.row_size=0.10;
   int ps=0; bool touch=false,boundary_touch=false,node_touch=false,reject=false; string response="";
   ps=SMF_ProfileScore(p,1,101.10,99.70,100.80,0.786,0.50,
                       touch,boundary_touch,node_touch,reject,response);
   SMF_TestExpect(touch && reject && ps>=90 && StringFind(response,"VAL SWEEP")>=0,
                  "T1 VAL sweep/reclaim BUY",failure,passed);
   ps=SMF_ProfileScore(p,-1,102.30,100.90,101.20,0.214,0.50,
                       touch,boundary_touch,node_touch,reject,response);
   SMF_TestExpect(touch && reject && ps>=90 && StringFind(response,"VAH SWEEP")>=0,
                  "T2 VAH sweep/rejection SELL",failure,passed);
   ps=SMF_ProfileScore(p,1,100.30,99.80,99.90,0.20,0.50,
                       touch,boundary_touch,node_touch,reject,response);
   SMF_TestExpect(touch && !reject && ps<50 && StringFind(response,"NO REJECTION")>=0,
                  "T3 VAL touch without rejection",failure,passed);

   string state=SMF_ClassifyStatus(true,false,false,false,true,false,false,false,
                                   false,false,false,false,false,true);
   SMF_TestExpect(state=="WATCH","T4 VWAP reclaim without structure is WATCH",failure,passed);
   double test_o[5]={100.0,100.0,100.0,100.10,100.0};
   double test_h[5]={100.2,100.2,100.2,100.30,100.2};
   double test_l[5]={99.8,99.8,99.8,100.00,99.8};
   double test_c[5]={100.0,100.0,100.0,100.165,100.0};
   long test_tv[5]={100,100,100,200,0};
   long test_rv[5]={0,0,0,0,0};
   SCandleIntelligence spike=AnalyzeCandleIntelligence(3,test_o,test_h,test_l,test_c,
                                                        test_tv,test_rv,1.0);
   bool displacement=spike.is_displacement;
   int flow=SMF_FlowProxyScore(spike.volume_expansion,spike.volume_ratio,
                               spike.close_location,false);
   state=SMF_ClassifyStatus(spike.valid,false,false,false,false,displacement,false,false,
                            false,false,false,false,false,true);
   SMF_TestExpect(spike.volume_expansion && !displacement && flow==0 && state=="NO TRADE",
                  "T5 range-bound volume spike is not displacement",failure,passed);
   bool absorb=SMF_IsAbsorptionProxy(true,1.8,0.25,1.1);
   string absorb_label="EFFORT/RESULT PROXY; NOT TRUE ABSORPTION";
   SMF_TestExpect(absorb && StringFind(absorb_label,"PROXY")>=0 &&
                  StringFind(absorb_label,"NOT TRUE")>=0,
                  "T6 absorption/exhaustion remains a proxy",failure,passed);
   SMF_TestExpect(SMF_ProfileAsOfValid(10,10,200,200) &&
                  SMF_CausalTimeValid(199,200) && !SMF_CausalTimeValid(201,200) &&
                  !SMF_ProfileAsOfValid(11,10,200,200),
                  "T7 historical profile replay rejects future availability",failure,passed);
   SSMFSignalFacts causal_facts; ZeroMemory(causal_facts);
   causal_facts.valid=true; causal_facts.causal_ok=true;
   causal_facts.decision_time=200; causal_facts.availability_time=200;
   causal_facts.profile_available_time=199;
   SMF_TestExpect(SMF_FactsCausalValid(causal_facts),
                  "T7b immutable facts retain only available sources",failure,passed);
   causal_facts.volume_available_time=201;
   SMF_TestExpect(!SMF_FactsCausalValid(causal_facts),
                  "T7c immutable facts reject future volume availability",failure,passed);
   state=SMF_ClassifyStatus(true,true,true,true,true,true,true,true,
                            false,true,false,false,true,true);
   SMF_TestExpect(StringFind(state,"WAIT CLOSED BAR")>=0,
                  "T8 forming candle cannot confirm",failure,passed);
   string disclosure=SMF_OrderFlowDisclosure();
   SMF_TestExpect(StringFind(disclosure,"VOLUME PROXY")>=0 &&
                  StringFind(disclosure,"TRUE BID/ASK")>=0 &&
                  StringFind(disclosure,"UNAVAILABLE")>=0,
                  "T9 unavailable true order flow is explicitly disclosed",failure,passed);
   state=SMF_ClassifyStatus(true,true,true,false,false,false,true,true,
                            false,true,false,true,false,true);
   SMF_TestExpect(state=="CONFLICT / WATCH",
                  "T10 conflicting evidence stays contextual WATCH",failure,passed);
   state=SMF_ClassifyStatus(true,false,false,false,false,false,true,true,
                            true,true,true,false,false,true);
   SMF_TestExpect(state=="EXECUTION READY (CORE AUTHORITY)",
                  "T11 execution-ready mirrors all core gates",failure,passed);
   SMF_TestExpect(SMF_FlowProxyScore(true,2.5,0.90,true)>=90 &&
                  SMF_FlowProxyScore(true,1.30,0.90,true)==0,
                  "T12 flow score requires expansion beyond legacy threshold",failure,passed);

   SMVPProfile node_profile; ZeroMemory(node_profile);
   node_profile.valid=true; node_profile.rows=8; node_profile.poc=101.0;
   node_profile.val=100.0; node_profile.vah=102.0; node_profile.row_size=0.10;
   bool base_touch=false,base_boundary=false,base_node=false,base_reject=false;
   string node_response="";
   int base_node_score=SMF_ProfileScore(node_profile,1,101.65,101.55,101.60,0.50,0.10,
      base_touch,base_boundary,base_node,base_reject,node_response);
   node_profile.hvn_n=1; node_profile.hvn_px[0]=101.60;
   bool hvn_touch=false,hvn_boundary=false,hvn_node=false,hvn_reject=false;
   int hvn_score=SMF_ProfileScore(node_profile,1,101.65,101.55,101.60,0.50,0.10,
      hvn_touch,hvn_boundary,hvn_node,hvn_reject,node_response);
   node_profile.hvn_n=0; node_profile.lvn_n=1; node_profile.lvn_px[0]=101.60;
   bool lvn_touch=false,lvn_boundary=false,lvn_node=false,lvn_reject=false;
   int lvn_score=SMF_ProfileScore(node_profile,1,101.65,101.55,101.60,0.50,0.10,
      lvn_touch,lvn_boundary,lvn_node,lvn_reject,node_response);
   SMF_TestExpect(base_node_score==hvn_score && base_node_score==lvn_score &&
                  hvn_touch && lvn_touch && !hvn_boundary && !lvn_boundary &&
                  hvn_node && lvn_node && !hvn_reject && !lvn_reject &&
                  StringFind(node_response,"LVN")>=0 &&
                  StringFind(node_response,"NON-DIRECTIONAL")>=0,
                  "T13 HVN/LVN preserve location without directional score",failure,passed);

   SMVPProfile replay_a,replay_b; ZeroMemory(replay_a); ZeroMemory(replay_b);
   bool replay_a_ok=SMF_TestBuildAsOfProfile(2,500.0,replay_a);
   bool replay_b_ok=SMF_TestBuildAsOfProfile(2,50000.0,replay_b);
   ulong replay_a_hash=(replay_a_ok?SMF_ProfileFingerprint(replay_a,"ASOF-TEST","SYNTHETIC TOTAL VOLUME"):0);
   ulong replay_b_hash=(replay_b_ok?SMF_ProfileFingerprint(replay_b,"ASOF-TEST","SYNTHETIC TOTAL VOLUME"):0);
   SMF_TestExpect(replay_a_ok && replay_b_ok && replay_a.bar_end==2 && replay_b.bar_end==2 &&
                  replay_a_hash==replay_b_hash &&
                  MathAbs(replay_a.poc-replay_b.poc)<1e-10 &&
                  MathAbs(replay_a.vah-replay_b.vah)<1e-10 &&
                  MathAbs(replay_a.val-replay_b.val)<1e-10,
                  "T14 synthetic historical profile replay ignores future-bar mutations",failure,passed);

   int removed_raw=SMF_AdjustCandleScore(40,true,80,false);
   int replaced_proxy=SMF_AdjustCandleScore(40,true,80,true);
   SMF_TestExpect(removed_raw==30 && replaced_proxy==38,
                  "T15 raw volume bonus is replaced, not stacked",failure,passed);

   if(failure!="")
   {
      Print("[SMF SelfTest] FAIL after ",passed,"/17: ",failure);
      return false;
   }
   Print("[SMF SelfTest] PASS ",passed,"/17 deterministic scenarios");
   return true;
}

void MVP_OnChartChange()
{
   if(!InpUseMasterVolumeProfile || g_rates_total<3) return;
   bool rebuild=(InpMVPMode==MVP_MODE_VISIBLE || g_mvp_count<=0);
   MVP_Update(g_rates_total, rebuild, true);
}

void MVP_Expect(const bool ok, const string why, string &where)
{
   if(!ok && where=="") where=why;
}

bool MVP_SelfTest()
{
   string where="";
   MVP_Expect(MathAbs(MVP_TriangleMass(0, 2, 4, 0, 4)-1.0)<1e-9, "triangle full", where);
   MVP_Expect(MathAbs(MVP_TriangleMass(0, 2, 4, 0, 2)-0.5)<1e-9, "triangle half", where);
   MVP_Expect(MathAbs(MVP_TriangleMass(0, 2, 4, 1, 3)-0.75)<1e-9, "triangle mid", where);
   MVP_Expect(MathAbs(MVP_TriangleMass(0, 0, 4, 0, 4)-1.0)<1e-9, "triangle right", where);
   MVP_Expect(MathAbs(MVP_TriangleMass(0, 4, 4, 0, 4)-1.0)<1e-9, "triangle left", where);
   MVP_Expect(MVP_TriangleMass(0, 2, 4, 5, 6)==0.0, "triangle outside", where);

   SMVPProfile p;
   ZeroMemory(p);
   p.rows=5;
   p.price_lo=100.0;
   p.row_size=1.0;
   p.vol[0]=1; p.vol[1]=2; p.vol[2]=10; p.vol[3]=3; p.vol[4]=1;
   MVP_Finalize(p, 0.70, 0.60, 0.35);
   MVP_Expect(p.valid && p.poc_row==2, "poc row", where);
   MVP_Expect(MathAbs(p.poc-102.5)<1e-6, "poc px", where);
   MVP_Expect(p.va_lo==2 && p.va_hi==3, "va rows", where);
   MVP_Expect(MathAbs(p.val-102.0)<1e-6 && MathAbs(p.vah-104.0)<1e-6, "va prices", where);

   ZeroMemory(p);
   p.rows=4;
   p.price_lo=0.0;
   p.row_size=1.0;
   p.vol[0]=1; p.vol[1]=5; p.vol[2]=5; p.vol[3]=1;
   MVP_Finalize(p, 0.70, 0.60, 0.35);
   MVP_Expect(p.valid && p.poc_row==1 && MathAbs(p.poc-1.5)<1e-6, "poc tie", where);

   ZeroMemory(p);
   p.rows=5;
   p.price_lo=0.0;
   p.row_size=1.0;
   p.vol[0]=5; p.vol[1]=1; p.vol[2]=5; p.vol[3]=8; p.vol[4]=5;
   MVP_Finalize(p, 0.70, 0.60, 0.35);
   MVP_Expect(p.lvn_n>=1 && MathAbs(p.lvn_px[0]-1.5)<1e-6, "lvn", where);

   ZeroMemory(p);
   p.rows=7;
   p.price_lo=0.0;
   p.row_size=1.0;
   p.vol[0]=1; p.vol[1]=8; p.vol[2]=2; p.vol[3]=10; p.vol[4]=3; p.vol[5]=7; p.vol[6]=1;
   MVP_Finalize(p, 0.70, 0.60, 0.35);
   bool hvn_ok=(p.hvn_n==2);
   if(hvn_ok)
   {
      double a=p.hvn_px[0], b=p.hvn_px[1];
      if(a>b) { double tmp=a; a=b; b=tmp; }
      hvn_ok=(MathAbs(a-1.5)<1e-6 && MathAbs(b-5.5)<1e-6);
   }
   MVP_Expect(hvn_ok, "hvn", where);

   SMVPProfile q;
   ZeroMemory(q);
   MVP_Expect(MVP_PrepareGrid(q, 100.0, 104.0, 1.0, 0.01), "grid", where);
   MVP_Accumulate(q, 100.0, 104.0, 100.0, 102.0, 100.0, false);
   double sum=0.0, bs=0.0;
   for(int i=0;i<q.rows;i++) { sum+=q.vol[i]; bs+=q.buy[i]+q.sell[i]; }
   MVP_Expect(MathAbs(sum-100.0)<1e-6, "uniform deposit", where);
   MVP_Expect(MathAbs(bs-sum)<1e-6, "split sum", where);

   ZeroMemory(q);
   MVP_PrepareGrid(q, 100.0, 104.0, 1.0, 0.01);
   MVP_Accumulate(q, 100.0, 104.0, 101.0, 103.0, 80.0, true);
   sum=0.0;
   for(int i=0;i<q.rows;i++) sum+=q.vol[i];
   MVP_Expect(MathAbs(sum-80.0)<1e-5, "triangle deposit", where);

   MqlDateTime dt;
   dt.year=2024; dt.mon=1; dt.day=15; dt.hour=2; dt.min=0; dt.sec=0;
   datetime local=StructToTime(dt);
   int kd=MVP_OvernightDateKey(local, 8, 16);
   int kn=MVP_OvernightDateKey(local, 22, 6);
   MVP_Expect(kd==DateKey(local), "day key", where);
   MVP_Expect(kn==DateKey(local-86400), "overnight key", where);

   // row cap: a wide span must not ask for more than MVP_MAX_ROWS bins
   SMVPProfile cap;
   ZeroMemory(cap);
   MVP_Expect(MVP_PrepareGrid(cap, 0.0, 10000.0, 0.01, 0.01), "wide grid", where);
   MVP_Expect(cap.rows<=MVP_MAX_ROWS && cap.rows>0 && cap.row_size>0.0, "row cap", where);

   if(where!="")
   {
      Print(">>> ", QSMC_VERSION_TEXT, " Master Volume Profile self-test FAIL @ ", where);
      return false;
   }
   return true;
}

//===== v6.3.0 ZONE REACTION ENGINE (ZRE) ================================
// OBSERVATIONAL ONLY. ZRE never creates, mutates, invalidates or authorizes
// a setup and never touches CalculateAITradeSetup / ManageSetupLifecycle.
// No trading functions. Every confirmed fact is read on the closed bar
// (index rates_total-2); the forming bar is never used for a zone.
//
// STAGE 1 - unified strong zones.
//   Sources : g_confluent_sr (already merged), causal un-invalidated OB and
//             FVG, POC/VAH/VAL/HVN of the active g_mvp profile, PDH/PDL/PWH/PWL.
//   Merge   : zones closer than ConfluentSRMergeTolerance() (InpConfluentSRMergeATR
//             x ATR) become one zone, never taller than InpZREMaxZoneATR x ATR
//             unless one interval fully contains the other.
//   Side    : by position versus the closed-bar close (below = SUPPORT,
//             above = RESISTANCE, close inside the zone = by the zone midpoint).
//   Score   : ZONE STRENGTH 0-100 = touches 20 + confluence count 20 + source
//             tier 10 + swept 10 + HTF 14 + D1 6 + freshness 20. It measures
//             the quality of the evidence. It is not a win rate.
//
// Double counting: BuildConfluentSRLevels already contains PDH/PDL/PWH/PWL and
// unmitigated OB centres as members. When that layer is on, the direct OB /
// PDH.. candidates carry 0 units (geometry and token only), so a level is never
// counted twice. If the member sits outside the merged zone the count is
// understated, which is the conservative direction.
//
// Determinism: the merge result depends only on the sorted candidate set
// (min/max/union/sum/OR - no averaging), so full rebuild and incremental
// update give identical zones. ZRE_SelfTest() checks this by permuting input.
//==========================================================================

int ZRE_CfgMaxZones()
{
   int v=InpZREMaxZones;
   if(v<1) v=1;
   if(v>ZRE_HARD_MAX_ZONES) v=ZRE_HARD_MAX_ZONES;
   return v;
}

int ZRE_CfgMinZoneScore()
{
   int v=InpZREMinZoneScore;
   if(v<0) v=0;
   if(v>100) v=100;
   return v;
}

double ZRE_CfgPadATR()
{
   double v=InpZREZonePadATR;
   if(!MathIsValidNumber(v) || v<0.02 || v>1.0) v=0.10;
   return v;
}

double ZRE_CfgMaxZoneATR()
{
   double v=InpZREMaxZoneATR;
   if(!MathIsValidNumber(v) || v<0.3 || v>5.0) v=1.5;
   return v;
}

int ZRE_CfgFreshBars()
{
   int v=InpZREFreshBars;
   if(v<10) v=96;
   if(v>2000) v=2000;
   return v;
}

void ZRE_ContextInit(SZREContext &ctx)
{
   ctx.closed=-1;
   ctx.atr=0.0;
   ctx.tol=0.0;
   ctx.touch_tol=0.0;
   ctx.max_h=0.0;
   ctx.close_px=0.0;
   ctx.hist=60;
   ctx.fresh_bars=96;
   ctx.htf_bias=0;
   ctx.d1_bias=0;
   ctx.min_score=60;
   ctx.max_zones=6;
}

//--------------------------------------------------------------------
// Tokens: sorted, unique, '+' separated (order independent)
//--------------------------------------------------------------------
string ZRE_CleanToken(const string tok)
{
   string s=tok;
   StringReplace(s,"+","p");
   StringTrimLeft(s);
   StringTrimRight(s);
   if(s=="") s="?";
   return s;
}

string ZRE_TokenUnion(const string a,const string b)
{
   string all=a;
   if(a=="") all=b;
   else if(b!="") all=a+"+"+b;
   if(all=="") return "";
   string parts[];
   int n=StringSplit(all,'+',parts);
   if(n<=0) return "";
   for(int i=1;i<n;i++)
   {
      string key=parts[i];
      int j=i-1;
      while(j>=0 && StringCompare(parts[j],key)>0)
      {
         parts[j+1]=parts[j];
         j--;
      }
      parts[j+1]=key;
   }
   string out="";
   for(int i=0;i<n;i++)
   {
      if(i>0 && parts[i]==parts[i-1]) continue;
      if(out!="") out+="+";
      out+=parts[i];
   }
   return out;
}

//--------------------------------------------------------------------
// Candidates
//--------------------------------------------------------------------
bool ZRE_AddCand(SZRECand &arr[],const double lo,const double hi,const string token,
                 const int units,const int tier,const bool swept,const int born_bar)
{
   if(!MathIsValidNumber(lo) || !MathIsValidNumber(hi) || lo<=0.0 || hi<lo) return false;
   int n=ArraySize(arr);
   if(n>=ZRE_MAX_CAND) return false;
   if(ArrayResize(arr,n+1,32)<n+1) return false;
   int t=tier;
   if(t<0) t=0;
   if(t>10) t=10;
   arr[n].lo=lo;
   arr[n].hi=hi;
   arr[n].tokens=ZRE_TokenUnion(token,"");   // canonical; callers pass ZRE_CleanToken() for external names
   arr[n].units=(units<0?0:units);
   arr[n].tier=t;
   arr[n].swept=swept;
   arr[n].born_bar=(born_bar<0?-1:born_bar);
   return true;
}

// Total order used for the canonical candidate sequence.
bool ZRE_CandBefore(const SZRECand &a,const SZRECand &b)
{
   if(a.lo!=b.lo) return a.lo<b.lo;
   if(a.hi!=b.hi) return a.hi<b.hi;
   int c=StringCompare(a.tokens,b.tokens);
   if(c!=0) return c<0;
   if(a.units!=b.units) return a.units<b.units;
   if(a.tier!=b.tier) return a.tier<b.tier;
   if(a.swept!=b.swept) return (!a.swept && b.swept);
   return a.born_bar<b.born_bar;
}

void ZRE_SortCands(SZRECand &a[])
{
   int n=ArraySize(a);
   for(int i=1;i<n;i++)
   {
      SZRECand key=a[i];
      int j=i-1;
      while(j>=0 && ZRE_CandBefore(key,a[j]))
      {
         a[j+1]=a[j];
         j--;
      }
      a[j+1]=key;
   }
}

void ZRE_MergeInto(SZRECand &dst,const SZRECand &src)
{
   dst.lo=MathMin(dst.lo,src.lo);
   dst.hi=MathMax(dst.hi,src.hi);
   dst.tokens=ZRE_TokenUnion(dst.tokens,src.tokens);
   dst.units=dst.units+src.units;
   dst.tier=(dst.tier>src.tier?dst.tier:src.tier);
   dst.swept=(dst.swept || src.swept);
   if(dst.born_bar<0) dst.born_bar=src.born_bar;
   else if(src.born_bar>=0 && src.born_bar<dst.born_bar) dst.born_bar=src.born_bar;
}

double ZRE_Gap(const SZRECand &a,const SZRECand &b)
{
   double g=MathMax(a.lo,b.lo)-MathMin(a.hi,b.hi);
   return (g>0.0?g:0.0);
}

// Repeatedly merge the closest eligible pair (gap <= tol). A pair is
// eligible when the union stays within max_h, or one interval contains the
// other. Ties go to the lowest pair in canonical order.
int ZRE_Consolidate(SZRECand &a[],const double tol,const double max_h)
{
   ZRE_SortCands(a);
   for(int guard=0;guard<ZRE_MAX_CAND*2;guard++)
   {
      int n=ArraySize(a);
      int bi=-1,bj=-1;
      double best=DBL_MAX;
      for(int i=0;i<n;i++)
      {
         for(int j=i+1;j<n;j++)
         {
            if(a[j].lo-a[i].hi>tol) break;     // sorted by lo: no later j can be closer
            double g=ZRE_Gap(a[i],a[j]);
            if(g>tol) continue;
            double uh=MathMax(a[i].hi,a[j].hi)-MathMin(a[i].lo,a[j].lo);
            bool contained=((a[i].lo<=a[j].lo && a[i].hi>=a[j].hi) ||
                            (a[j].lo<=a[i].lo && a[j].hi>=a[i].hi));
            if(uh>max_h && !contained) continue;
            if(g<best)
            {
               best=g;
               bi=i;
               bj=j;
            }
         }
      }
      if(bi<0) break;
      ZRE_MergeInto(a[bi],a[bj]);
      for(int k=bj;k<n-1;k++) a[k]=a[k+1];
      ArrayResize(a,n-1);
      ZRE_SortCands(a);
   }
   return ArraySize(a);
}

//--------------------------------------------------------------------
// Side, touches, score
//--------------------------------------------------------------------
ENUM_ZRE_SIDE ZRE_SideFor(const double lo,const double hi,const double close_px)
{
   if(hi<=close_px) return ZRE_SUPPORT;
   if(lo>=close_px) return ZRE_RESISTANCE;
   return (close_px>=(lo+hi)*0.5 ? ZRE_SUPPORT : ZRE_RESISTANCE);
}

// A touch episode starts on the first bar of a run of bars whose range
// overlaps the zone (expanded by tol). Consecutive touching bars are one.
int ZRE_CountTouchEpisodes(const double lo,const double hi,const double tol,
                           const int from_bar,const int to_bar,
                           const double &h[],const double &l[])
{
   int a=(from_bar>0?from_bar:0);
   int lim=ArraySize(h);
   if(ArraySize(l)<lim) lim=ArraySize(l);
   int b=(to_bar<lim-1?to_bar:lim-1);
   int cnt=0;
   bool prev=false;
   for(int k=a;k<=b;k++)
   {
      bool hit=(h[k]>=lo-tol && l[k]<=hi+tol);
      if(hit && !prev) cnt++;
      prev=hit;
   }
   return cnt;
}

// v6.4.2 AUDIT-Z2 (SINGLE SOURCE OF TRUTH for a zone's ROLE):
//   rejection at SUPPORT -> BUY, rejection at RESISTANCE -> SELL, and a zone that
//   price closed beyond (BROKEN) trades on the OPPOSITE side when retested from
//   there - i.e. the classic break + retest of a flipped level.
// The role used to be derived from where the LAST CLOSE sits relative to the band
// (ZRE_SideFor), which has two consequences that produced the reported symptoms:
//   (a) a band the close is INSIDE flips role between bars ("support ... BROKEN
//       while price is above the band" was really "price left a half-inside zone
//       upwards, and the half-insode rule called it support");
//   (b) the role, the rejection geometry and therefore the DIRECTION were all
//       re-derived from the newest close, so the same zone could hand out BUY on
//       one bar and SELL on the next at the same price.
// Causal rule: the role is decided from the close of the bar the zone was BORN
// on (a demand/OB formed under price is support, a supply formed above is
// resistance) and afterwards only the BROKEN/FLIPPED state changes it. When the
// birth bar is unknown we keep the legacy price-position rule.
ENUM_ZRE_SIDE ZRE_CausalSide(const double lo,const double hi,const int born_bar,
                             const double &c[],const double &fallback_close)
{
   if(born_bar>=0 && born_bar<ArraySize(c) && c[born_bar]>0.0)
      return (c[born_bar]<=lo ? ZRE_RESISTANCE : (c[born_bar]>=hi ? ZRE_SUPPORT : ZRE_SideFor(lo,hi,c[born_bar])));
   return ZRE_SideFor(lo,hi,fallback_close);
}
int ZRE_TouchPts(const int touches)
{
   if(touches<=0) return 0;
   if(touches==1) return 10;
   if(touches==2) return 15;
   return ZRE_W_TOUCH;
}

int ZRE_CountPts(const int units)
{
   if(units<=1) return 6;
   if(units==2) return 13;
   if(units==3) return 17;
   return ZRE_W_CONF_COUNT;
}

int ZRE_FreshPts(const int age,const int fresh)
{
   if(age<0) return ZRE_W_FRESH/2;       // no birth bar: neutral
   if(age<=fresh) return ZRE_W_FRESH;
   if(age<=2*fresh) return 14;
   if(age<=4*fresh) return 8;
   return 3;
}

int ZRE_BiasPts(const int bias,const ENUM_ZRE_SIDE side,const int aligned_pts,const int neutral_pts)
{
   if(bias==0) return neutral_pts;
   bool agree=((side==ZRE_SUPPORT && bias>0) || (side==ZRE_RESISTANCE && bias<0));
   return (agree?aligned_pts:0);
}


// Flipped: an earlier closed bar (within lookback) was beyond the far side by
// more than break_atr x ATR, and price is now on the near side.
bool ZRE_IsFlipped(const SZREZone &z,const int closed,const int lookback,const double brk,const double &c[])
{
   int from=(int)MathMax(0,closed-lookback);
   int last=(int)MathMin(closed-1,ArraySize(c)-1);
   for(int b=from;b<=last;b++)
   {
      if(z.side==ZRE_SUPPORT && c[b]<z.lo-brk) return true;
      if(z.side==ZRE_RESISTANCE && c[b]>z.hi+brk) return true;
   }
   return false;
}

// v6.5.0 (audit BUG-09 / BUG-10): the SAME formula, but the HTF/D1 contribution
// is reported separately from the intrinsic level quality.
//
//   intrinsic = touches + sources + tier + swept + freshness   (max 80)
//   context   = HTF + D1                                       (max 20)
//   total     = clamp(intrinsic + context, 0, 100)             <- IDENTICAL to before
//
// Why this matters: `total` is used for TWO different decisions - "is this level
// worth DRAWING" and "is this level worth TESTING for a reaction" - and it
// embeds a directional term. A strong resistance that opposes a bullish HTF/D1
// loses 20 of its 100 points, so its ceiling is 80 and its measured value in the
// audit's news-rally scenario is 66, which sits 4 points above the
// InpZREMinZoneScore=60 drop at ZRE_BuildZones. One fewer touch (61) or one
// fewer independent source (54) and the level is DELETED before any rejection
// test can ever run against it.
//
// ZRE's published behaviour is deliberately unchanged: ZRE_ScoreZone below
// returns exactly the same number it always did, so ZRE_SelfTest's reference
// score still holds. Only the Reaction Signal Layer consumes the split, and it
// uses `intrinsic` for the recovery filter and `context` for reporting.
int ZRE_ScoreZoneEx(const SZRECand &c,const ENUM_ZRE_SIDE side,const SZREContext &ctx,
                    const int touches,const int age,string &detail,
                    int &intrinsic_out,int &context_out)
{
   int p_touch=ZRE_TouchPts(touches);
   int p_count=ZRE_CountPts(c.units);
   int p_tier=(c.tier<0?0:(c.tier>ZRE_W_CONF_TIER?ZRE_W_CONF_TIER:c.tier));
   int p_swept=(c.swept?ZRE_W_SWEPT:0);
   int p_htf=ZRE_BiasPts(ctx.htf_bias,side,ZRE_W_HTF,6);
   int p_d1=ZRE_BiasPts(ctx.d1_bias,side,ZRE_W_D1,3);
   int p_fresh=ZRE_FreshPts(age,ctx.fresh_bars);
   int intrinsic=p_touch+p_count+p_tier+p_swept+p_fresh;
   int context=p_htf+p_d1;
   int total=intrinsic+context;
   if(intrinsic<0) intrinsic=0;
   if(intrinsic>ZRE_W_TOUCH+ZRE_W_CONF_COUNT+ZRE_W_CONF_TIER+ZRE_W_SWEPT+ZRE_W_FRESH)
      intrinsic=ZRE_W_TOUCH+ZRE_W_CONF_COUNT+ZRE_W_CONF_TIER+ZRE_W_SWEPT+ZRE_W_FRESH;
   if(context<0) context=0;
   if(context>ZRE_W_HTF+ZRE_W_D1) context=ZRE_W_HTF+ZRE_W_D1;
   if(total<0) total=0;
   if(total>100) total=100;
   intrinsic_out=intrinsic;
   context_out=context;
   detail=StringFormat("ZONE STRENGTH %d/100 (evidence quality) = touches %d/%d (%d) + sources %d/%d (%d) + tier %d/%d + swept %d/%d + HTF %d/%d + D1 %d/%d + fresh %d/%d",
                       total,p_touch,ZRE_W_TOUCH,touches,p_count,ZRE_W_CONF_COUNT,c.units,
                       p_tier,ZRE_W_CONF_TIER,p_swept,ZRE_W_SWEPT,p_htf,ZRE_W_HTF,
                       p_d1,ZRE_W_D1,p_fresh,ZRE_W_FRESH);
   return total;
}

// Unchanged signature and unchanged result: a thin wrapper over ZRE_ScoreZoneEx
// so every existing caller (and the g++ self-test harness) sees identical values.
int ZRE_ScoreZone(const SZRECand &c,const ENUM_ZRE_SIDE side,const SZREContext &ctx,
                  const int touches,const int age,string &detail)
{
   int intrinsic=0,context=0;
   return ZRE_ScoreZoneEx(c,side,ctx,touches,age,detail,intrinsic,context);
}

string ZRE_ZoneId(const ENUM_ZRE_SIDE side,const double lo,const double hi)
{
   return "ZRE|"+(side==ZRE_SUPPORT?"S":"R")+"|"+DoubleToString(lo,_Digits)+"|"+DoubleToString(hi,_Digits);
}

// Ranking: strength desc, nearer to the close, lower price, id.
bool ZRE_ZoneBefore(const SZREZone &a,const SZREZone &b,const double close_px)
{
   if(a.strength!=b.strength) return a.strength>b.strength;
   double da=MathAbs((a.lo+a.hi)*0.5-close_px);
   double db=MathAbs((b.lo+b.hi)*0.5-close_px);
   if(da!=db) return da<db;
   if(a.lo!=b.lo) return a.lo<b.lo;
   return StringCompare(a.id,b.id)<0;
}

// Pure function of (candidates, context, h/l history). Consumes cands.
// v6.5.0 (audit BUG-10 / BUG-11): the SAME build, plus the zones that the
// min-score filter dropped and the zones the render cap truncated.
//
// `out[]`    is byte-identical to what ZRE_BuildZones has always produced.
// `dropped[]` carries every candidate rejected ONLY by `score < ctx.min_score`,
//            fully scored, consolidated, causally sided and ranked by the same
//            ZRE_ZoneBefore total order, capped at ZRE_HARD_MAX_ZONES.
// `tail[]`   carries the ranked zones beyond the render cap (`keep`), i.e. the
//            ones that survived the quality filter but were truncated for chart
//            clutter, capped at ZRE_HARD_MAX_ZONES.
//
// Rationale: `ctx.min_score` and `ctx.max_zones` are DRAWING budgets. Using them
// as DETECTION budgets means a strong counter-trend resistance can be deleted,
// or ranked out, before any rejection test ever runs against it. The Reaction
// Signal Layer consumes dropped[]/tail[] for reaction evaluation only and still
// draws nothing beyond the existing caps.
int ZRE_BuildZonesEx(SZRECand &cands[],const SZREContext &ctx,const double &h[],const double &l[],
                     const double &c[],SZREZone &out[],SZREZone &dropped[],SZREZone &tail[])
{
   ArrayResize(out,0);
   ArrayResize(dropped,0);
   ArrayResize(tail,0);
   if(!(ctx.atr>0.0) || ctx.closed<1) return 0;
   ZRE_Consolidate(cands,ctx.tol,ctx.max_h);
   SZREZone scored[];
   SZREZone rejected[];
   int m=0;
   int rd=0;
   int n=ArraySize(cands);
   for(int i=0;i<n;i++)
   {
      // v6.4.2 AUDIT-Z1 (CAUSAL ROLE): the side is decided from the close of the
      // bar the zone was BORN on, not from the newest close. A demand/OB that
      // formed under that close is support, a supply that formed above it is
      // resistance, and afterwards only BROKEN/FLIPPED may reverse it (see
      // ZRE_EffectiveSide). With born_bar<0 the legacy price rule still applies.
      ENUM_ZRE_SIDE side=ZRE_CausalSide(cands[i].lo,cands[i].hi,cands[i].born_bar,c,ctx.close_px);
      int from_bar=ctx.closed-ctx.hist;
      if(cands[i].born_bar>from_bar) from_bar=cands[i].born_bar;
      int touches=ZRE_CountTouchEpisodes(cands[i].lo,cands[i].hi,ctx.touch_tol,
                                         from_bar,ctx.closed-1,h,l);
      int age=(cands[i].born_bar>=0 ? ctx.closed-cands[i].born_bar : -1);
      string detail="";
      int intrinsic=0,context=0;
      int score=ZRE_ScoreZoneEx(cands[i],side,ctx,touches,age,detail,intrinsic,context);
      // One fill helper is used for all three lists so a dropped zone carries
      // exactly the same fields a kept zone does (deterministic, comparable).
      if(score<ctx.min_score)
      {
         if(rd<ZRE_HARD_MAX_ZONES && ArrayResize(rejected,rd+1,16)>=rd+1)
         {
            rejected[rd].id=ZRE_ZoneId(side,cands[i].lo,cands[i].hi);
            rejected[rd].lo=cands[i].lo;
            rejected[rd].hi=cands[i].hi;
            rejected[rd].side=side;
            rejected[rd].strength=score;
            rejected[rd].touches=touches;
            rejected[rd].sources=cands[i].tokens;
            rejected[rd].swept=cands[i].swept;
            rejected[rd].htf_aligned=((side==ZRE_SUPPORT && ctx.htf_bias>0) ||
                                      (side==ZRE_RESISTANCE && ctx.htf_bias<0));
            rejected[rd].age_bars=age;
            rejected[rd].units=cands[i].units;
            rejected[rd].detail=detail;
            rejected[rd].intrinsic=intrinsic;
            rejected[rd].context=context;
            rd++;
         }
         continue;
      }
      if(ArrayResize(scored,m+1,16)<m+1) break;
      scored[m].id=ZRE_ZoneId(side,cands[i].lo,cands[i].hi);
      scored[m].lo=cands[i].lo;
      scored[m].hi=cands[i].hi;
      scored[m].side=side;
      scored[m].strength=score;
      scored[m].touches=touches;
      scored[m].sources=cands[i].tokens;
      scored[m].swept=cands[i].swept;
      scored[m].htf_aligned=((side==ZRE_SUPPORT && ctx.htf_bias>0) ||
                             (side==ZRE_RESISTANCE && ctx.htf_bias<0));
      scored[m].age_bars=age;
      scored[m].units=cands[i].units;
      scored[m].detail=detail;
      scored[m].intrinsic=intrinsic;
      scored[m].context=context;
      m++;
   }
   // Insertion sort on a TOTAL order (ZRE_ZoneBefore) - deliberately not an
   // unstable sort, so a full rebuild and an incremental update agree and so a
   // permutation of the candidate set produces the same result (ZRE_SelfTest).
   for(int i=1;i<m;i++)
   {
      SZREZone key=scored[i];
      int j=i-1;
      while(j>=0 && ZRE_ZoneBefore(key,scored[j],ctx.close_px))
      {
         scored[j+1]=scored[j];
         j--;
      }
      scored[j+1]=key;
   }
   for(int i=1;i<rd;i++)
   {
      SZREZone key=rejected[i];
      int j=i-1;
      while(j>=0 && ZRE_ZoneBefore(key,rejected[j],ctx.close_px))
      {
         rejected[j+1]=rejected[j];
         j--;
      }
      rejected[j+1]=key;
   }
   int keep=(m<ctx.max_zones?m:ctx.max_zones);
   if(keep>0 && ArrayResize(out,keep)==keep)
      for(int i=0;i<keep;i++) out[i]=scored[i];
   int ntail=m-keep;
   if(ntail>ZRE_HARD_MAX_ZONES) ntail=ZRE_HARD_MAX_ZONES;
   if(ntail>0 && ArrayResize(tail,ntail)==ntail)
      for(int i=0;i<ntail;i++) tail[i]=scored[keep+i];
   if(rd>0 && ArrayResize(dropped,rd)==rd)
      for(int i=0;i<rd;i++) dropped[i]=rejected[i];
   return ArraySize(out);
}

// Unchanged signature and unchanged result: a thin wrapper over ZRE_BuildZonesEx
// so every existing caller (and the g++ self-test harness) sees identical zones.
int ZRE_BuildZones(SZRECand &cands[],const SZREContext &ctx,const double &h[],const double &l[],
                   const double &c[],SZREZone &out[])
{
   SZREZone dropped[];
   SZREZone tail[];
   return ZRE_BuildZonesEx(cands,ctx,h,l,c,out,dropped,tail);
}

//--------------------------------------------------------------------
// Collection from the existing engine state (no duplicate detection logic)
//--------------------------------------------------------------------
// Once per closed bar (or when the causal state was rebuilt). Intra-bar
// ticks return immediately: nothing is created or drawn per tick.
//====================================================================
// STAGES 2-8 - PURE CORE (no chart state; executed by tools/zre_mql_harness.py)
//====================================================================
double ZRE_RoundTick(const double x,const double tick)
{
   if(!(tick>0.0)) return x;
   return MathRound(x/tick)*tick;
}

void ZRE_ParamsInit(SZREParams &p)
{
   p.approach_atr=0.75;
   p.break_atr=0.30;
   p.expire_bars=600;
   p.max_pen_atr=0.35;
   p.min_wick=0.50;
   p.inside_reclaim=false;
   p.min_evidence=2;
   p.vol_support=1.10;
   p.min_score=65;
   p.entry_mode=(int)ZRE_ENTRY_CLOSE;
   p.project_bars=16;
   p.stop_zone_atr=0.40;
   p.conflict_gap=8.0;
   p.fresh_entry_bars=3;
   p.weak_zone=75;
   p.min_rr1=1.20;
   p.sl_buf_atr=0.20;
   p.max_stop_atr=3.0;
   p.tick=0.01;
   p.min_sample=30;
}

void ZRE_EvidenceInit(SZREEvidence &e)
{
   e.engulf=false;
   e.displacement=false;
   e.volume_valid=false;
   e.volume_ratio=0.0;
   e.htf_bias=0;
   e.d1_bias=0;
   e.pd_state=0;
   e.vwap_state=2;
   e.ema_state=2;
}

void ZRE_RejectionInit(SZRERejection &r)
{
   r.valid=false;
   r.touched=false;
   r.reclaimed=false;
   r.accepted=false;
   r.wick_ok=false;
   r.engulf=false;
   r.sweep_reclaim=false;
   r.volume_ok=false;
   r.displacement=false;
   r.groups=0;
   r.wick_ratio=0.0;
   r.penetration_atr=0.0;
   r.close_loc=0.0;
   r.reason="";
}

void ZRE_StatusInit(SZREZoneStatus &s)
{
   s.base_state=ZRE_ST_IDLE;
   s.state=ZRE_ST_IDLE;
   s.dist_atr=0.0;
   s.flipped=false;
   s.reaction=false;
   s.live_touch=false;
   s.note="";
}

void ZRE_SignalInit(SZRESignal &s)
{
   s.id="";
   s.zone_id="";
   s.is_buy=true;
   s.bar_time=0;
   s.bar_index=-1;
   s.zone_lo=0.0;
   s.zone_hi=0.0;
   s.zone_strength=0;
   s.zone_sources="";
   s.atr=0.0;
   s.entry=0.0;
   s.sl=0.0;
   s.tp1=0.0;
   s.tp2=0.0;
   s.tp3=0.0;
   s.stop_lo=0.0;
   s.stop_hi=0.0;
   s.rr1=0.0;
   s.rr2=0.0;
   s.rr3=0.0;
   s.score=0;
   s.score_detail="";
   s.htf_aligned=false;
}

void ZRE_OutcomeInit(SZREOutcome &o,const int bar_index)
{
   o.last_bar=bar_index;
   o.end_reason=ZRE_END_OPEN;
   o.best_target=0;
   o.sl_hit=false;
   o.mfe_r=0.0;
   o.mae_r=0.0;
   o.bars_to_tp1=-1;
   o.bars_to_end=0;
   o.end_time=0;
}

void ZRE_VerdictInit(SZREVerdict &v)
{
   v.kind=0;
   v.sig_index=-1;
   v.sig_id="";
   v.score=0;
   v.entry=0.0;
   v.sl=0.0;
   v.tp1=0.0;
   v.tp2=0.0;
   v.tp3=0.0;
   v.rr1=0.0;
   v.smc_confluence=false;
   v.reason="no confirmed zone reaction";
   v.label="";
}

//--------------------------------------------------------------------
// Stage 2: zone state (closed-bar facts) - stateless, so a full rebuild
// and an incremental update classify identically.
//--------------------------------------------------------------------
double ZRE_ZoneGap(const SZREZone &z,const double px)
{
   if(px<z.lo) return z.lo-px;
   if(px>z.hi) return px-z.hi;
   return 0.0;
}

bool ZRE_IsBrokenNow(const SZREZone &z,const double prev_close,const double close_px,const double atr,const SZREParams &p)
{
   double brk=p.break_atr*atr;
   if(prev_close>=z.lo && close_px<z.lo-brk) return true;
   if(prev_close<=z.hi && close_px>z.hi+brk) return true;
   return false;
}

ENUM_ZRE_SIDE ZRE_EffectiveSide(const SZREZone &z,const double close_px,const double prev_close,
                                const double atr,const SZREParams &p)
{
   // ZRE_IsBrokenNow already encodes "from the near side, through the far
   // edge, by more than break_atr*ATR", so no second price test is needed.
   if(!ZRE_IsBrokenNow(z,prev_close,close_px,atr,p)) return z.side;
   if(z.side==ZRE_SUPPORT)  return ZRE_RESISTANCE;
   if(z.side==ZRE_RESISTANCE) return ZRE_SUPPORT;
   return z.side;
}

// v6.4.2 AUDIT-Z2 (SINGLE SOURCE OF TRUTH for the direction a zone implies):
//   rejection at SUPPORT -> BUY, rejection at RESISTANCE -> SELL, and a level that
//   price CLOSED BEYOND (broken) is traded on the far side when retested from
//   there - the classic break + retest of a flipped zone. HTF bias never appears
//   here: it grades (A/B/C), it does not flip direction.
int GetSignalDirection(const ENUM_ZRE_SIDE role,const ENUM_ZRE_STATE state,
                       const double close_px,const double zone_lo,const double zone_hi,
                       string &reason_out)
{
   reason_out="";
   if(state==ZRE_ST_EXPIRED){ reason_out="zone expired"; return 0; }
   if(state==ZRE_ST_BROKEN)
   {
      // broken support: only a retest FROM BELOW (close back under the band) is a
      // sell; broken resistance: only a retest from above is a buy. Anything else
      // is "price is standing in the wreckage" - no signal.
      if(role==ZRE_SUPPORT && close_px<zone_lo){ reason_out="support broken, retested from below -> SELL"; return -1; }
      if(role==ZRE_RESISTANCE && close_px>zone_hi){ reason_out="resistance broken, retested from above -> BUY"; return 1; }
      reason_out="broken zone but the close is not on the far side - no trade";
      return 0;
   }
   if(state==ZRE_ST_FLIPPED)
      return (role==ZRE_SUPPORT ? 1 : -1);      // role already reversed; trade the new role
   if(role==ZRE_SUPPORT)
   {
      if(close_px<zone_lo){ reason_out="close under a support band - that is a break, not a rejection"; return 0; }
      reason_out="rejection at support -> BUY"; return 1;
   }
   if(close_px>zone_hi){ reason_out="close above a resistance band - that is a break, not a rejection"; return 0; }
   reason_out="rejection at resistance -> SELL"; return -1;
}

ENUM_ZRE_STATE ZRE_ClassifyState(const SZREZone &z,const double prev_close,const double close_px,const double atr,
                                 const bool reaction,const bool live_touch,const SZREParams &p)
{
   if(z.age_bars>=0 && z.age_bars>p.expire_bars) return ZRE_ST_EXPIRED;
   // v6.4.1 ZR-1: BROKEN is a statement about the zone's ROLE, not about either
   // edge. A support that price closed ABOVE is not "broken" (that is bullish),
   // and a resistance closed BELOW is not "broken" either - price left the
   // level behind. Only a close beyond the role edge is a failure.
   if(ZRE_IsBrokenNow(z,prev_close,close_px,atr,p) &&
      ((z.side==ZRE_SUPPORT && close_px<z.lo) || (z.side==ZRE_RESISTANCE && close_px>z.hi)))
      return ZRE_ST_BROKEN;
   if(reaction) return ZRE_ST_REACTION_CONFIRMED;
   if(live_touch) return ZRE_ST_TOUCHED_PREVIEW;
   if(atr>0.0 && ZRE_ZoneGap(z,close_px)<=p.approach_atr*atr) return ZRE_ST_APPROACHING;
   return ZRE_ST_IDLE;
}

// The live candle only ever adds TOUCHED_PREVIEW on top of a closed-bar state.
ENUM_ZRE_STATE ZRE_EffectiveState(const ENUM_ZRE_STATE base_state,const bool live_touch)
{
   if(base_state==ZRE_ST_EXPIRED || base_state==ZRE_ST_BROKEN || base_state==ZRE_ST_REACTION_CONFIRMED)
      return base_state;
   if(live_touch) return ZRE_ST_TOUCHED_PREVIEW;
   return base_state;
}

string ZRE_StateName(const ENUM_ZRE_STATE s)
{
   if(s==ZRE_ST_HELD)      return "HELD";
   if(s==ZRE_ST_FLIPPED)   return "FLIPPED";
   if(s==ZRE_ST_APPROACHING) return "APPROACHING";
   if(s==ZRE_ST_TOUCHED_PREVIEW) return "TOUCHED (PREVIEW - unconfirmed)";
   if(s==ZRE_ST_REACTION_CONFIRMED) return "REACTION CONFIRMED";
   if(s==ZRE_ST_BROKEN) return "BROKEN";
   if(s==ZRE_ST_EXPIRED) return "EXPIRED";
   return "IDLE";
}

//--------------------------------------------------------------------
// Stage 3: rejection on the CLOSED bar (mirror for resistance)
//   1. the bar reached the zone
//   2. it penetrated the far edge by at most max_pen_atr x ATR
//   3. it CLOSED back on the near side (reclaim); a close inside the zone
//      (strict mode) or beyond it is acceptance and cancels the rejection
//   4. a pattern: wick >= min_wick, or engulfing, or sweep-and-reclaim
//   5. at least min_evidence independent groups: wick, engulfing, sweep-
//      reclaim, volume, displacement. A wick alone is therefore never enough.
//--------------------------------------------------------------------
bool ZRE_EvalRejection(const SZREZone &z,const SZREBar &b,const double atr,const SZREEvidence &ev,
                       const SZREParams &p,SZRERejection &r)
{
   ZRE_RejectionInit(r);
   if(!(atr>0.0)) { r.reason="NO ATR"; return false; }
   bool buy=(z.side==ZRE_SUPPORT);
   double range=b.h-b.l;
   if(!(range>0.0) || range<ZRE_MIN_RANGE_ATR*atr) { r.reason="RANGE"; return false; }
   double body_hi=MathMax(b.o,b.c);
   double body_lo=MathMin(b.o,b.c);
   double wick=(buy ? body_lo-b.l : b.h-body_hi);
   r.wick_ratio=wick/range;
   r.close_loc=(b.c-b.l)/range;
   double mid=(z.lo+z.hi)*0.5;
   double level=0.0;
   if(buy)
   {
      level=(p.inside_reclaim ? mid : z.hi);
      r.touched=(b.l<=z.hi);
      r.penetration_atr=(b.l<z.lo ? (z.lo-b.l)/atr : 0.0);
      r.reclaimed=(b.c>=level);
      r.sweep_reclaim=(b.l<z.lo && r.reclaimed);
   }
   else
   {
      level=(p.inside_reclaim ? mid : z.lo);
      r.touched=(b.h>=z.lo);
      r.penetration_atr=(b.h>z.hi ? (b.h-z.hi)/atr : 0.0);
      r.reclaimed=(b.c<=level);
      r.sweep_reclaim=(b.h>z.hi && r.reclaimed);
   }
   if(!r.touched) { r.reason="NO TOUCH"; return false; }
   if(r.penetration_atr>p.max_pen_atr+1e-9) { r.reason="PENETRATION"; return false; }
   if(!r.reclaimed) { r.accepted=true; r.reason="ACCEPTED (closed inside/beyond zone)"; return false; }
   r.wick_ok=(r.wick_ratio>=p.min_wick);
   r.engulf=ev.engulf;
   r.displacement=ev.displacement;
   r.volume_ok=(ev.volume_valid && ev.volume_ratio>=p.vol_support);
   r.groups=(r.wick_ok?1:0)+(r.engulf?1:0)+(r.sweep_reclaim?1:0)+(r.volume_ok?1:0)+(r.displacement?1:0);
   if(!(r.wick_ok || r.engulf || r.sweep_reclaim)) { r.reason="NO PATTERN"; return false; }
   if(r.groups<p.min_evidence)
   {
      r.reason=StringFormat("EVIDENCE %d<%d",r.groups,p.min_evidence);
      return false;
   }
   r.valid=true;
   return true;
}

//--------------------------------------------------------------------
// Stage 5: entry / SL / targets / STOP ZONE geometry
//--------------------------------------------------------------------
bool ZRE_ComputeEntrySL(const SZREZone &z,const SZREBar &b,const double atr,const SZREParams &p,
                        double &entry,double &sl,string &why)
{
   bool buy=(z.side==ZRE_SUPPORT);
   double e=b.c;
   if(p.entry_mode==(int)ZRE_ENTRY_ZONE_EDGE) e=(buy ? z.hi : z.lo);
   double s=(buy ? MathMin(z.lo,b.l)-p.sl_buf_atr*atr : MathMax(z.hi,b.h)+p.sl_buf_atr*atr);
   entry=ZRE_RoundTick(e,p.tick);
   sl=ZRE_RoundTick(s,p.tick);
   double risk=(buy ? entry-sl : sl-entry);
   if(!(risk>0.0)) { why="STOP GEOMETRY"; return false; }
   if(risk>atr*p.max_stop_atr) { why=StringFormat("STOP %.1f ATR > %.1f",risk/atr,p.max_stop_atr); return false; }
   return true;
}

bool ZRE_StrictOrder(const bool buy,const double entry,const double sl,const double t1,const double t2,const double t3)
{
   if(buy) return (sl<entry && entry<t1 && t1<t2 && t2<t3);
   return (sl>entry && entry>t1 && t1>t2 && t2>t3);
}

// raw1..3 come from FindInstitutionalTarget (0 = none). Missing targets fall
// back to 1.5/2.5/4.0 x ATR, everything is capped at the fixed opposing
// barrier. If the cap collapses the order, the targets are re-spread inside
// the room (TP3 = the barrier). RR1 below min_rr1 = no signal.
bool ZRE_FinalizeGeometry(const bool buy,const double entry,const double sl,const double atr,const double barrier_in,
                          const double raw1,const double raw2,const double raw3,const SZREParams &p,
                          double &tp1,double &tp2,double &tp3,double &rr1,double &rr2,double &rr3,
                          double &stop_lo,double &stop_hi,string &why)
{
   double risk=(buy ? entry-sl : sl-entry);
   if(!(risk>0.0)) { why="STOP GEOMETRY"; return false; }
   double barrier=barrier_in;
   if(barrier>0.0 && ((buy && barrier<=entry) || (!buy && barrier>=entry))) barrier=0.0;
   double dir=(buy ? 1.0 : -1.0);
   double t[3];
   t[0]=raw1;
   t[1]=raw2;
   t[2]=raw3;
   double mult[3]={1.5,2.5,4.0};
   for(int k=0;k<3;k++)
   {
      if(!(t[k]>0.0)) t[k]=entry+dir*atr*mult[k];
      if(barrier>0.0 && ((buy && t[k]>barrier) || (!buy && t[k]<barrier))) t[k]=barrier;
      t[k]=ZRE_RoundTick(t[k],p.tick);
   }
   if(!ZRE_StrictOrder(buy,entry,sl,t[0],t[1],t[2]))
   {
      if(!(barrier>0.0)) { why="TARGET ORDER"; return false; }
      double a1=t[0];
      bool a1_ok=(buy ? (a1>entry && a1<barrier) : (a1<entry && a1>barrier));
      if(!a1_ok) a1=entry+(barrier-entry)*0.40;
      t[0]=ZRE_RoundTick(a1,p.tick);
      t[2]=ZRE_RoundTick(barrier,p.tick);
      t[1]=ZRE_RoundTick((t[0]+t[2])*0.5,p.tick);
      if(!ZRE_StrictOrder(buy,entry,sl,t[0],t[1],t[2])) { why="TARGET ORDER"; return false; }
   }
   tp1=t[0];
   tp2=t[1];
   tp3=t[2];
   rr1=MathAbs(tp1-entry)/risk;
   rr2=MathAbs(tp2-entry)/risk;
   rr3=MathAbs(tp3-entry)/risk;
   if(rr1<p.min_rr1) { why=StringFormat("RR1 %.2f < %.2f",rr1,p.min_rr1); return false; }
   double h=p.stop_zone_atr*atr;
   if(buy)
   {
      stop_hi=tp3;
      stop_lo=MathMax(tp3-h,tp2);
   }
   else
   {
      stop_lo=tp3;
      stop_hi=MathMin(tp3+h,tp2);
   }
   why="";
   return true;
}

//--------------------------------------------------------------------
// Stage 4: ZONE REACTION SCORE 0-100 (evidence quality, not a probability
// of anything). Weights: zone 30, rejection 25, volume 10, HTF/D1 15,
// premium-discount + VWAP/EMA 10, room to the nearest barrier 10.
//--------------------------------------------------------------------
int ZRE_BiasPts15(const int bias,const bool buy,const int aligned,const int neutral)
{
   int dir=(buy ? 1 : -1);
   if(bias==dir) return aligned;
   if(bias==0) return neutral;
   return 0;
}

int ZRE_StatePts(const int st,const bool buy,const int aligned,const int neutral)
{
   if(st==2) return neutral;               // unknown
   int dir=(buy ? 1 : -1);
   if(st==dir) return aligned;
   if(st==0) return neutral;
   return 0;
}

int ZRE_ScoreSignal(const int zone_strength,const SZRERejection &rj,const SZREEvidence &ev,const bool buy,
                    const double room_r,const double min_rr1,string &detail)
{
   int zs=(int)MathRound(MathMax(0,MathMin(100,zone_strength))*ZRE_P_ZONE/100.0);
   int wick=(int)MathRound(10.0*MathMin(1.0,MathMax(0.0,rj.wick_ratio)/0.75));
   int eng=(rj.engulf ? 6 : 0);
   int swp=(rj.sweep_reclaim ? 5 : 0);
   double loc=(buy ? rj.close_loc : 1.0-rj.close_loc);
   int cl=(loc>=0.75 ? 4 : (loc>=0.60 ? 2 : 0));
   int rej=wick+eng+swp+cl;
   if(rej>ZRE_P_REJECT) rej=ZRE_P_REJECT;
   int vol=0;
   if(ev.volume_valid)
      vol=(ev.volume_ratio>=1.5 ? 10 : (ev.volume_ratio>=1.2 ? 7 : (ev.volume_ratio>=1.0 ? 4 : 0)));
   int htf=ZRE_BiasPts15(ev.htf_bias,buy,9,4)+ZRE_BiasPts15(ev.d1_bias,buy,6,2);
   int pd=(ev.pd_state>0 ? 4 : (ev.pd_state==0 ? 2 : 0));
   int loc_pts=pd+ZRE_StatePts(ev.vwap_state,buy,3,1)+ZRE_StatePts(ev.ema_state,buy,3,1);
   if(loc_pts>ZRE_P_LOCATION) loc_pts=ZRE_P_LOCATION;
   int room=0;
   if(room_r>=2.0) room=10;
   else if(room_r>=1.5) room=7;
   else if(room_r>=min_rr1) room=4;
   int total=zs+rej+vol+htf+loc_pts+room;
   if(total>100) total=100;
   if(total<0) total=0;
   detail=StringFormat("ZONE REACTION SCORE %d/100 (evidence quality)\nzone %d/30 | rejection %d/25 (wick %d eng %d sweep %d close %d)\nvolume %d/10 | HTF+D1 %d/15 | location %d/10 (P/D %d)\nroom to barrier %d/10 (%.2f R)",
                       total,zs,rej,wick,eng,swp,cl,vol,htf,loc_pts,pd,room,MathMin(room_r,99.0));
   return total;
}

//--------------------------------------------------------------------
// Stage 5/8: outcome tracker. One closed bar at a time, idempotent, and
// conservative: when a bar touches both the stop and a target the stop is
// counted first. Uses bars AFTER the signal bar only.
//--------------------------------------------------------------------
void ZRE_TrackAdvance(const SZRESignal &s,SZREOutcome &o,const int bar,const int project_bars,
                      const double &h[],const double &l[])
{
   if(o.end_reason!=ZRE_END_OPEN) return;
   if(bar<=o.last_bar) return;
   if(bar>=ArraySize(h) || bar>=ArraySize(l)) return;
   o.last_bar=bar;
   double risk=MathAbs(s.entry-s.sl);
   if(!(risk>0.0)) { o.end_reason=ZRE_END_STALE; return; }
   int age=bar-s.bar_index;
   double fav=(s.is_buy ? (h[bar]-s.entry)/risk : (s.entry-l[bar])/risk);
   double adv=(s.is_buy ? (s.entry-l[bar])/risk : (h[bar]-s.entry)/risk);
   if(fav>o.mfe_r) o.mfe_r=fav;
   if(adv>o.mae_r) o.mae_r=adv;
   bool sl_touch=(s.is_buy ? l[bar]<=s.sl : h[bar]>=s.sl);
   if(sl_touch)
   {
      o.sl_hit=true;
      o.end_reason=ZRE_END_SL;
      o.bars_to_end=age;
      return;
   }
   bool t1=(s.is_buy ? h[bar]>=s.tp1 : l[bar]<=s.tp1);
   bool t2=(s.is_buy ? h[bar]>=s.tp2 : l[bar]<=s.tp2);
   bool t3=(s.is_buy ? h[bar]>=s.tp3 : l[bar]<=s.tp3);
   if(t1 && o.best_target<1) { o.best_target=1; if(o.bars_to_tp1<0) o.bars_to_tp1=age; }
   if(t2 && o.best_target<2) o.best_target=2;
   if(t3 && o.best_target<3) o.best_target=3;
   if(o.best_target>=3)
   {
      o.end_reason=ZRE_END_TP3;
      o.bars_to_end=age;
      return;
   }
   if(age>=project_bars)
   {
      o.end_reason=ZRE_END_TIMEOUT;
      o.bars_to_end=age;
   }
}

void ZRE_TrackAdvanceTo(const SZRESignal &s,SZREOutcome &o,const int to_bar,const int project_bars,
                        const double &h[],const double &l[])
{
   for(int b=o.last_bar+1;b<=to_bar;b++)
   {
      if(o.end_reason!=ZRE_END_OPEN) break;
      ZRE_TrackAdvance(s,o,b,project_bars,h,l);
   }
}

void ZRE_ComputeStats(const SZREOutcome &o[],const int min_sample,SZREStats &st)
{
   st.logged=ArraySize(o);
   st.resolved=0;
   st.open=0;
   st.stale=0;
   st.timeouts=0;
   st.sl_first=0;
   st.tp1=0;
   st.tp2=0;
   st.tp3=0;
   double sm=0.0,sa=0.0,sb=0.0;
   int nb=0;
   for(int i=0;i<st.logged;i++)
   {
      if(o[i].end_reason==ZRE_END_OPEN) { st.open++; continue; }
      if(o[i].end_reason==ZRE_END_STALE) { st.stale++; continue; }
      st.resolved++;
      if(o[i].end_reason==ZRE_END_TIMEOUT) st.timeouts++;
      if(o[i].end_reason==ZRE_END_SL && o[i].best_target==0) st.sl_first++;
      if(o[i].best_target>=1) st.tp1++;
      if(o[i].best_target>=2) st.tp2++;
      if(o[i].best_target>=3) st.tp3++;
      sm+=o[i].mfe_r;
      sa+=o[i].mae_r;
      if(o[i].bars_to_tp1>=0) { sb+=o[i].bars_to_tp1; nb++; }
   }
   st.avg_mfe=(st.resolved>0 ? sm/st.resolved : 0.0);
   st.avg_mae=(st.resolved>0 ? sa/st.resolved : 0.0);
   st.avg_bars_tp1=(nb>0 ? sb/nb : 0.0);
   st.sufficient=(st.resolved>=min_sample);
}

// No frequency is shown before the sample requirement is met, and the sample
// size is always shown. Observed frequencies of a logged sample: not a forecast.
string ZRE_StatsText(const SZREStats &st,const int min_sample)
{
   if(!st.sufficient)
      return StringFormat("ZRE history: n=%d resolved (< %d needed) - frequencies withheld | open/censored %d",
                          st.resolved,min_sample,st.open);
   double n=(double)st.resolved;
   return StringFormat("ZRE history n=%d (open/censored %d): TP1 %.0f%% TP2 %.0f%% TP3 %.0f%% | stop first %.0f%% | MFE %.2fR MAE %.2fR (observed, not a forecast)",
                       st.resolved,st.open,100.0*st.tp1/n,100.0*st.tp2/n,100.0*st.tp3/n,
                       100.0*st.sl_first/n,st.avg_mfe,st.avg_mae);
}

//--------------------------------------------------------------------
// Stage 6: strongest-entry selection
//--------------------------------------------------------------------
// true when a ranks ahead of b: score, then RR1, then HTF alignment, then the
// newer bar, then id (total order -> deterministic).
bool ZRE_SignalBetter(const SZRESignal &a,const SZRESignal &b)
{
   if(a.score!=b.score) return a.score>b.score;
   if(MathAbs(a.rr1-b.rr1)>1e-9) return a.rr1>b.rr1;
   if(a.htf_aligned!=b.htf_aligned) return a.htf_aligned;
   if(a.bar_time!=b.bar_time) return a.bar_time>b.bar_time;
   return StringCompare(a.id,b.id)<0;
}

string ZRE_Clip(const string s,const int n)
{
   if(StringLen(s)<=n) return s;
   return StringSubstr(s,0,n-1)+"~";
}

bool ZRE_SelectVerdict(const SZRESignal &c[],const int htf_bias,const int d1_bias,const int smc_dir,
                       const string idle_reason,const SZREParams &p,SZREVerdict &v)
{
   ZRE_VerdictInit(v);
   int n=ArraySize(c);
   int bb=-1,bs=-1;
   for(int i=0;i<n;i++)
   {
      if(c[i].is_buy)
      {
         if(bb<0 || ZRE_SignalBetter(c[i],c[bb])) bb=i;
      }
      else
      {
         if(bs<0 || ZRE_SignalBetter(c[i],c[bs])) bs=i;
      }
   }
   if(bb<0 && bs<0)
   {
      v.reason=(idle_reason!="" ? idle_reason : "no confirmed zone reaction");
      return false;
   }
   int pick=-1;
   if(bb>=0 && bs>=0)
   {
      if(MathAbs((double)(c[bb].score-c[bs].score))<p.conflict_gap)
      {
         v.reason=StringFormat("BUY %d vs SELL %d within %.0f pts",c[bb].score,c[bs].score,p.conflict_gap);
         return false;
      }
      pick=(c[bb].score>c[bs].score ? bb : bs);
   }
   else pick=(bb>=0 ? bb : bs);
   int dir=(c[pick].is_buy ? 1 : -1);
   if(htf_bias==-dir && d1_bias==-dir && c[pick].zone_strength<p.weak_zone)
   {
      v.reason=StringFormat("against HTF+D1, zone %d<%d",c[pick].zone_strength,p.weak_zone);
      return false;
   }
   v.kind=dir;
   v.sig_index=pick;
   v.sig_id=c[pick].id;
   v.score=c[pick].score;
   v.entry=c[pick].entry;
   v.sl=c[pick].sl;
   v.tp1=c[pick].tp1;
   v.tp2=c[pick].tp2;
   v.tp3=c[pick].tp3;
   v.rr1=c[pick].rr1;
   v.smc_confluence=(smc_dir==dir);
   v.reason="";
   v.label=StringFormat("TOP ZONE REACTION CANDIDATE (score %d/100)",v.score);
   return true;
}

string ZRE_VerdictMini(const SZREVerdict &v,const int digits)
{
   if(v.kind==0) return "ZRE: NO TRADE ("+ZRE_Clip(v.reason,44)+")";
   return StringFormat("ZRE: %s %s | score %d | TP %s",(v.kind>0?"BUY":"SELL"),
                       DoubleToString(v.entry,digits),v.score,DoubleToString(v.tp1,digits));
}

//--------------------------------------------------------------------
// Self-test (style of MVP_SelfTest): synthetic data only, no chart access
//--------------------------------------------------------------------
void ZRE_Expect(const bool ok,const string why,string &where)
{
   if(!ok && where=="") where=why;
}

// 60 bars far above the test zone (100-101), except three touch runs.
void ZRE_TestSeries(double &h[],double &l[])
{
   ArrayResize(h,60);
   ArrayResize(l,60);
   for(int k=0;k<60;k++)
   {
      h[k]=111.0;
      l[k]=110.0;
   }
   l[20]=100.5;                      // episode 1
   l[40]=100.6;                      // episode 2 (bars 40-41 are one run)
   l[41]=100.7;
   l[59]=100.2;                      // the closed bar itself: never a prior touch
}

void ZRE_TestCtx(SZREContext &ctx)
{
   ZRE_ContextInit(ctx);
   ctx.closed=59;
   ctx.atr=1.0;
   ctx.tol=0.5;
   ctx.touch_tol=0.1;
   ctx.max_h=1.5;
   ctx.close_px=105.0;
   ctx.hist=300;
   ctx.fresh_bars=96;
   ctx.htf_bias=1;
   ctx.d1_bias=1;
   ctx.min_score=0;
   ctx.max_zones=6;
}

bool ZRE_SameZones(const SZREZone &a[],const SZREZone &b[])
{
   if(ArraySize(a)!=ArraySize(b)) return false;
   for(int i=0;i<ArraySize(a);i++)
   {
      if(a[i].id!=b[i].id || a[i].strength!=b[i].strength || a[i].touches!=b[i].touches ||
         a[i].sources!=b[i].sources || a[i].swept!=b[i].swept || a[i].age_bars!=b[i].age_bars ||
         a[i].units!=b[i].units || a[i].side!=b[i].side || a[i].htf_aligned!=b[i].htf_aligned)
         return false;
   }
   return true;
}

// Fixed 8-candidate set in identity (0), reverse (1) or stride (2) order.
void ZRE_TestFill(SZRECand &dst[],const int mode)
{
   SZRECand src[];
   ZRE_AddCand(src,100.0,100.2,"OB",1,7,false,10);
   ZRE_AddCand(src,100.3,100.5,"POC",1,9,false,-1);
   ZRE_AddCand(src,100.9,101.0,"FVG",1,6,true,5);
   ZRE_AddCand(src,103.0,103.2,"VAL",1,7,false,-1);
   ZRE_AddCand(src,103.6,104.9,"OB",1,7,false,-1);     // union with VAL would be 1.9 > max_h
   ZRE_AddCand(src,105.0,105.2,"PDH",1,9,false,-1);    // union with the OB above would be 1.6 > max_h
   ZRE_AddCand(src,110.0,112.0,"OB",1,7,false,-1);     // taller than max_h on its own
   ZRE_AddCand(src,110.9,111.0,"POC",1,9,false,-1);    // contained: merges anyway
   int n=ArraySize(src);
   ArrayResize(dst,0);
   for(int i=0;i<n;i++)
   {
      int idx=(mode==0?i:(mode==1?n-1-i:(i*3+1)%n));   // n=8, gcd(3,8)=1: a permutation
      ZRE_AddCand(dst,src[idx].lo,src[idx].hi,src[idx].tokens,src[idx].units,src[idx].tier,
                  src[idx].swept,src[idx].born_bar);
   }
}

//--------------------------------------------------------------------
// Self-test of stages 2-8 (synthetic data only, style of MVP_SelfTest)
//--------------------------------------------------------------------
void ZRE_TestZone(SZREZone &z,const bool support,const double lo,const double hi,const int strength)
{
   z.id=ZRE_ZoneId(support?ZRE_SUPPORT:ZRE_RESISTANCE,lo,hi);
   z.lo=lo;
   z.hi=hi;
   z.side=(support?ZRE_SUPPORT:ZRE_RESISTANCE);
   z.strength=strength;
   z.touches=1;
   z.sources="TEST";
   z.swept=false;
   z.htf_aligned=true;
   z.age_bars=10;
   z.units=1;
   z.detail="";
   z.intrinsic=strength;      // v6.5.0: a synthetic zone carries no HTF/D1 term
   z.context=0;
}

void ZRE_TestBar(SZREBar &b,const double o,const double h,const double l,const double c)
{
   b.o=o;
   b.h=h;
   b.l=l;
   b.c=c;
}

// Builds one full signal from synthetic inputs (same chain the chart adapter runs).
bool ZRE_TestSignal(const SZREZone &z,const SZREBar &b,const double atr,const SZREEvidence &ev,const SZREParams &p,
                    const double barrier,SZRESignal &s,string &why)
{
   ZRE_SignalInit(s);
   SZRERejection rj;
   if(!ZRE_EvalRejection(z,b,atr,ev,p,rj)) { why=rj.reason; return false; }
   bool buy=(z.side==ZRE_SUPPORT);
   double entry=0.0,sl=0.0;
   if(!ZRE_ComputeEntrySL(z,b,atr,p,entry,sl,why)) return false;
   double tp1=0.0,tp2=0.0,tp3=0.0,rr1=0.0,rr2=0.0,rr3=0.0,slo=0.0,shi=0.0;
   if(!ZRE_FinalizeGeometry(buy,entry,sl,atr,barrier,0.0,0.0,0.0,p,tp1,tp2,tp3,rr1,rr2,rr3,slo,shi,why)) return false;
   double risk=MathAbs(entry-sl);
   double room=(barrier>0.0 ? MathAbs(barrier-entry)/risk : 99.0);
   string det="";
   int score=ZRE_ScoreSignal(z.strength,rj,ev,buy,room,p.min_rr1,det);
   if(score<p.min_score) { why="SCORE"; return false; }
   s.id="T";
   s.zone_id=z.id;
   s.is_buy=buy;
   s.bar_time=1000;
   s.bar_index=10;
   s.zone_lo=z.lo;
   s.zone_hi=z.hi;
   s.zone_strength=z.strength;
   s.atr=atr;
   s.entry=entry;
   s.sl=sl;
   s.tp1=tp1;
   s.tp2=tp2;
   s.tp3=tp3;
   s.stop_lo=slo;
   s.stop_hi=shi;
   s.rr1=rr1;
   s.rr2=rr2;
   s.rr3=rr3;
   s.score=score;
   s.score_detail=det;
   s.htf_aligned=(ev.htf_bias==(buy?1:-1));
   why="";
   return true;
}

void ZRE_TestSeriesHL(double &h[],double &l[],const double base)
{
   ArrayResize(h,40);
   ArrayResize(l,40);
   for(int k=0;k<40;k++)
   {
      h[k]=base+1.0;
      l[k]=base-1.0;
   }
}

void ZRE_SelfTestReaction(string &where)
{
   SZREParams p;
   ZRE_ParamsInit(p);
   double atr=2.0;
   SZREZone sup,res;
   ZRE_TestZone(sup,true,100.0,101.0,80);
   ZRE_TestZone(res,false,110.0,111.0,80);
   SZREEvidence ev;
   ZRE_EvidenceInit(ev);
   ev.volume_valid=true;
   ev.volume_ratio=1.3;
   ev.htf_bias=1;
   ev.d1_bias=1;
   ev.pd_state=1;
   ev.vwap_state=1;
   ev.ema_state=1;
   SZREBar b;
   SZRERejection rj;

   // ---- weights
   ZRE_Expect(ZRE_P_ZONE+ZRE_P_REJECT+ZRE_P_VOLUME+ZRE_P_HTF+ZRE_P_LOCATION+ZRE_P_ROOM==100,"score weights sum to 100",where);

   // ---- 1) clear tail candle (wick + sweep-and-reclaim + volume) = signal
   ZRE_TestBar(b,101.2,102.0,99.8,101.8);
   ZRE_Expect(ZRE_EvalRejection(sup,b,atr,ev,p,rj) && rj.valid,"clear tail candle confirms",where);
   ZRE_Expect(rj.touched && rj.reclaimed && rj.sweep_reclaim && rj.wick_ok && rj.volume_ok && rj.groups==3,"tail candle evidence groups",where);
   SZRESignal s1;
   string why="";
   ZRE_Expect(ZRE_TestSignal(sup,b,atr,ev,p,0.0,s1,why),"clear tail candle gives a signal: "+why,where);
   ZRE_Expect(s1.is_buy && MathAbs(s1.entry-101.8)<1e-9 && MathAbs(s1.sl-99.4)<1e-9,"entry/sl geometry",where);
   ZRE_Expect(s1.score==83,"reference score 83 (got "+IntegerToString(s1.score)+")",where);

   // ---- 2) a close inside the zone cancels it (acceptance)
   ZRE_TestBar(b,101.2,102.0,99.8,100.6);
   ZRE_Expect(!ZRE_EvalRejection(sup,b,atr,ev,p,rj) && rj.accepted,"close inside zone cancels",where);
   ZRE_TestBar(b,101.2,102.0,98.0,99.5);
   ZRE_Expect(!ZRE_EvalRejection(sup,b,atr,ev,p,rj),"close below zone cancels",where);
   SZREParams pin=p;
   pin.inside_reclaim=true;
   ZRE_TestBar(b,101.2,102.0,99.8,100.6);
   ZRE_Expect(ZRE_EvalRejection(sup,b,atr,ev,pin,rj),"inside-reclaim option accepts a close above the midpoint",where);

   // ---- 3) a wick alone is never a rejection; penetration and touch limits
   SZREEvidence weak=ev;
   weak.volume_valid=false;
   ZRE_TestBar(b,101.6,102.0,100.9,101.9);          // touches, no sweep, wick 0.64
   ZRE_Expect(!ZRE_EvalRejection(sup,b,atr,weak,p,rj) && rj.wick_ok && rj.groups==1,"wick alone is not a rejection",where);
   weak.engulf=true;
   ZRE_Expect(ZRE_EvalRejection(sup,b,atr,weak,p,rj) && rj.groups==2,"wick + engulfing is",where);
   ZRE_TestBar(b,101.2,102.0,99.0,101.8);           // 0.5 ATR through the far edge
   ZRE_Expect(!ZRE_EvalRejection(sup,b,atr,ev,p,rj) && rj.reason=="PENETRATION","too deep a penetration",where);
   ZRE_TestBar(b,102.0,102.8,101.5,102.6);
   ZRE_Expect(!ZRE_EvalRejection(sup,b,atr,ev,p,rj) && rj.reason=="NO TOUCH","no touch",where);

   // ---- 4) mirror: resistance / SELL
   ZRE_TestBar(b,109.8,111.2,108.0,109.2);          // sweep above, closes below the zone
   SZREEvidence evs=ev;
   evs.htf_bias=-1;
   evs.d1_bias=-1;
   evs.vwap_state=-1;
   evs.ema_state=-1;
   SZRESignal s2;
   ZRE_Expect(ZRE_TestSignal(res,b,atr,evs,p,0.0,s2,why),"mirrored SELL signal: "+why,where);
   ZRE_Expect(!s2.is_buy && s2.sl>s2.entry && s2.entry>s2.tp1 && s2.tp1>s2.tp2 && s2.tp2>s2.tp3,"SELL target order",where);

   // ---- 5) targets strictly ordered; barrier cap; STOP ZONE
   ZRE_Expect(s1.entry<s1.tp1 && s1.tp1<s1.tp2 && s1.tp2<s1.tp3 && s1.sl<s1.entry,"BUY target order",where);
   ZRE_Expect(s1.stop_hi==s1.tp3 && s1.stop_lo<s1.stop_hi && s1.stop_lo>s1.tp2,"stop zone sits at TP3",where);
   ZRE_TestBar(b,101.2,102.0,99.8,101.8);
   SZRESignal s3;
   ZRE_Expect(ZRE_TestSignal(sup,b,atr,ev,p,106.0,s3,why),"barrier at 106 leaves room: "+why,where);
   ZRE_Expect(s3.tp3<=106.0+1e-9 && s3.tp1<s3.tp2 && s3.tp2<s3.tp3,"targets capped by the barrier, still ordered",where);
   ZRE_Expect(s1.tp3>106.0,"uncapped TP3 is beyond the same barrier",where);

   // ---- 6) RR below the minimum = no signal
   SZRESignal s4;
   ZRE_Expect(!ZRE_TestSignal(sup,b,atr,ev,p,103.0,s4,why) && StringFind(why,"RR1")==0,"barrier too close: RR1 gate ("+why+")",where);
   SZREParams p2=p;
   p2.min_rr1=1.30;
   ZRE_Expect(!ZRE_TestSignal(sup,b,atr,ev,p2,0.0,s4,why) && StringFind(why,"RR1")==0,"RR1 1.25 < 1.30 gate",where);
   SZREParams p3=p;
   p3.min_score=95;
   ZRE_Expect(!ZRE_TestSignal(sup,b,atr,ev,p3,0.0,s4,why) && why=="SCORE","score gate",where);
   SZREParams p4=p;
   p4.max_stop_atr=1.0;
   ZRE_Expect(!ZRE_TestSignal(sup,b,atr,ev,p4,0.0,s4,why) && StringFind(why,"STOP")==0,"stop wider than the limit",where);

   // ---- 7) score bounds
   SZRERejection best;
   ZRE_RejectionInit(best);
   best.wick_ratio=0.9;
   best.engulf=true;
   best.sweep_reclaim=true;
   best.close_loc=0.95;
   SZREEvidence top;
   ZRE_EvidenceInit(top);
   top.volume_valid=true;
   top.volume_ratio=2.0;
   top.htf_bias=1;
   top.d1_bias=1;
   top.pd_state=1;
   top.vwap_state=1;
   top.ema_state=1;
   string det="";
   ZRE_Expect(ZRE_ScoreSignal(100,best,top,true,5.0,1.2,det)==100,"maximum score is 100",where);
   ZRE_Expect(StringFind(det,"probab")<0 && StringFind(det,"evidence quality")>=0,"score text wording",where);
   SZRERejection none;
   ZRE_RejectionInit(none);
   SZREEvidence bad;
   ZRE_EvidenceInit(bad);
   bad.htf_bias=-1;
   bad.d1_bias=-1;
   bad.pd_state=-1;
   bad.vwap_state=-1;
   bad.ema_state=-1;
   ZRE_Expect(ZRE_ScoreSignal(0,none,bad,true,0.0,1.2,det)==0,"minimum score is 0",where);

   // ---- 8) zone states (stateless)
   SZREZone zs;
   SZREZone zr;
   ZRE_TestZone(zs,true,100.0,101.0,80);
   ZRE_TestZone(zr,false,100.0,101.0,80);
   ZRE_Expect(ZRE_ClassifyState(zs,102.0,99.0,atr,false,false,p)==ZRE_ST_BROKEN,"close beyond by > 0.3 ATR = BROKEN",where);
   ZRE_Expect(ZRE_ClassifyState(zs,102.0,99.7,atr,false,false,p)!=ZRE_ST_BROKEN,"close within 0.3 ATR is not broken",where);
   ZRE_Expect(ZRE_ClassifyState(zs,99.0,98.5,atr,false,false,p)!=ZRE_ST_BROKEN,"a break is reported once (bar of the break only)",where);
   // v6.4.1 ZR-1: BROKEN is role-aware. A fresh crossing of the NON-role edge
   // (support closed above / resistance closed below) is not a failure: it only
   // means price left the level behind.
   ZRE_Expect(ZRE_ClassifyState(zs,100.5,102.0,atr,false,false,p)!=ZRE_ST_BROKEN,
              "v6.4.1: support closed above the band is not BROKEN",where);
   ZRE_Expect(ZRE_ClassifyState(zs,100.5,102.0,atr,false,false,p)==ZRE_ST_APPROACHING,
              "v6.4.1: that close is just distance/approaching context",where);
   ZRE_Expect(ZRE_ClassifyState(zr,100.5,99.0,atr,false,false,p)!=ZRE_ST_BROKEN,
              "v6.4.1: resistance closed below the band is not BROKEN",where);
   ZRE_Expect(ZRE_ClassifyState(zr,100.5,102.0,atr,false,false,p)==ZRE_ST_BROKEN,
              "v6.4.1: resistance closed above the band IS broken",where);
   ZRE_Expect(ZRE_ClassifyState(zs,100.5,99.0,atr,false,false,p)==ZRE_ST_BROKEN,
              "v6.4.1: support closed below the band IS broken",where);
   ZRE_Expect(ZRE_ClassifyState(zs,103.0,102.0,atr,false,false,p)==ZRE_ST_APPROACHING,"within 0.75 ATR = APPROACHING",where);
   ZRE_Expect(ZRE_ClassifyState(zs,106.0,105.0,atr,false,false,p)==ZRE_ST_IDLE,"far away = IDLE",where);
   ZRE_Expect(ZRE_ClassifyState(zs,106.0,105.0,atr,false,true,p)==ZRE_ST_TOUCHED_PREVIEW,"live touch = PREVIEW",where);
   ZRE_Expect(ZRE_ClassifyState(zs,103.0,102.0,atr,true,true,p)==ZRE_ST_REACTION_CONFIRMED,"reaction outranks preview",where);
   ZRE_Expect(ZRE_EffectiveState(ZRE_ST_REACTION_CONFIRMED,true)==ZRE_ST_REACTION_CONFIRMED &&
              ZRE_EffectiveState(ZRE_ST_APPROACHING,true)==ZRE_ST_TOUCHED_PREVIEW &&
              ZRE_EffectiveState(ZRE_ST_BROKEN,true)==ZRE_ST_BROKEN,"live touch never overrides a closed-bar fact",where);
   zs.age_bars=601;
   ZRE_Expect(ZRE_ClassifyState(zs,103.0,102.0,atr,true,true,p)==ZRE_ST_EXPIRED,"old zone = EXPIRED",where);
   zs.age_bars=-1;
   ZRE_Expect(ZRE_ClassifyState(zs,103.0,102.0,atr,false,false,p)==ZRE_ST_APPROACHING,"unknown age never expires",where);
   double cl[];
   ArrayResize(cl,10);
   for(int k=0;k<10;k++) cl[k]=105.0;
   ZRE_Expect(!ZRE_IsFlipped(zs,9,9,0.6,cl),"never broken = not flipped",where);
   cl[3]=98.0;
   ZRE_Expect(ZRE_IsFlipped(zs,9,9,0.6,cl),"earlier close below a support = flipped",where);

   // ---- 8b) v6.4.2 AUDIT: direction truth table, HELD / FLIPPED, causal role
   string w="";
   ZRE_Expect(GetSignalDirection(ZRE_SUPPORT,ZRE_ST_REACTION_CONFIRMED,101.0,100.0,101.0,w)==1,
              "support rejection -> BUY (and the reason is stated)",where);
   ZRE_Expect(GetSignalDirection(ZRE_RESISTANCE,ZRE_ST_REACTION_CONFIRMED,100.5,100.0,101.0,w)==-1,
              "resistance rejection -> SELL",where);
   ZRE_Expect(GetSignalDirection(ZRE_SUPPORT,ZRE_ST_REACTION_CONFIRMED,99.0,100.0,101.0,w)==0,
              "a close through the band is a break, never a rejection",where);
   ZRE_Expect(GetSignalDirection(ZRE_SUPPORT,ZRE_ST_BROKEN,99.0,100.0,101.0,w)==-1,
              "broken support retested from below -> SELL (break + retest)",where);
   ZRE_Expect(GetSignalDirection(ZRE_SUPPORT,ZRE_ST_BROKEN,100.5,100.0,101.0,w)==0,
              "broken support with the close inside the band -> no trade",where);
   ZRE_Expect(GetSignalDirection(ZRE_RESISTANCE,ZRE_ST_BROKEN,101.5,100.0,101.0,w)==1,
              "broken resistance retested from above -> BUY",where);
   ZRE_Expect(GetSignalDirection(ZRE_SUPPORT,ZRE_ST_FLIPPED,101.0,100.0,101.0,w)==1 &&
              GetSignalDirection(ZRE_RESISTANCE,ZRE_ST_FLIPPED,100.0,100.0,101.0,w)==-1,
              "FLIPPED trades the new role",where);
   ZRE_Expect(GetSignalDirection(ZRE_SUPPORT,ZRE_ST_EXPIRED,101.0,100.0,101.0,w)==0,
              "EXPIRED never signals",where);
   // HELD: reclaimed the level but did not accept beyond it -> a hold, not a break
   SZREZone zh;
   ZRE_TestZone(zh,true,100.0,101.0,60);
   double hh2[],ll2[],cc2[];
   ArrayResize(hh2,4); ArrayResize(ll2,4); ArrayResize(cc2,4);
   for(int k2=0;k2<4;k2++){ hh2[k2]=102.0; ll2[k2]=99.0; cc2[k2]=100.6; }
   SZREContext ctx2;
   ZRE_TestCtx(ctx2);
   SZRECand cnd2[];
   ArrayResize(cnd2,0);
   ZRE_Expect(ZRE_AddCand(cnd2,100.0,101.0,"TEST",1,5,false,2),"held candidate",where);
   SZREZone zs2[];
   ZRE_BuildZones(cnd2,ctx2,hh2,ll2,cc2,zs2);
   ZRE_Expect(ArraySize(zs2)==1 && zs2[0].touches>=1,"held zone keeps its touch episode",where);
   // causal role: a band left BEHIND below the close is RESISTANCE, not support
   SZRECand cnd3[];
   ArrayResize(cnd3,0);
   ZRE_Expect(ZRE_AddCand(cnd3,100.0,101.0,"TEST",1,5,false,1),"causal candidate",where);
   double ccl[];
   ArrayResize(ccl,4);
   ccl[0]=105.0; ccl[1]=105.5; ccl[2]=104.0; ccl[3]=103.0;   // born_bar=1 -> close 105.5 ABOVE the band
   SZREZone zc3[];
   ZRE_BuildZones(cnd3,ctx2,hh2,ll2,ccl,zc3);
   ZRE_Expect(ArraySize(zc3)==1 && zc3[0].side==ZRE_SUPPORT,
              "v6.4.2 causal role: a band UNDER the close that created it is SUPPORT",where);
   ccl[1]=99.5;                                              // born close under the band
   SZREZone zc4[];
   ZRE_BuildZones(cnd3,ctx2,hh2,ll2,ccl,zc4);
   ZRE_Expect(ArraySize(zc4)==1 && zc4[0].side==ZRE_RESISTANCE,
              "v6.4.2 causal role: a band ABOVE the close that created it is RESISTANCE",where);
   // the effective side reverses only on a genuine closed-bar break
   SZREZone zef;
   ZRE_TestZone(zef,true,100.0,101.0,60);
   ZRE_Expect(ZRE_EffectiveSide(zef,101.8,100.5,atr,p)==ZRE_RESISTANCE,
              "support broken upward reverses to resistance",where);
   ZRE_Expect(ZRE_EffectiveSide(zef,100.4,100.3,atr,p)==ZRE_SUPPORT,
              "a close inside the band reverses nothing",where);
   ZRE_Expect(ZRE_EffectiveSide(zef,100.2,100.1,atr,p)==ZRE_SUPPORT,
              "a shallow dip under support is not a break (needs break_atr*ATR)",where);

   // ---- 9) strongest-entry selection
   SZRESignal cand[];
   ArrayResize(cand,2);
   cand[0]=s1;
   cand[1]=s2;
   cand[1].id="T2";
   SZREVerdict v;
   cand[0].score=80;
   cand[1].score=60;
   ZRE_Expect(ZRE_SelectVerdict(cand,1,1,0,"",p,v) && v.kind==1 && v.score==80 && v.sig_index==0,"higher score wins",where);
   ZRE_Expect(v.label=="TOP ZONE REACTION CANDIDATE (score 80/100)" && !v.smc_confluence,"verdict label",where);
   ZRE_Expect(ZRE_SelectVerdict(cand,1,1,1,"",p,v) && v.smc_confluence,"SMC CONFLUENCE tag when the direction matches",where);
   ZRE_Expect(ZRE_SelectVerdict(cand,1,1,-1,"",p,v) && !v.smc_confluence,"no tag when the direction differs",where);
   cand[1].score=75;
   ZRE_Expect(!ZRE_SelectVerdict(cand,1,1,0,"",p,v) && v.kind==0 && StringFind(v.reason,"vs")>0,"BUY/SELL within the gap = NO TRADE",where);
   cand[1].score=72;
   ZRE_Expect(ZRE_SelectVerdict(cand,1,1,0,"",p,v) && v.kind==1,"gap of exactly 8 is decisive",where);
   ArrayResize(cand,1);
   cand[0].zone_strength=70;
   ZRE_Expect(!ZRE_SelectVerdict(cand,-1,-1,0,"",p,v) && v.kind==0,"BUY against a clear HTF+D1 bear with a weak zone = NO TRADE",where);
   cand[0].zone_strength=90;
   ZRE_Expect(ZRE_SelectVerdict(cand,-1,-1,0,"",p,v) && v.kind==1,"strong zone may trade against HTF",where);
   cand[0].zone_strength=70;
   ZRE_Expect(ZRE_SelectVerdict(cand,-1,0,0,"",p,v) && v.kind==1,"only HTF against (D1 neutral) is not a clear bias",where);
   SZRESignal e1=cand[0];
   SZRESignal e2=cand[0];
   e2.id="U";
   e2.rr1=e1.rr1+0.5;
   ZRE_Expect(ZRE_SignalBetter(e2,e1) && !ZRE_SignalBetter(e1,e2),"tie on score: higher RR1 ranks first",where);
   e2.rr1=e1.rr1;
   e2.htf_aligned=!e1.htf_aligned;
   ZRE_Expect(e1.htf_aligned && ZRE_SignalBetter(e1,e2) && !ZRE_SignalBetter(e2,e1),"tie on score and RR: HTF aligned first",where);
   ArrayResize(cand,0);
   ZRE_Expect(!ZRE_SelectVerdict(cand,0,0,0,"waiting",p,v) && v.kind==0 && v.reason=="waiting","no candidates = NO TRADE with the reason",where);
   string mini=ZRE_VerdictMini(v,2);
   ZRE_Expect(mini=="ZRE: NO TRADE (waiting)","mini text NO TRADE",where);
   ArrayResize(cand,1);
   cand[0]=s1;
   ZRE_SelectVerdict(cand,1,1,0,"",p,v);
   mini=ZRE_VerdictMini(v,2);
   ZRE_Expect(StringFind(mini,"ZRE: BUY 101.80 | score 83 | TP ")==0,"mini text BUY: "+mini,where);
   ZRE_Expect(StringFind(mini,"probab")<0 && StringFind(mini,"HIGH")<0,"mini wording",where);

   // ---- 10) outcome tracker: incremental == full replay, stop first, timeout
   double hh[],ll[];
   ZRE_TestSeriesHL(hh,ll,102.0);                   // quiet: nothing touches
   hh[12]=103.0; ll[12]=101.5;
   hh[13]=105.0; ll[13]=102.0;                      // TP1 (104.8)
   hh[14]=105.5; ll[14]=99.0;                       // stop (99.4)
   SZREOutcome oa,ob;
   ZRE_OutcomeInit(oa,s1.bar_index);
   ZRE_OutcomeInit(ob,s1.bar_index);
   for(int b2=s1.bar_index+1;b2<=20;b2++) ZRE_TrackAdvance(s1,oa,b2,16,hh,ll);   // incremental
   ZRE_TrackAdvanceTo(s1,ob,20,16,hh,ll);                                        // full replay
   ZRE_Expect(oa.end_reason==ZRE_END_SL && oa.best_target==1 && oa.sl_hit && oa.bars_to_tp1==3,"TP1 then stop",where);
   ZRE_Expect(ob.end_reason==oa.end_reason && ob.best_target==oa.best_target && ob.bars_to_tp1==oa.bars_to_tp1 &&
              ob.bars_to_end==oa.bars_to_end && MathAbs(ob.mfe_r-oa.mfe_r)<1e-12 && MathAbs(ob.mae_r-oa.mae_r)<1e-12,
              "incremental and full replay give the same outcome",where);
   SZREOutcome oi;
   ZRE_OutcomeInit(oi,s1.bar_index);
   ZRE_TrackAdvance(s1,oi,12,16,hh,ll);
   ZRE_TrackAdvance(s1,oi,12,16,hh,ll);
   ZRE_TrackAdvance(s1,oi,11,16,hh,ll);
   ZRE_Expect(oi.last_bar==12 && oi.end_reason==ZRE_END_OPEN,"advance ignores bars already folded in",where);
   ZRE_TestSeriesHL(hh,ll,102.0);
   hh[11]=105.0; ll[11]=99.0;                       // one bar touches both: stop counts first
   SZREOutcome oc;
   ZRE_OutcomeInit(oc,s1.bar_index);
   ZRE_TrackAdvanceTo(s1,oc,20,16,hh,ll);
   ZRE_Expect(oc.end_reason==ZRE_END_SL && oc.best_target==0,"stop and target in one bar: stop first",where);
   ZRE_TestSeriesHL(hh,ll,102.0);
   SZREOutcome od;
   ZRE_OutcomeInit(od,s1.bar_index);
   ZRE_TrackAdvanceTo(s1,od,30,5,hh,ll);
   ZRE_Expect(od.end_reason==ZRE_END_TIMEOUT && od.bars_to_end==5,"timeout after project_bars",where);
   ZRE_TestSeriesHL(hh,ll,102.0);
   hh[12]=110.0;
   SZREOutcome oe;
   ZRE_OutcomeInit(oe,s1.bar_index);
   ZRE_TrackAdvanceTo(s1,oe,20,16,hh,ll);
   ZRE_Expect(oe.end_reason==ZRE_END_TP3 && oe.best_target==3 && !oe.sl_hit,"TP3 reached",where);
   SZRESignal ss=s1;
   ss.is_buy=false;
   ss.entry=101.8; ss.sl=104.2; ss.tp1=98.8; ss.tp2=96.8; ss.tp3=93.8;
   ZRE_TestSeriesHL(hh,ll,102.0);
   ll[12]=98.0;
   SZREOutcome of;
   ZRE_OutcomeInit(of,ss.bar_index);
   ZRE_TrackAdvanceTo(ss,of,30,16,hh,ll);
   ZRE_Expect(of.best_target==1 && of.end_reason==ZRE_END_TIMEOUT && of.mfe_r>1.0,"SELL tracker",where);

   // ---- 11) statistics gating
   SZREOutcome os[];
   ArrayResize(os,10);
   for(int k=0;k<10;k++)
   {
      ZRE_OutcomeInit(os[k],0);
      os[k].end_reason=(k<9?ZRE_END_TP3:ZRE_END_OPEN);
      os[k].best_target=(k<9?3:0);
   }
   SZREStats st;
   ZRE_ComputeStats(os,30,st);
   ZRE_Expect(st.resolved==9 && st.open==1 && !st.sufficient,"9 resolved + 1 censored < 30",where);
   string stx=ZRE_StatsText(st,30);
   ZRE_Expect(StringFind(stx,"n=9")>=0 && StringFind(stx,"withheld")>=0 && StringFind(stx,"%")<0,"no frequency before the sample minimum",where);
   ArrayResize(os,40);
   for(int k=10;k<40;k++)
   {
      ZRE_OutcomeInit(os[k],0);
      os[k].end_reason=(k%2==0?ZRE_END_SL:ZRE_END_TP3);
      os[k].best_target=(k%2==0?0:3);
   }
   ZRE_ComputeStats(os,30,st);
   stx=ZRE_StatsText(st,30);
   ZRE_Expect(st.sufficient && st.resolved==39 && st.open==1 && StringFind(stx,"n=39")>=0 && StringFind(stx,"TP1")>=0 &&
              StringFind(stx,"probab")<0,"frequencies appear at the sample minimum with n shown",where);
}

bool ZRE_SelfTest()
{
   string where="";

   // A) token union is sorted, unique and order independent
   ZRE_Expect(ZRE_TokenUnion("PDH+OB","FVG+OB")=="FVG+OB+PDH","token union",where);
   ZRE_Expect(ZRE_TokenUnion("","POC")=="POC" && ZRE_TokenUnion("","")=="","token empty",where);

   // B) side by position versus the closed-bar close
   ZRE_Expect(ZRE_SideFor(100.0,101.0,102.0)==ZRE_SUPPORT,"side support",where);
   ZRE_Expect(ZRE_SideFor(103.0,104.0,102.0)==ZRE_RESISTANCE,"side resistance",where);
   ZRE_Expect(ZRE_SideFor(101.5,102.5,102.2)==ZRE_SUPPORT,"side inside upper half",where);
   ZRE_Expect(ZRE_SideFor(101.5,102.5,101.8)==ZRE_RESISTANCE,"side inside lower half",where);

   // C) merge: tolerance, height cap, containment
   SZREContext ctx;
   ZRE_TestCtx(ctx);
   SZRECand mg[];
   ZRE_TestFill(mg,0);
   int nm=ZRE_Consolidate(mg,ctx.tol,ctx.max_h);
   ZRE_Expect(nm==5,"merge count",where);
   if(nm==5)
   {
      ZRE_Expect(mg[0].tokens=="FVG+OB+POC" && mg[0].units==3 && mg[0].tier==9 && mg[0].swept &&
                 mg[0].born_bar==5 && mg[0].lo==100.0 && mg[0].hi==101.0,"merge fields",where);
      ZRE_Expect(mg[4].tokens=="OB+POC" && mg[4].lo==110.0 && mg[4].hi==112.0,"contained merge",where);
   }

   // D) exact score, touch windowing, closed-bar exclusion
   double h[],l[],ccls[];
   ZRE_TestSeries(h,l);   // cc[] stays empty -> born_bar<0 -> legacy price rule (same expectations)   // ccls[] stays empty -> born_bar<0 -> legacy price rule (same expectations)
   SZREZone z[];
   SZRECand one[];
   ZRE_AddCand(one,100.0,101.0,"OB+PDH",3,9,true,-1);
   ZRE_BuildZones(one,ctx,h,l,ccls,z);
   ZRE_Expect(ArraySize(z)==1,"score zone count",where);
   if(ArraySize(z)==1)
   {
      // touches 2 -> 15, units 3 -> 17, tier 9, swept 10, HTF 14, D1 6, fresh(unknown) 10
      ZRE_Expect(z[0].strength==81,"score exact 81",where);
      ZRE_Expect(z[0].touches==2,"touch episodes",where);
      ZRE_Expect(z[0].side==ZRE_SUPPORT && z[0].htf_aligned && z[0].age_bars==-1,"score fields",where);
   }
   ZRE_TestCtx(ctx);
   ctx.htf_bias=-1;
   ctx.d1_bias=-1;
   ArrayResize(one,0);
   ZRE_AddCand(one,100.0,101.0,"OB+PDH",3,9,true,-1);
   ZRE_BuildZones(one,ctx,h,l,ccls,z);
   ZRE_Expect(ArraySize(z)==1 && z[0].strength==61 && !z[0].htf_aligned,"score against HTF",where);
   ctx.min_score=62;
   ArrayResize(one,0);
   ZRE_AddCand(one,100.0,101.0,"OB+PDH",3,9,true,-1);
   ZRE_BuildZones(one,ctx,h,l,ccls,z);
   ZRE_Expect(ArraySize(z)==0,"min score filter",where);
   ZRE_TestCtx(ctx);
   ArrayResize(one,0);
   ZRE_AddCand(one,100.0,101.0,"OB+PDH",3,9,true,49);
   ZRE_BuildZones(one,ctx,h,l,ccls,z);
   ZRE_Expect(ArraySize(z)==1 && z[0].age_bars==10 && z[0].touches==0 && z[0].strength==76,
              "born window",where);

   // E) ranking + cap
   SZRECand rk[];
   ZRE_AddCand(rk,120.0,121.0,"POC+FVG",2,7,false,-1);   // resistance vs bullish bias
   ZRE_AddCand(rk,90.0,91.0,"VAL",1,5,false,-1);
   ZRE_AddCand(rk,100.0,101.0,"OB+PDH",3,9,true,-1);
   ctx.max_zones=2;
   ZRE_BuildZones(rk,ctx,h,l,ccls,z);
   ZRE_Expect(ArraySize(z)==2 && z[0].strength==81 && z[1].strength==41 &&
              z[1].sources=="VAL","rank and cap",where);

   // F) deterministic: same zones for any input order (full vs incremental)
   ctx.max_zones=6;
   SZRECand pa[],pb[],pc[];
   SZREZone za[],zb[],zc[];
   ZRE_TestFill(pa,0);
   ZRE_TestFill(pb,1);
   ZRE_TestFill(pc,2);
   ZRE_BuildZones(pa,ctx,h,l,ccls,za);
   ZRE_BuildZones(pb,ctx,h,l,ccls,zb);
   ZRE_BuildZones(pc,ctx,h,l,ccls,zc);
   ZRE_Expect(ArraySize(za)>0 && ZRE_SameZones(za,zb) && ZRE_SameZones(za,zc),"order independence",where);
   for(int i=0;i<ArraySize(za);i++)
      for(int j=i+1;j<ArraySize(za);j++)
         ZRE_Expect(za[i].id!=za[j].id,"unique ids",where);

   // G) documented weight table
   ZRE_Expect(ZRE_W_TOUCH+ZRE_W_CONF_COUNT+ZRE_W_CONF_TIER+ZRE_W_SWEPT+ZRE_W_HTF+ZRE_W_D1+ZRE_W_FRESH==100,
              "weights sum to 100",where);
   ZRE_Expect(ZRE_TouchPts(0)==0 && ZRE_TouchPts(1)==10 && ZRE_TouchPts(2)==15 &&
              ZRE_TouchPts(3)==20 && ZRE_TouchPts(9)==20,"touch points",where);
   ZRE_Expect(ZRE_CountPts(0)==6 && ZRE_CountPts(1)==6 && ZRE_CountPts(2)==13 &&
              ZRE_CountPts(3)==17 && ZRE_CountPts(4)==20 && ZRE_CountPts(9)==20,"source count points",where);
   ZRE_Expect(ZRE_FreshPts(-1,96)==10 && ZRE_FreshPts(0,96)==20 && ZRE_FreshPts(96,96)==20 &&
              ZRE_FreshPts(97,96)==14 && ZRE_FreshPts(192,96)==14 && ZRE_FreshPts(193,96)==8 &&
              ZRE_FreshPts(384,96)==8 && ZRE_FreshPts(385,96)==3,"freshness points",where);
   ZRE_Expect(ZRE_BiasPts(1,ZRE_SUPPORT,14,6)==14 && ZRE_BiasPts(-1,ZRE_SUPPORT,14,6)==0 &&
              ZRE_BiasPts(0,ZRE_SUPPORT,14,6)==6 && ZRE_BiasPts(-1,ZRE_RESISTANCE,14,6)==14 &&
              ZRE_BiasPts(1,ZRE_RESISTANCE,14,6)==0,"bias points",where);

   ZRE_SelfTestReaction(where);

   if(where!="")
   {
      Print(">>> ",QSMC_VERSION_TEXT," ZRE self-test FAIL @ ",where);
      return false;
   }
   return true;
}

//====================================================================
// ZRE_ADAPTERS_BEGIN - chart-state code (reads g_buf_*, g_quant, engine
// state; draws objects). Not executed by tools/zre_mql_harness.py, which
// only runs the pure core above. Read-only with respect to every setup.
//====================================================================
void ZRE_ParamsFromInputs(SZREParams &p)
{
   ZRE_ParamsInit(p);
   p.approach_atr=MathMax(0.0,InpZREApproachATR);
   p.break_atr=MathMax(0.0,InpZREBreakATR);
   p.expire_bars=(int)MathMax(10,InpZREExpireBars);
   p.max_pen_atr=MathMax(0.0,InpZREMaxPenetrationATR);
   p.min_wick=MathMax(0.0,MathMin(0.95,InpZREMinWick));
   p.inside_reclaim=InpZREInsideReclaim;
   p.min_evidence=(int)MathMax(1,MathMin(5,InpZREMinEvidence));
   p.vol_support=MathMax(0.0,InpZREVolSupportRatio);
   p.min_score=(int)MathMax(0,MathMin(100,InpZREMinScore));
   p.entry_mode=(int)InpZREEntryMode;
   p.project_bars=(int)MathMax(3,MathMin(200,InpZREProjectBars));
   p.stop_zone_atr=MathMax(0.05,InpZREStopZoneATR);
   p.conflict_gap=MathMax(0.0,InpZREConflictGap);
   p.fresh_entry_bars=(int)MathMax(0,InpZREFreshEntryBars);
   p.weak_zone=(int)MathMax(0,MathMin(100,InpZREWeakZoneScore));
   p.min_rr1=MathMax(0.0,InpMinRR1);
   p.sl_buf_atr=MathMax(0.0,InpSLBufferATR);
   p.max_stop_atr=MathMax(0.1,InpMaxStopATR);
   double tk=InstrumentTickSize();
   p.tick=(tk>0.0 ? tk : _Point);
   p.min_sample=(int)MathMax(1,InpMinHistoricalSampleSize);
}

// Read-only tag source: direction of the setup owned by the entry engine.
// Display tag only; ZRE never writes to, creates, or invalidates a setup.
int ZRE_SmcDirection()
{
   if(InpUseRetestLifecycle)
   {
      if(g_active_setup.active && g_active_setup.state!=STATE_INVALIDATED)
         return (g_active_setup.is_buy ? 1 : -1);
   }
   else if(g_trade_setup.valid)
      return (g_trade_setup.is_buy ? 1 : -1);
   return 0;
}

void ZRE_BuildEvidence(SZREEvidence &e,const bool buy,const SCandleIntelligence &ci,const SZREBar &b,const int closed)
{
   ZRE_EvidenceInit(e);
   bool up=(b.c>b.o);
   bool dn=(b.c<b.o);
   if(ci.valid)
   {
      e.engulf=(ci.is_engulfing && (buy ? up : dn));
      e.displacement=(ci.is_displacement && (buy ? (up && ci.close_location>=0.75)
                                                 : (dn && ci.close_location<=0.25)));
   }
   e.htf_bias=g_htf_bias;
   e.d1_bias=(g_d1_structure_state=="BULLISH" ? 1 : (g_d1_structure_state=="BEARISH" ? -1 : 0));
   if(g_quant.computed && g_quant.closed_bar==closed)
   {
      e.volume_valid=true;
      e.volume_ratio=g_quant.volume_ratio;
      e.vwap_state=g_quant.vwap_state;
      e.ema_state=g_quant.ema_state;
      if(g_quant.pd_position=="DISCOUNT")      e.pd_state=(buy ? 1 : -1);
      else if(g_quant.pd_position=="PREMIUM")  e.pd_state=(buy ? -1 : 1);
   }
}

// Full signal chain for a confirmed rejection: entry/SL, targets from the
// engine's own target finder, the fixed opposing barrier, RR gate, score gate.
bool ZRE_TryBuildSignal(const SZREZone &z,const int closed,const double atr,const SZREBar &b,
                        const SZRERejection &rj,const SZREEvidence &ev,const SZREParams &p,
                        SZRESignal &s,string &why)
{
   ZRE_SignalInit(s);
   bool buy=(z.side==ZRE_SUPPORT);
   double entry=0.0,sl=0.0;
   if(!ZRE_ComputeEntrySL(z,b,atr,p,entry,sl,why)) return false;

   string btype="",bev="";
   int bbar=-1;
   double barrier=NearestOpposingBarrier(entry,buy,btype,bev,bbar);
   double min_dist=MathMax(atr*0.50,InstrumentMinStopDistance());
   string ty="",ev1="",ev2="",ev3="";
   int sb1=-1,sb2=-1,sb3=-1;
   bool c1=false,c2=false,c3=false,bb1=false,bb2=false,bb3=false;
   double raw1=FindInstitutionalTarget(entry,entry,sl,buy,min_dist,p.min_rr1,1,barrier,ty,ev1,sb1,c1,bb1);
   double raw2=(raw1>0.0 ? FindInstitutionalTarget(raw1,entry,sl,buy,min_dist,p.min_rr1,2,barrier,ty,ev2,sb2,c2,bb2) : 0.0);
   double raw3=(raw2>0.0 ? FindInstitutionalTarget(raw2,entry,sl,buy,min_dist,p.min_rr1,3,barrier,ty,ev3,sb3,c3,bb3) : 0.0);

   double tp1=0.0,tp2=0.0,tp3=0.0,rr1=0.0,rr2=0.0,rr3=0.0,slo=0.0,shi=0.0;
   if(!ZRE_FinalizeGeometry(buy,entry,sl,atr,barrier,raw1,raw2,raw3,p,tp1,tp2,tp3,rr1,rr2,rr3,slo,shi,why))
      return false;

   // nearest obstacle ahead: the fixed barrier or an opposing ZRE zone
   double risk=MathAbs(entry-sl);
   double obstacle=0.0;
   if(barrier>0.0 && ((buy && barrier>entry) || (!buy && barrier<entry))) obstacle=barrier;
   for(int i=0;i<ArraySize(g_zre_zones);i++)
   {
      if(g_zre_zones[i].side==z.side) continue;
      double edge=(buy ? g_zre_zones[i].lo : g_zre_zones[i].hi);
      bool ahead=(buy ? edge>entry : edge<entry);
      if(!ahead) continue;
      if(obstacle<=0.0 || MathAbs(edge-entry)<MathAbs(obstacle-entry)) obstacle=edge;
   }
   double room=(obstacle>0.0 ? MathAbs(obstacle-entry)/risk : 99.0);
   string det="";
   int score=ZRE_ScoreSignal(z.strength,rj,ev,buy,room,p.min_rr1,det);
   if(score<p.min_score) SigLog_ZREScoreReject(z,closed,buy,entry,sl,tp1,tp2,tp3,atr,score); // SHADOW row (log only)
   if(score<p.min_score) { why=StringFormat("score %d < %d",score,p.min_score); return false; }

   s.id="ZRE|"+(buy?"B":"S")+"|"+IntegerToString((long)g_buf_t[closed])+"|"+z.id;
   s.zone_id=z.id;
   s.is_buy=buy;
   s.bar_time=g_buf_t[closed];
   s.bar_index=closed;
   s.zone_lo=z.lo;
   s.zone_hi=z.hi;
   s.zone_strength=z.strength;
   s.zone_sources=z.sources;
   s.atr=atr;
   s.entry=entry;
   s.sl=sl;
   s.tp1=tp1;
   s.tp2=tp2;
   s.tp3=tp3;
   s.stop_lo=slo;
   s.stop_hi=shi;
   s.rr1=rr1;
   s.rr2=rr2;
   s.rr3=rr3;
   s.score=score;
   s.score_detail=det;
   s.htf_aligned=(ev.htf_bias==(buy?1:-1));
   why="";
   return true;
}

void ZRE_RemoveSignal(const int idx)
{
   int n=ArraySize(g_zre_sig);
   if(idx<0 || idx>=n) return;
   for(int i=idx;i<n-1;i++)
   {
      g_zre_sig[i]=g_zre_sig[i+1];
      g_zre_out[i]=g_zre_out[i+1];
   }
   ArrayResize(g_zre_sig,n-1);
   ArrayResize(g_zre_out,n-1);
}

// One confirmed signal per (bar, direction); the log is capped.
bool ZRE_AddSignal(const SZRESignal &s)
{
   int n=ArraySize(g_zre_sig);
   for(int i=0;i<n;i++)
      if(g_zre_sig[i].bar_time==s.bar_time && g_zre_sig[i].is_buy==s.is_buy) return false;
   if(n>=ZRE_MAX_SIGNALS)
   {
      // v6.5.0 (audit BUG-12): `drop` used to be initialised to 0, so when EVERY
      // row was still open the loop never assigned and the OLDEST OPEN signal was
      // evicted silently - losing live evidence and corrupting the censored count
      // in ZRE_StatsText. Eviction is now explicit, deterministic and counted.
      int drop=-1;
      for(int i=0;i<n;i++)
         if(g_zre_out[i].end_reason!=ZRE_END_OPEN) { drop=i; break; }
      bool open_eviction=(drop<0);
      if(drop<0) drop=0;                    // all rows open: evict the oldest
      if(drop>=0 && drop<n)
      {
         ZRE_RemoveSignal(drop);
         g_gate_audit.zre_evicted++;
         if(open_eviction && InpZREDebugLog)
            Print("[ZRE] signal log full of OPEN rows; evicted the oldest (",drop,")");
      }
      n=ArraySize(g_zre_sig);
   }
   ArrayResize(g_zre_sig,n+1);
   ArrayResize(g_zre_out,n+1);
   g_zre_sig[n]=s;
   ZRE_OutcomeInit(g_zre_out[n],s.bar_index);
   return true;
}

// Fold every closed bar since the last call into each open outcome.
void ZRE_AdvanceAll(const int closed,const SZREParams &p)
{
   for(int i=0;i<ArraySize(g_zre_sig);i++)
   {
      if(g_zre_out[i].end_reason!=ZRE_END_OPEN) continue;
      int bi=g_zre_sig[i].bar_index;
      if(bi<0 || bi>=ArraySize(g_buf_t) || g_buf_t[bi]!=g_zre_sig[i].bar_time)
      {
         g_zre_out[i].end_reason=ZRE_END_STALE;   // history changed under the signal
         continue;
      }
      ZRE_TrackAdvanceTo(g_zre_sig[i],g_zre_out[i],closed,p.project_bars,g_buf_h,g_buf_l);
      if(g_zre_out[i].end_reason!=ZRE_END_OPEN && g_zre_out[i].end_time==0)
         g_zre_out[i].end_time=g_buf_t[MathMin(closed,ArraySize(g_buf_t)-1)];
   }
}

bool ZRE_FireAlert(const string event_id,const string message)
{
   if(event_id=="") return false;
   for(int i=0;i<ZRE_ALERT_RING;i++)
      if(g_zre_alert_ring[i]==event_id) return false;
   g_zre_alert_ring[g_zre_alert_pos]=event_id;
   g_zre_alert_pos=(g_zre_alert_pos+1)%ZRE_ALERT_RING;
   bool sent=false;
   if(InpZREAlertPopup)
      sent=FireQuantAlert(event_id,message);
   if(InpZREAlertPush)
   {
      string m=message;
      if(StringLen(m)>240) m=StringSubstr(m,0,240);
      SendNotification(m);
      sent=true;
   }
   if(InpZREAlertSound)
   {
      PlaySound("alert.wav");
      sent=true;
   }
   return sent;
}

string ZRE_ZoneText(const SZREZone &z)
{
   return (z.side==ZRE_SUPPORT ? "SUPPORT " : "RESISTANCE ")+DoubleToString(z.lo,_Digits)+"-"+
          DoubleToString(z.hi,_Digits)+" (strength "+IntegerToString(z.strength)+"/100)";
}

// One alert per (zone, state, bar): the id is deterministic.
void ZRE_AlertState(const SZREZone &z,const ENUM_ZRE_STATE state,const datetime bar_time,const string extra)
{
   if(z.strength<InpZREAlertMinStrength) return;
   if(state==ZRE_ST_APPROACHING && !InpZREAlertApproaching) return;
   if(state!=ZRE_ST_APPROACHING && state!=ZRE_ST_TOUCHED_PREVIEW &&
      state!=ZRE_ST_REACTION_CONFIRMED && state!=ZRE_ST_BROKEN) return;
   string tag=(state==ZRE_ST_TOUCHED_PREVIEW ?
               "ZONE REACTION / NON-AUTHORITATIVE LIVE PREVIEW" :
               "ZONE REACTION / NON-AUTHORITATIVE (closed-bar context)");
   string id=z.id+"|"+IntegerToString((int)state)+"|"+IntegerToString((long)bar_time);
   string msg=tag+" "+_Symbol+" "+TFName((ENUM_TIMEFRAMES)_Period)+": "+ZRE_ZoneText(z)+" - "+
              ZRE_StateName(state)+(extra!="" ? " | "+extra : "");
   ZRE_FireAlert(id,msg);
}

void ZRE_RefreshVerdict(const int closed,const SZREParams &p)
{
   SZRESignal cands[];
   for(int i=0;i<ArraySize(g_zre_sig);i++)
   {
      if(g_zre_out[i].end_reason!=ZRE_END_OPEN) continue;
      if(g_zre_out[i].best_target>=1) continue;
      if(closed-g_zre_sig[i].bar_index>p.fresh_entry_bars) continue;
      int n=ArraySize(cands);
      ArrayResize(cands,n+1);
      cands[n]=g_zre_sig[i];
   }
   int d1=(g_d1_structure_state=="BULLISH" ? 1 : (g_d1_structure_state=="BEARISH" ? -1 : 0));
   ZRE_SelectVerdict(cands,g_htf_bias,d1,ZRE_SmcDirection(),g_zre_idle_note,p,g_zre_verdict);
}

//--------------------------------------------------------------------
// Drawing. Everything lives under PFX+"ZRE_"; text goes through
// DrawTextLabel so ResolveChartLabelCollisions keeps it readable.
//--------------------------------------------------------------------
void ZRE_DeleteObjects()
{
   ObjectsDeleteAll(0,PFX+"ZRE_");
   g_zre_preview_sig="";
   g_zre_path_first_obj="";
   g_zre_draw_count=0;
}

void ZRE_Arrow(const string name,const datetime t1,const double p1,const datetime t2,const double p2,
               const color col,const int style,const int width)
{
   if(ObjectFind(0,name)<0)
      ObjectCreate(0,name,OBJ_ARROWED_LINE,0,t1,p1,t2,p2);
   ObjectSetInteger(0,name,OBJPROP_COLOR,col);
   ObjectSetInteger(0,name,OBJPROP_STYLE,style);
   ObjectSetInteger(0,name,OBJPROP_WIDTH,width);
   ObjectSetInteger(0,name,OBJPROP_BACK,false);
   ObjectSetInteger(0,name,OBJPROP_SELECTABLE,false);
   ObjectSetInteger(0,name,OBJPROP_HIDDEN,true);
}

void ZRE_DrawOnePath(const SZRESignal &s,const SZREOutcome &o,const bool best,const bool smc,const SZREParams &p)
{
   if(s.bar_index<0 || s.bar_index>=ArraySize(g_buf_t)) return;
   int sec=PeriodSeconds();
   if(sec<=0) sec=60;
   int pb=p.project_bars;
   datetime t0=s.bar_time;
   datetime tend=t0+(datetime)((long)pb*sec);
   datetime x1=t0+(datetime)((long)MathMax(1,pb/3)*sec);
   datetime x2=t0+(datetime)((long)MathMax(2,(2*pb)/3)*sec);
   string base=PFX+"ZRE_P_"+(s.is_buy?"B":"S")+IntegerToString((long)s.bar_time)+"_";
   color main_col=(s.is_buy ? clrLimeGreen : clrTomato);
   color sl_col=clrTomato;
   color tp_col=clrDodgerBlue;
   int dg=_Digits;

   // reaction zone
   if(!InpUltraCleanMode)
   {
      int zb=(int)MathMax(0,s.bar_index-10);
      DrawZoneBox(base+"ZONE",g_buf_t[zb],s.zone_hi,t0,s.zone_lo,main_col,"",84);
      ObjectSetString(0,base+"ZONE",OBJPROP_TOOLTIP,"ZRE reaction zone "+DoubleToString(s.zone_lo,dg)+"-"+
                      DoubleToString(s.zone_hi,dg)+" | strength "+IntegerToString(s.zone_strength)+"/100 | "+s.zone_sources);
   }
   // levels
   DrawFibLine(base+"ENT",t0,tend,s.entry,clrWhite,STYLE_SOLID,1);
   DrawFibLine(base+"SL",t0,tend,s.sl,sl_col,STYLE_DASH,1);
   DrawFibLine(base+"TP1",t0,tend,s.tp1,tp_col,STYLE_DOT,1);
   DrawFibLine(base+"TP2",t0,tend,s.tp2,tp_col,STYLE_DOT,1);
   DrawFibLine(base+"TP3",t0,tend,s.tp3,tp_col,STYLE_SOLID,1);
   // projected path: entry -> TP1 -> TP2 -> TP3, and entry -> SL
   if(!InpUltraCleanMode)
   {
      ZRE_Arrow(base+"A1",t0,s.entry,x1,s.tp1,main_col,STYLE_SOLID,2);
      ZRE_Arrow(base+"A2",x1,s.tp1,x2,s.tp2,main_col,STYLE_SOLID,2);
      ZRE_Arrow(base+"A3",x2,s.tp2,tend,s.tp3,main_col,STYLE_SOLID,2);
      ZRE_Arrow(base+"ASL",t0,s.entry,x1,s.sl,sl_col,STYLE_DASH,1);
      DrawZoneBox(base+"STOP",x2,s.stop_hi,tend,s.stop_lo,clrGold,"",80);
      ObjectSetString(0,base+"STOP",OBJPROP_TOOLTIP,"STOP ZONE (TP3) "+DoubleToString(s.stop_lo,dg)+"-"+
                      DoubleToString(s.stop_hi,dg)+" | projected, not a forecast");
   }
   // labels
   string dir=(s.is_buy ? "BUY" : "SELL");
   string head="ZONE REACTION / NON-AUTHORITATIVE | "+dir+" CANDIDATE "+
               DoubleToString(s.entry,dg)+" | evidence "+IntegerToString(s.score)+"/100";
   if(best) head+=" | TOP ZRE CANDIDATE";
   if(best && smc) head+=" | SMC CONFLUENCE";
   DrawTextLabel(base+"L_ENT",t0,s.entry,head,main_col,s.is_buy,8);
   ObjectSetString(0,base+"L_ENT",OBJPROP_TOOLTIP,
                   s.score_detail+"\nClosed-bar zone-reaction candidate only. Projection, not forecast; not the authoritative Layer A signal.");
   DrawTextLabel(base+"L_SL",x1,s.sl,"SL "+DoubleToString(s.sl,dg),sl_col,!s.is_buy,8);
   DrawTextLabel(base+"L_TP1",x1,s.tp1,"TP1 "+DoubleToString(s.tp1,dg)+" (RR "+DoubleToString(s.rr1,2)+")"+
                 (o.best_target>=1?" reached":""),tp_col,s.is_buy,8);
   if(!InpUltraCleanMode)
      DrawTextLabel(base+"L_TP2",x2,s.tp2,"TP2 "+DoubleToString(s.tp2,dg)+" (RR "+DoubleToString(s.rr2,2)+")"+
                    (o.best_target>=2?" reached":""),tp_col,s.is_buy,8);
   DrawTextLabel(base+"L_TP3",tend,s.tp3,"STOP ZONE / TP3 "+DoubleToString(s.tp3,dg)+" (RR "+DoubleToString(s.rr3,2)+")",
                 clrGold,s.is_buy,8);
   if(g_zre_path_first_obj=="") g_zre_path_first_obj=base+"ENT";
}

// Draws the newest ZRE_MAX_PATHS unresolved projections (oldest is dropped
// first when a fourth appears). Called on a closed bar or when objects vanish.
void ZRE_DrawPaths()
{
   ObjectsDeleteAll(0,PFX+"ZRE_P_");
   g_zre_path_first_obj="";
   g_zre_draw_count=0;
   if(!InpUseZRE || !InpZREShowPath) return;
   SZREParams p;
   ZRE_ParamsFromInputs(p);
   int idx[ZRE_MAX_PATHS];
   int cnt=0;
   for(int i=ArraySize(g_zre_sig)-1;i>=0 && cnt<ZRE_MAX_PATHS;i--)
   {
      if(g_zre_out[i].end_reason!=ZRE_END_OPEN) continue;
      idx[cnt]=i;
      cnt++;
   }
   int smc=ZRE_SmcDirection();
   for(int k=cnt-1;k>=0;k--)                 // oldest first, newest on top
   {
      int i=idx[k];
      bool best=(g_zre_verdict.kind!=0 && g_zre_verdict.sig_id==g_zre_sig[i].id);
      bool tag=(smc==(g_zre_sig[i].is_buy?1:-1));
      ZRE_DrawOnePath(g_zre_sig[i],g_zre_out[i],best,tag,p);
      g_zre_draw_count++;
   }
   if(cnt>0) ResolveChartLabelCollisions();
}

void ZRE_DrawPreview(const int best,const datetime live_time)
{
   string name=PFX+"ZRE_PV_LBL";
   if(!InpUseZRE || !InpZREShowPreview || best<0 || best>=ArraySize(g_zre_zones))
   {
      if(ObjectFind(0,name)>=0) ObjectDelete(0,name);
      g_zre_preview_sig="";
      return;
   }
   string sig=g_zre_zones[best].id+"|"+IntegerToString((long)live_time);
   if(sig==g_zre_preview_sig && ObjectFind(0,name)>=0) return;
   g_zre_preview_sig=sig;
   bool sup=(g_zre_zones[best].side==ZRE_SUPPORT);
   string txt="ZONE REACTION / NON-AUTHORITATIVE | LIVE PREVIEW (unconfirmed): live candle in "+
              ZRE_ZoneText(g_zre_zones[best])+" - wait for the close";
   DrawTextLabel(name,live_time,(sup?g_zre_zones[best].hi:g_zre_zones[best].lo),txt,clrAqua,!sup,8);
   ObjectSetString(0,name,OBJPROP_TOOLTIP,
                   "Layer D live-candle preview only; non-authoritative. Nothing is confirmed until the bar closes.\n"+
                   g_zre_zones[best].detail);
   ResolveChartLabelCollisions();
}

// Live candle: only ever adds TOUCHED_PREVIEW on top of the closed-bar state.
void ZRE_ProcessLive(const int rates_total)
{
   int nz=ArraySize(g_zre_zones);
   if(nz<=0 || ArraySize(g_zre_status)!=nz)
   {
      if(g_zre_preview_sig!="") ZRE_DrawPreview(-1,0);
      return;
   }
   int live=rates_total-1;
   int closed=rates_total-2;
   if(closed<1 || live>=ArraySize(g_buf_h) || live>=ArraySize(g_buf_l) || live>=ArraySize(g_buf_t) ||
      live>=ArraySize(g_buf_c))
      return;
   double hh=g_buf_h[live];
   double ll=g_buf_l[live];
   datetime lt=g_buf_t[live];
   int best=-1;
   for(int i=0;i<nz;i++)
   {
      bool touch=(hh>=g_zre_zones[i].lo && ll<=g_zre_zones[i].hi);
      g_zre_status[i].live_touch=touch;
      ENUM_ZRE_STATE eff=ZRE_EffectiveState(g_zre_status[i].base_state,touch);
      if(eff!=g_zre_status[i].state)
      {
         g_zre_status[i].state=eff;
         // an arrival alert: the previous close was still outside the zone
         if(eff==ZRE_ST_TOUCHED_PREVIEW && ZRE_ZoneGap(g_zre_zones[i],g_buf_c[closed])>0.0)
            ZRE_AlertState(g_zre_zones[i],eff,lt,"live candle - wait for the close");
      }
      if(g_zre_status[i].state==ZRE_ST_TOUCHED_PREVIEW &&
         (best<0 || g_zre_zones[i].strength>g_zre_zones[best].strength))
         best=i;
   }
   ZRE_DrawPreview(best,lt);
}

// Closed bar: advance outcomes, classify zones, confirm rejections, build and
// register signals, alert, pick the strongest entry, redraw.
void ZRE_ProcessClosedBar(const int rates_total,const int closed,const double atr,const SZREContext &ctx)
{
   SZREParams p;
   ZRE_ParamsFromInputs(p);
   ZRE_AdvanceAll(closed,p);

   SZREBar bar;
   bar.o=g_buf_o[closed];
   bar.h=g_buf_h[closed];
   bar.l=g_buf_l[closed];
   bar.c=g_buf_c[closed];
   double prev_close=(closed>=1 ? g_buf_c[closed-1] : bar.c);
   SCandleIntelligence ci;
   ci.valid=false;
   ci.is_displacement=false;
   ci.is_engulfing=false;
   ci.close_location=0.5;
   if(closed>=3)
      ci=AnalyzeCandleIntelligence(closed,g_buf_o,g_buf_h,g_buf_l,g_buf_c,g_buf_tv,g_buf_rv,atr);

   int nz=ArraySize(g_zre_zones);
   ArrayResize(g_zre_status,nz);
   SZRESignal cand_buy,cand_sell;
   bool has_buy=false,has_sell=false;
   string fail_note="";
   for(int i=0;i<nz;i++)
   {
      SZREZone z=g_zre_zones[i];
      // v6.4.2: the rejection is judged against the EFFECTIVE role (causal role,
      // reversed only by a closed-bar break) so a support that broke downward is
      // now read as resistance instead of still asking for a bullish reclaim.
      SZREZone zeff=z;
      zeff.side=ZRE_EffectiveSide(z,bar.c,prev_close,atr,p);
      bool buy=(zeff.side==ZRE_SUPPORT);
      SZREZoneStatus st;
      ZRE_StatusInit(st);
      SZREEvidence ev;
      ZRE_BuildEvidence(ev,buy,ci,bar,closed);
      SZRERejection rj;
      bool ok=ZRE_EvalRejection(zeff,bar,atr,ev,p,rj);
      st.reaction=ok;
      st.dist_atr=ZRE_ZoneGap(z,bar.c)/atr;
      st.flipped=ZRE_IsFlipped(z,closed,ctx.hist,p.break_atr*atr,g_buf_c);
      st.base_state=ZRE_ClassifyState(z,prev_close,bar.c,atr,ok,false,p);
      // v6.4.2 AUDIT-Z3: HELD / FLIPPED. A reclaimed touch that is not strong
      // enough for a signal is a HOLD (never "BROKEN"); a level broken on an
      // earlier bar whose role has since reversed is FLIPPED.
      if(st.base_state!=ZRE_ST_EXPIRED && st.base_state!=ZRE_ST_BROKEN &&
         st.base_state!=ZRE_ST_REACTION_CONFIRMED && rj.touched && rj.reclaimed &&
         !rj.accepted) st.base_state=ZRE_ST_HELD;
      // v6.5.0 (audit BUG-07): FLIPPED is a statement about the zone's ROLE, a
      // reaction is a statement about an EVENT. Writing the role over the event
      // made a retest-and-reject of a broken level - one of the highest quality
      // SMC entries there is - display as a bare role change with no reaction.
      // The role is already carried separately in st.flipped, so the event state
      // is now preserved and the two facts no longer overwrite each other.
      if(zeff.side!=z.side && !ZRE_IsBrokenNow(z,prev_close,bar.c,atr,p) &&
         st.base_state!=ZRE_ST_REACTION_CONFIRMED)
         st.base_state=ZRE_ST_FLIPPED;
      st.state=st.base_state;
      st.note=(ok ? "" : rj.reason);
      string dir_why="";
      // v6.4.2: one call, and its RETURN value is the direction - no second
      // "role implies X" formula that could drift away from the truth function.
      int want_dir=GetSignalDirection(zeff.side,st.base_state,bar.c,z.lo,z.hi,dir_why);
      if(ok)
      {
         SZRESignal s;
         string why="";
         // v6.4.2: single source of truth - the trade direction is the role's
         // direction (SUPPORT->BUY, RESISTANCE->SELL) and a state that GetSignalDirection
         // refuses (broken level without a far-side retest, close through the band)
         // produces no signal at all.
         if(want_dir!=((buy)?1:-1))
         {
            ok=false; st.reaction=false; st.note="direction veto: "+dir_why;
            if(InpDebugLog)
               DebugLogSignal("ZRE","direction-veto",want_dir,z.lo,z.hi,0.0,0.0,
                              (zeff.side==ZRE_SUPPORT?"SUPPORT":"RESISTANCE"),ZRE_StateName(st.base_state),
                              bar.o,bar.h,bar.l,bar.c,DoubleToString(rj.wick_ratio,2),dir_why);
         }
         if(ok && InpProximityFilter)
         {
            double wall=NearestOpposingEdgeATR(buy,bar.c,atr);
            if(wall>=0.0 && wall<InpProximityMaxATR)
            {
               ok=false; st.reaction=false;
               st.note=StringFormat("proximity veto: %.2f ATR to the opposing %s",wall,(buy?"resistance":"support"));
               if(InpDebugLog)
                  DebugLogSignal("ZRE","proximity-veto",want_dir,z.lo,z.hi,0.0,0.0,
                                 (zeff.side==ZRE_SUPPORT?"SUPPORT":"RESISTANCE"),ZRE_StateName(st.base_state),
                                 bar.o,bar.h,bar.l,bar.c,DoubleToString(rj.wick_ratio,2),st.note);
            }
         }
         // v6.5.0 (audit BUG-06): st.base_state was classified above with the
         // PRE-veto value of `ok`, so a zone whose reaction the engine had just
         // refused still read REACTION CONFIRMED on the panel and still fired a
         // confirmation alert from the loop below. Reclassify with the post-veto
         // fact so the displayed state, the alert and the decision agree.
         if(!ok && st.base_state==ZRE_ST_REACTION_CONFIRMED)
         {
            st.base_state=ZRE_ClassifyState(z,prev_close,bar.c,atr,false,false,p);
            if(st.base_state!=ZRE_ST_EXPIRED && st.base_state!=ZRE_ST_BROKEN &&
               rj.touched && rj.reclaimed && !rj.accepted) st.base_state=ZRE_ST_HELD;
            if(zeff.side!=z.side && !ZRE_IsBrokenNow(z,prev_close,bar.c,atr,p))
               st.base_state=ZRE_ST_FLIPPED;
            st.state=st.base_state;
         }
         if(ok && ZRE_TryBuildSignal(zeff,closed,atr,bar,rj,ev,p,s,why))
         {
            st.note="signal score "+IntegerToString(s.score);
            if(InpDebugLog)
               DebugLogSignal("ZRE","signal",want_dir,z.lo,z.hi,s.entry,s.sl,
                              (zeff.side==ZRE_SUPPORT?"SUPPORT":"RESISTANCE"),ZRE_StateName(st.base_state),
                              bar.o,bar.h,bar.l,bar.c,DoubleToString(rj.wick_ratio,2),
                              StringFormat("RR %.2f | score %d | %s",s.rr1,s.score,dir_why));
            if(buy)
            {
               if(!has_buy || ZRE_SignalBetter(s,cand_buy)) { cand_buy=s; has_buy=true; }
            }
            else
            {
               if(!has_sell || ZRE_SignalBetter(s,cand_sell)) { cand_sell=s; has_sell=true; }
            }
         }
         else
         {
            st.note="no signal: "+why;
            if(fail_note==""){ fail_note=why; g_gate_audit.zre_rejected++; }   // once per closed bar
         }
      }
      g_zre_status[i]=st;
   }
   if(has_buy)  { if(ZRE_AddSignal(cand_buy))  { g_gate_audit.zre_signals++; MarkZREEntry(cand_buy);  } }   // v6.4.1: mark only a NEW signal
   if(has_sell) { if(ZRE_AddSignal(cand_sell)) { g_gate_audit.zre_signals++; MarkZREEntry(cand_sell); } }   // (the duplicated legacy add is gone)

   // idle reason shown when nothing is selectable
   g_zre_idle_note="";
   if(fail_note!="") g_zre_idle_note="reaction but no signal: "+fail_note;
   else
   {
      int near_i=-1;
      for(int i=0;i<nz;i++)
         if(g_zre_status[i].base_state==ZRE_ST_APPROACHING &&
            (near_i<0 || g_zre_status[i].dist_atr<g_zre_status[near_i].dist_atr)) near_i=i;
      if(near_i>=0) g_zre_idle_note="watching zone "+DoubleToString((g_zre_zones[near_i].lo+g_zre_zones[near_i].hi)*0.5,_Digits);
      else g_zre_idle_note="no zone reaction";
   }

   // closed-bar alerts (deterministic ids: zone + state + bar)
   for(int i=0;i<nz;i++)
   {
      ENUM_ZRE_STATE bs=g_zre_status[i].base_state;
      if(bs==ZRE_ST_REACTION_CONFIRMED)
         ZRE_AlertState(g_zre_zones[i],bs,g_buf_t[closed],g_zre_status[i].note+" | score = evidence quality");
      else if(bs==ZRE_ST_BROKEN || bs==ZRE_ST_APPROACHING)
         ZRE_AlertState(g_zre_zones[i],bs,g_buf_t[closed],
                        (bs==ZRE_ST_BROKEN ? "closed beyond the ROLE edge (support: below the low / resistance: above the high)"
                                           : ""));
   }

   ZRE_ComputeStats(g_zre_out,p.min_sample,g_zre_stats);
   ZRE_RefreshVerdict(closed,p);
   ZRE_DrawPaths();
}

void ZRE_CollectCandidates(SZRECand &out[],const int closed,const double atr)
{
   ArrayResize(out,0);
   double pad=ZRE_CfgPadATR()*atr;
   bool conf_on=InpShowConfluentSR;

   // 1) g_confluent_sr: already clustered by BuildConfluentSRLevels.
   for(int i=0;i<ArraySize(g_confluent_sr);i++)
   {
      double px=g_confluent_sr[i].price;
      int tier=(int)MathRound(g_confluent_sr[i].base_score/5.2);
      int units=(g_confluent_sr[i].source_count>1?g_confluent_sr[i].source_count:1);
      ZRE_AddCand(out,px-pad,px+pad,ZRE_CleanToken(g_confluent_sr[i].source),units,tier,g_confluent_sr[i].swept,-1);
   }

   // 2) Order blocks: causal (structure that made it is closed) and not mitigated.
   for(int i=0;i<ArraySize(g_order_blocks);i++)
   {
      if(g_order_blocks[i].state=="MITIGATED" || g_order_blocks[i].closed_state=="MITIGATED") continue;
      if(g_order_blocks[i].origin_struct_bar<0 || g_order_blocks[i].origin_struct_bar>closed) continue;
      if(g_order_blocks[i].bar<0 || g_order_blocks[i].bar>closed) continue;
      if(!(g_order_blocks[i].top>g_order_blocks[i].bottom)) continue;
      int tier=3+g_order_blocks[i].strength;
      if(tier>9) tier=9;
      ZRE_AddCand(out,g_order_blocks[i].bottom,g_order_blocks[i].top,"OB",(conf_on?0:1),tier,false,
                  g_order_blocks[i].bar);
   }

   // 3) FVG: available on a closed bar and not filled.
   for(int i=0;i<ArraySize(g_fvgs);i++)
   {
      if(g_fvgs[i].filled || g_fvgs[i].state=="FILLED") continue;
      if(g_fvgs[i].state=="PARTIAL" && !InpAllowPartialFVG) continue;
      if(g_fvgs[i].availability_bar<0 || g_fvgs[i].availability_bar>closed) continue;
      if(!(g_fvgs[i].top>g_fvgs[i].bottom)) continue;
      ZRE_AddCand(out,g_fvgs[i].bottom,g_fvgs[i].top,"FVG",1,6,false,g_fvgs[i].availability_bar);
   }

   // 4) Master Volume Profile: active profile, only when built on this closed bar.
   if(InpUseMasterVolumeProfile && g_mvp_active>=0 && g_mvp_active<g_mvp_count &&
      g_mvp[g_mvp_active].valid && g_mvp_built_time==g_buf_t[closed])
   {
      int a=g_mvp_active;
      ZRE_AddCand(out,g_mvp[a].poc-pad,g_mvp[a].poc+pad,"POC",1,9,false,-1);
      ZRE_AddCand(out,g_mvp[a].vah-pad,g_mvp[a].vah+pad,"VAH",1,7,false,-1);
      ZRE_AddCand(out,g_mvp[a].val-pad,g_mvp[a].val+pad,"VAL",1,7,false,-1);
      for(int k=0;k<g_mvp[a].hvn_n && k<MVP_MAX_NODES;k++)
         ZRE_AddCand(out,g_mvp[a].hvn_px[k]-pad,g_mvp[a].hvn_px[k]+pad,"HVN",1,6,false,-1);
   }

   // 5) Prior closed D1/W1 extremes (same shift-1 convention as the S/R layer).
   bool pd_cov=(conf_on && InpShowPDHPDL);
   if(D1HistoryAvailable())
   {
      double pdh=iHigh(_Symbol,PERIOD_D1,1);
      double pdl=iLow(_Symbol,PERIOD_D1,1);
      if(pdh>0.0) ZRE_AddCand(out,pdh-pad,pdh+pad,"PDH",(pd_cov?0:1),9,false,-1);
      if(pdl>0.0) ZRE_AddCand(out,pdl-pad,pdl+pad,"PDL",(pd_cov?0:1),9,false,-1);
   }
   double pwh=iHigh(_Symbol,PERIOD_W1,1);
   double pwl=iLow(_Symbol,PERIOD_W1,1);
   if(pwh>0.0) ZRE_AddCand(out,pwh-pad,pwh+pad,"PWH",(conf_on?0:1),10,false,-1);
   if(pwl>0.0) ZRE_AddCand(out,pwl-pad,pwl+pad,"PWL",(conf_on?0:1),10,false,-1);
}

void ZRE_FillContext(SZREContext &ctx,const int closed,const double atr)
{
   ZRE_ContextInit(ctx);
   ctx.closed=closed;
   ctx.atr=atr;
   ctx.tol=ConfluentSRMergeTolerance();
   ctx.touch_tol=atr*0.10;
   ctx.max_h=ZRE_CfgMaxZoneATR()*atr;
   ctx.close_px=g_buf_c[closed];
   ctx.hist=(int)MathMax(60,MathMin(300,InpLiquidityLookback*2));
   ctx.fresh_bars=ZRE_CfgFreshBars();
   ctx.htf_bias=g_htf_bias;
   ctx.d1_bias=(g_d1_structure_state=="BULLISH"?1:(g_d1_structure_state=="BEARISH"?-1:0));
   ctx.min_score=ZRE_CfgMinZoneScore();
   ctx.max_zones=ZRE_CfgMaxZones();
}

void ZRE_Clear()
{
   ZRE_DeleteObjects();
   ArrayResize(g_zre_zones,0);
   ArrayResize(g_zre_status,0);
   ArrayResize(g_zre_sig,0);
   ArrayResize(g_zre_out,0);
   ZRE_VerdictInit(g_zre_verdict);
   ZRE_ComputeStats(g_zre_out,(int)MathMax(1,InpMinHistoricalSampleSize),g_zre_stats);
   for(int i=0;i<ZRE_ALERT_RING;i++) g_zre_alert_ring[i]="";
   g_zre_alert_pos=0;
   g_zre_idle_note="";
   g_zre_built_time=0;
   g_zre_cand_count=0;
}

// Chart resize / scroll / zoom: labels are re-resolved; objects that were
// deleted by a dynamic redraw are redrawn from the log (no recomputation).
void ZRE_OnChartChange()
{
   if(!InpUseZRE) return;
   bool need=false;
   if(g_zre_path_first_obj!="" && ObjectFind(0,g_zre_path_first_obj)<0) need=true;
   if(need) ZRE_DrawPaths();
   else if(g_zre_draw_count>0 || g_zre_preview_sig!="") ResolveChartLabelCollisions();
}

// Closed-bar work once per bar (or when the causal state was rebuilt); the
// live candle is evaluated cheaply on every call and only redraws on change.
void ZRE_Update(const int rates_total,const bool force_rebuild)
{
   if(!InpUseZRE)
   {
      if(g_zre_built_time!=0) ZRE_Clear();
      return;
   }
   if(MQLInfoInteger(MQL_OPTIMIZATION)!=0) return;
   if(rates_total<3) return;
   if(ArraySize(g_buf_h)<rates_total || ArraySize(g_buf_l)<rates_total ||
      ArraySize(g_buf_c)<rates_total || ArraySize(g_buf_o)<rates_total ||
      ArraySize(g_buf_t)<rates_total)
      return;
   int closed=rates_total-2;
   if(closed<1) return;
   datetime bar_time=g_buf_t[closed];
   if(force_rebuild || g_zre_built_time!=bar_time)
   {
      double atr=g_atr;
      if(!MathIsValidNumber(atr) || !(atr>0.0))
      {
         ArrayResize(g_zre_zones,0);
         ArrayResize(g_zre_status,0);
         g_zre_cand_count=0;
         g_zre_built_time=bar_time;
         return;
      }
      SZREContext ctx;
      ZRE_FillContext(ctx,closed,atr);
      SZRECand cands[];
      ZRE_CollectCandidates(cands,closed,atr);
      g_zre_cand_count=ArraySize(cands);
      // v6.5.0: the SAME build, but the zones rejected only by the min-score
      // filter and the ones truncated by the render cap are kept aside for the
      // Reaction Signal Layer (audit BUG-10 / BUG-11). `g_zre_zones` itself is
      // byte-identical to what ZRE_BuildZones has always produced.
      SZREZone zre_dropped[];
      SZREZone zre_tail[];
      ZRE_BuildZonesEx(cands,ctx,g_buf_h,g_buf_l,g_buf_c,g_zre_zones,zre_dropped,zre_tail);
      int nd=ArraySize(zre_dropped);
      int nt=ArraySize(zre_tail);
      ArrayResize(g_rxn_extra_zones,nd+nt);
      for(int i=0;i<nd;i++) g_rxn_extra_zones[i]=zre_dropped[i];
      for(int i=0;i<nt;i++) g_rxn_extra_zones[nd+i]=zre_tail[i];
      g_zre_built_time=bar_time;
      ZRE_ProcessClosedBar(rates_total,closed,atr,ctx);

      if(InpZREDebugLog)
      {
         Print("[ZRE] ",_Symbol," ",TFName((ENUM_TIMEFRAMES)_Period)," closed ",
               TimeToString(bar_time,TIME_DATE|TIME_MINUTES)," | candidates ",g_zre_cand_count,
               " -> zones ",ArraySize(g_zre_zones)," | signals ",ArraySize(g_zre_sig),
               " | verdict ",ZRE_VerdictMini(g_zre_verdict,_Digits));
         for(int i=0;i<ArraySize(g_zre_zones);i++)
            Print("[ZRE]  ",(g_zre_zones[i].side==ZRE_SUPPORT?"SUPPORT   ":"RESISTANCE"),"  ",
                  DoubleToString(g_zre_zones[i].lo,_Digits),"-",DoubleToString(g_zre_zones[i].hi,_Digits),
                  " strength ",g_zre_zones[i].strength," touches ",g_zre_zones[i].touches,
                  " age ",g_zre_zones[i].age_bars," ",ZRE_StateName(g_zre_status[i].base_state),
                  (g_zre_status[i].flipped?" (flipped)":"")," | ",g_zre_zones[i].sources);
      }
   }
   ZRE_ProcessLive(rates_total);
   // a dynamic redraw elsewhere may have removed the projection objects
   if(g_zre_draw_count>0 && g_zre_path_first_obj!="" && ObjectFind(0,g_zre_path_first_obj)<0)
      ZRE_DrawPaths();
}

//--------------------------------------------------------------------
// Dashboard text (no new panel: lines are appended to the existing one)
//--------------------------------------------------------------------
void ZRE_DashMini(string &L[],color &C[],bool &H[],int &ln)
{
   if(!InpUseZRE) return;
   color col=clrSilver;
   if(g_zre_verdict.kind>0) col=clrLime;
   else if(g_zre_verdict.kind<0) col=clrTomato;
   DashLine(L,C,H,ln,"ZONE REACTION / NON-AUTHORITATIVE | "+
            ZRE_VerdictMini(g_zre_verdict,_Digits)+
            (g_zre_verdict.kind!=0 && g_zre_verdict.smc_confluence?" +SMC":""),col,false);
}

void ZRE_DashFull(string &L[],color &C[],bool &H[],int &ln)
{
   if(!InpUseZRE) return;
   DashLine(L,C,H,ln,"- ZONE REACTION / NON-AUTHORITATIVE -",clrDarkSlateGray,true);
   if(g_zre_verdict.kind!=0)
   {
      string dir=(g_zre_verdict.kind>0?"BUY":"SELL");
      color col=(g_zre_verdict.kind>0?clrLime:clrTomato);
      DashLine(L,C,H,ln,"  NON-AUTHORITATIVE | "+g_zre_verdict.label+" "+dir+
               (g_zre_verdict.smc_confluence?"  | SMC CONFLUENCE":""),col,false);
      DashLine(L,C,H,ln,StringFormat("  Entry %s  SL %s  RR1 %.2f",DoubleToString(g_zre_verdict.entry,_Digits),
               DoubleToString(g_zre_verdict.sl,_Digits),g_zre_verdict.rr1),clrWhite,false);
      DashLine(L,C,H,ln,StringFormat("  TP1 %s  TP2 %s  STOP ZONE %s",DoubleToString(g_zre_verdict.tp1,_Digits),
               DoubleToString(g_zre_verdict.tp2,_Digits),DoubleToString(g_zre_verdict.tp3,_Digits)),clrLimeGreen,false);
   }
   else
      DashLine(L,C,H,ln,"  NO TRADE: "+ZRE_Clip(g_zre_verdict.reason,52),clrSilver,false);
   int shown=0;
   for(int i=0;i<ArraySize(g_zre_zones) && i<ArraySize(g_zre_status) && shown<3;i++)
   {
      ENUM_ZRE_STATE st=g_zre_status[i].state;
      if(st==ZRE_ST_IDLE) continue;
      string sd=(g_zre_zones[i].side==ZRE_SUPPORT ? "S " : "R ");
      DashLine(L,C,H,ln,"  "+sd+DoubleToString((g_zre_zones[i].lo+g_zre_zones[i].hi)*0.5,_Digits)+
               " ("+IntegerToString(g_zre_zones[i].strength)+") "+ZRE_Clip(ZRE_StateName(st),26)+
               (g_zre_status[i].flipped?" flipped":""),(st==ZRE_ST_REACTION_CONFIRMED?clrLime:clrDarkGray),false);
      shown++;
   }
   DashLine(L,C,H,ln,"  "+ZRE_Clip(ZRE_StatsText(g_zre_stats,(int)MathMax(1,InpMinHistoricalSampleSize)),74),clrDarkGray,false);
   DashLine(L,C,H,ln,"  score = evidence quality, closed-bar, not a forecast",clrDimGray,false);
}
//====================================================================
// ZRE_ADAPTERS_END
//====================================================================

//===== v6.5.0 REACTION SIGNAL LAYER (RXN) ================================
// CLASSIFICATION ONLY. RXN never creates, mutates, invalidates, confirms or
// authorizes a setup, and contains no trading function of any kind.
//
// WHY (audit: docs/KLJ_V6.5.0_REACTION_LAYER_AUDIT.md sections 5 and 21):
// ZRE detects a closed-bar zone rejection correctly, but the only object it can
// publish is gated on full execution geometry (RR1 >= InpMinRR1 at :25376 and
// score >= InpZREMinScore at :26341). When either fails, no SZRESignal exists,
// MarkZREEntry is never called, and a valid market reaction leaves NO trace on
// the chart. CalculateAITradeSetup reads no ZRE state at all, so the reaction
// cannot reach the authoritative lane either. On the audit's XAUUSD news-rally
// scenario the measured reaction score is 50-60 against a gate of 65, with a
// ceiling of 75, because a counter-trend zone is charged for opposing HTF/D1
// twice and because the displacement evidence group is arithmetically
// unreachable on the rejection bar itself.
//
// WHAT THIS LAYER ADDS - and deliberately what it does NOT:
//   + a level vocabulary: WATCH / REACTION / STRONG REACTION / CONFIRMED /
//     EXECUTION READY, so a reaction can be shown before a retest exists
//   + a causal phase machine R0..R9 / B0..B9 (one enum, mirrored by side)
//   + liquidity evidence from the EXISTING master (g_liquidity via the existing
//     sorted index) - no second sweep detector
//   + WINDOWED displacement: searched on bars AFTER the rejection, reusing
//     AnalyzeCandleIntelligence per bar - no eighth displacement definition
//   + structure consequence from the EXISTING g_structures / causal graph
//   + a volatility-regime adaptation that reuses g_quant.vol_class
//   + explicit suppression diagnostics for every candidate not promoted
//   - NO change to any existing threshold (audit section 23.1)
//   - NO relaxation of any Layer A gate
//   - NO duplicate zone / rejection / liquidity / structure engine
//
// DETERMINISM: RXN keeps no latched state between bars. Each closed bar it
// recomputes the whole track over a bounded window of closed bars, so it is a
// pure function of (bar history, currently-available facts, params). A full
// chronological rebuild therefore reproduces the incremental result exactly.
//
// CAUSALITY: every fact consumed carries availability_time <= decision_time,
// where decision_time is the open of the bar after the last closed bar. The
// forming bar can set a PREVIEW flag and can never promote a level.
//==========================================================================

//--------------------------------------------------------------------
// Initialisers. No ZeroMemory on any struct that holds a string (the same rule
// the ZRE harness enforces): every field is assigned explicitly.
//--------------------------------------------------------------------
void RXN_LiqInit(SRxnLiquidity &q)
{
   q.apply=(int)RXN_LIQ_NONE;
   q.pool_type="";
   q.pool_price=0.0;
   q.pool_bar=-1;
   q.pool_time=0;
   q.pool_priority=0;
   q.pool_available=false;
   q.swept=false;
   q.sweep_bar=-1;
   q.sweep_time=0;
   q.sweep_availability=0;
   q.sweep_depth_atr=0.0;
   q.sweep_quality=0;
   q.pool_id="";
   q.sweep_id="";
}

void RXN_DispInit(SRxnDisplacement &d)
{
   d.detected=false;
   d.bar=-1;
   d.time=0;
   d.body_atr=0.0;
   d.range_atr=0.0;
   d.body_range_ratio=0.0;
   d.close_location=0.5;
   d.consecutive=0;
   d.expansion=false;
   d.fvg_created=false;
   d.leg_validated=false;
   d.consequence=false;
   d.quality=0;
   d.points=0;
   d.detail="";
}

