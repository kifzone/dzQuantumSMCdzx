long g_perf_td_us=0;    // TOP-DOWN engine: EMA of evaluation time (microseconds)
long g_perf_calc_us=0;  // OnCalculate body: EMA of tick processing time (microseconds)
int g_judas = 0, g_judas_bar = 0;
