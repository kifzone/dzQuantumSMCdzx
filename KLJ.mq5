string   g_entry_last_key="";         // v6.4.1 dedup key of the newest CONFIRMED core signal
bool     g_entry_last_late=false;     // v6.4.1 chase verdict for that signal
string g_blacklist_zone_type[]; // "BUY"/"SELL"
double g_blacklist_zone_center[];

//====================================================================
// v5.8.0 QUANTITATIVE INSTITUTIONAL ENGINE — STATE
// Everything below is DERIVED, closed-bar, deterministic state.
// It never mutates the causal architecture and never gates entry.
//====================================================================
long  g_buf_rv[];                 // real volume mirror of g_buf_tv (chronological)
int   h_ema_quant=INVALID_HANDLE; // EMA Slow on InpQuantEMATF (only when != chart TF)

// Effective (validated/clamped) configuration. Inputs are read-only in
// MQL5, so unsafe values fall back to safe defaults with a warning.
struct SQuantConfig
{
   bool   enabled;
   int    atr_baseline_bars;
   int    atr_percentile_bars;
   double atr_low_ratio;
   double atr_high_ratio;
   double atr_extreme_ratio;
   int    volume_avg_bars;
   double volume_spike_ratio;
   int    ema_slope_bars;
   double ema_slope_flat_atr;
   double late_entry_max_atr;
   double scale0_pct;
   double scale1_pct;
   double scale2_pct;
   double tp1_exit_pct;
   double tp2_exit_pct;
   double tp3_exit_pct;
   double quality_high;
   double quality_aplus;
   double risk_ref_volume;
   bool   valid;
};
SQuantConfig g_qcfg;

// Quantitative feature set (Phase 2). Closed-bar values only.
struct SQuantFeatures
{
   bool   computed;
   int    closed_bar;
   datetime decision_time;
   // volatility
   double atr;
   double atr_baseline;
   double atr_ratio;
   int    atr_percentile;      // 0..100 rank of ATR within window
   ENUM_VOL_CLASS vol_class;
   // last closed candle
   double body_atr;            // |close-open|/ATR
   double range_atr;           // (high-low)/ATR
   double wick_body_ratio;     // max wick / body (0 when body ~ 0)
   double close_location;      // 0..1
   // volume
   double volume_ratio;        // last closed volume / baseline
   bool   volume_spike;
   string volume_source;       // "TICK VOLUME" | "REAL VOLUME"
   // VWAP
   int    vwap_state;          // +1 above, -1 below, 0 at value, 2 unavailable
   double vwap_dist_atr;
   double vwap_value;
   // EMA slow
   int    ema_state;           // +1 price above, -1 below, 0 at EMA, 2 unavailable
   int    ema_slope_state;     // +1 rising, -1 falling, 0 flat, 2 unavailable
   double ema_slope_atr;       // per-bar slope normalized by ATR
   double ema_dist_atr;
   double ema_mtf_value;       // closed-HTF EMA mapped to this decision bar
   int    ema_mtf_state;       // +1/-1/0/2 (2 = unavailable)
   bool   ema_mtf_used;        // true when an HTF (> chart) TF is mapped
   string ema_mtf_label;       // e.g. "H1" or "CHART"
   // context alignment (VWAP + EMA + slope)
   string context_alignment;   // STRONG_BULLISH_CONTEXT / BULLISH_CONTEXT / ...
   // causal quality classifications (from the selected/active causal chain)
   ENUM_DISP_QUALITY  displacement_quality;
   ENUM_SWEEP_QUALITY sweep_quality;
   double sweep_depth_atr;     // penetration depth of the selected sweep
   double break_dist_atr;      // close beyond broken structure, ATR-normalized
   double zone_size_atr;       // selected zone height / ATR
   int    zone_age_bars;       // bars since zone origin
   int    zone_mitigations;    // touches recorded on the zone
   string retest_quality;      // CONFIRMED / PREVIEW / WAITING / NONE
   // premium / discount
   string pd_position;         // DISCOUNT / EQUILIBRIUM / PREMIUM / UNKNOWN
   // session
   string session_label;       // ASIA / LONDON / NEW YORK / OVERLAP / OFF
   bool   in_kill_zone;
   // HTF alignment
   bool   htf_aligned;         // chart direction agrees with HTF bias
   // geometry
   double tp1_dist_atr;
   double opposing_liq_dist_atr;
   // spread
   long   spread_points;
   double spread_atr;
   string spread_class;        // NORMAL / ELEVATED / HIGH / UNAVAILABLE
   // regime
   string regime;              // deterministic classifier label
   string regime_detail;
};
SQuantFeatures g_quant;

// Entry quality overlay (Phases 20-23). HARD-GATE MIRROR + soft scores.
struct SQuantQuality
{
   // hard gates (mirrored read-only from the authoritative architecture)
   bool   gate_causal_chain;
   bool   gate_structure_event;
   bool   gate_causal_zone;
   bool   gate_retest_lifecycle;
   bool   gate_close_confirmed;
   bool   gate_not_invalidated;
   bool   gate_target_geometry;
   bool   gate_executable_context;   // spread/blacklist/location mirror
   int    gates_passed;
   // soft scores (transparent, documented weights)
   double structural;   // 0..100
   double context;      // 0..10
   double execution;    // 0..10
   double geometry;     // 0..10
   double final_blend;  // 0..100
   string quality_class;// NO_SETUP/WATCH/LOW_QUALITY/MEDIUM_QUALITY/HIGH_QUALITY/A_PLUS_SETUP
   string entry_state;  // Phase 38 vocabulary
   bool   late_entry_risk;
   string primary_label;   // PRIMARY SETUP description
   string secondary_label; // SECONDARY/WATCH description
};
