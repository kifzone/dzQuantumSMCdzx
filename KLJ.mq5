ENUM_TIMEFRAMES g_mtf_entry_tf=PERIOD_M5;
string g_last_mtf_entry_id="";
//--- v6.4.1 SIGNAL VISIBILITY: dedup store + tactical state
string   g_entry_keys[];            // dedup keys of every CONFIRMED signal this attach
