//--------------------------------------------------------------------
// SIGNAL GATE AUDIT (diagnostic only; never influences a decision).
// The Layer-A chain is a sequence of hard gates, and the dashboard used
// to report only the LAST one ("no causally valid structure anchor").
// These attach-session counters expose how far candidates actually get:
//   anchors -> type_ok -> path_ok -> location_ok -> geometry_ok ->
//   score_ok -> armed -> confirmed, plus a rejection histogram naming the
//   dominant blocker.  Histogram entries are counted PER EVALUATION (the
//   chain helpers are called for every candidate structure), so they are
//   relative weights, not per-bar counts.
//--------------------------------------------------------------------
#define MAX_GATE_REASONS 16
struct SSignalGateAudit
{
   long   bars;            // closed bars processed this attachment
   long   anchors;         // structure breaks evaluated as anchors
   long   type_ok;         // gate 1: accepted break type (MSS by default)
   long   path_ok;         // gates 2-4: sweep -> displacement -> bound zone
   long   location_ok;     // gate 5: discount/premium vs dealing-range EQ
   long   geometry_ok;     // gate 6: stop distance + target geometry + RR1
   long   score_ok;        // gate 7: confidence / grade / reliability
   long   armed;           // gate 8: setup seeded (ARMED, awaiting retest)
   long   confirmed;       // gate 9: CONFIRMED entry signal
   long   invalidated;     // pre-confirmation invalidations
   long   expired;         // retest timeouts
   long   marks;           // v6.4.1: entry marks actually painted (display layer audit)
   long   core_marks;      // v6.4.1: entry marks painted by the CORE trade-setup path
   long   zre_signals;     // v6.4.1: ZRE signals accepted (new bar+side) this attachment
   long   zre_marks;       // v6.4.1: ...of those, the ones the display layer painted
   long   zre_rejected;    // v6.4.1: ZRE reactions that produced no signal
   long   zre_evicted;     // v6.5.0: ZRE log rows evicted when the ring was full (BUG-12)
   // v6.5.0 Reaction Signal Layer counters. Diagnostics only; they never
   // influence a decision. They exist so "why did nothing happen?" is answerable
   // from the panel instead of from the source.
   long   rxn_zones;             // zones the reaction layer evaluated
   long   rxn_recovered;         // ...of those, recovered after ZRE's min-score drop
   long   rxn_watch;             // candidates that reached LEVEL 1 WATCH
   long   rxn_reaction;          // candidates that reached LEVEL 2 REACTION
   long   rxn_strong;            // candidates that reached LEVEL 3 STRONG REACTION
   long   rxn_confirmed;         // candidates that reached LEVEL 4 CONFIRMED
   long   rxn_exec_ready;        // ...of those, mirrored as EXECUTION READY by the core
   long   rxn_promotions;        // armed setups released by a confirmed opposite reaction
   long   rxn_blocked_ownership; // core evaluations that returned on setup ownership
   string reason[MAX_GATE_REASONS];
   long   reason_hits[MAX_GATE_REASONS];
   int    reason_n;
};
SSignalGateAudit g_gate_audit;
// Dashboard diagnostic state (recomputed each closed bar; display only)
string g_directional_watch_text="";
color  g_directional_watch_color=clrDarkGray;
string g_causal_chain_text="";
color  g_causal_chain_color=clrDarkGray;
string g_decision_state="WAIT";      // WAIT | BUY_WATCH | SELL_WATCH | EARLY | CONFIRMED
int g_ob_price_idx[];
int g_ob_strength_idx[];
int g_liq_priority_idx[];
//--- MTF panel (MN/W1/D1/H4/H1): bias per TF from CLOSED HTF candles only
#define MTF_TF_COUNT 5
int      g_mtf_aligned[MTF_TF_COUNT];     // +1 bull, -1 bear, 0 unknown
int      g_mtf_self_index=-1;             // row matching chart TF (if any)
datetime g_mtf_event_time[MTF_TF_COUNT];  // last confirmed HTF structure event
datetime g_mtf_avail_time[MTF_TF_COUNT];  // when that event became known
string   g_mtf_note[MTF_TF_COUNT];        // "EMA200 x" style note per row
int      g_mtf_panel_tick=0;              // per-tick fetch throttle for the panel
//--- blacklist for terminal setups
string g_setup_blacklist[];
datetime g_blacklist_time[];

//====================================================================
// v6.3.0 ZONE REACTION ENGINE (ZRE) - types
// Observational only. See the ZRE section at the end of the file.
//====================================================================
#define ZRE_MAX_CAND        256   // hard cap on raw zone candidates per rebuild
#define ZRE_HARD_MAX_ZONES  12    // hard cap on published zones
// ZONE STRENGTH weights (sum = 100). Evidence quality, not a win rate.
#define ZRE_W_TOUCH         20    // prior touch episodes (0/1/2/3+ -> 0/10/15/20)
#define ZRE_W_CONF_COUNT    20    // independent sources (1/2/3/4+ -> 6/13/17/20)
#define ZRE_W_CONF_TIER     10    // rank of the best source (0-10)
#define ZRE_W_SWEPT         10    // liquidity at the zone was already swept
#define ZRE_W_HTF           14    // HTF structural bias agrees with the zone side
#define ZRE_W_D1            6     // D1 structure agrees with the zone side
#define ZRE_W_FRESH         20    // recency of the zone (age known) / 10 when unknown

enum ENUM_ZRE_SIDE
{
   ZRE_SUPPORT    = 0,
   ZRE_RESISTANCE = 1
};

struct SZREZone
{
   string        id;           // deterministic: side + normalized lo/hi
   double        lo;
   double        hi;
   ENUM_ZRE_SIDE side;         // v6.4.2: durable CAUSAL role (birth-bar side, then
                               // flipped only by a closed-bar break) - not "where the
                               // last close happened to sit" (that re-labelled zones daily)
   int           strength;     // ZONE STRENGTH 0-100 (evidence quality)
   int           touches;      // prior touch episodes (closed bars before the last one)
   string        sources;      // sorted unique source tokens joined by '+'
   bool          swept;
   bool          htf_aligned;  // HTF bias agrees with the side
   int           age_bars;     // bars since creation; -1 when no source has a birth bar
   int           units;        // independent source units behind the confluence points
   string        detail;       // weight breakdown (tooltip text)
   // v6.5.0 (audit BUG-09): the split of `strength` into the level's own quality
   // and the directional HTF/D1 term that was added to it. strength is UNCHANGED
   // (== clamp(intrinsic+context,0,100)); these two are reporting/recovery aids
   // consumed only by the Reaction Signal Layer. ZRE_SameZones ignores them.
   int           intrinsic;    // touches + sources + tier + swept + freshness  (max 80)
   int           context;      // HTF + D1                                     (max 20)
};

struct SZRECand
{
   double lo;
   double hi;
   string tokens;              // sorted unique tokens joined by '+'
   int    units;               // independent contribution to the confluence count (>=0)
   int    tier;                // 0-10 rank of the best source
   bool   swept;
   int    born_bar;            // creation bar, -1 unknown
};

struct SZREContext
{
   int    closed;              // last closed bar index (rates_total-2)
   double atr;
   double tol;                 // merge tolerance (ConfluentSRMergeTolerance)
   double touch_tol;
   double max_h;               // merge never exceeds this height
   double close_px;            // close of the closed bar
   int    hist;                // touch look-back in bars
   int    fresh_bars;
   int    htf_bias;            // g_htf_bias
   int    d1_bias;             // +1 BULLISH / -1 BEARISH / 0
   int    min_score;
   int    max_zones;
};

SZREZone g_zre_zones[];
datetime g_zre_built_time=0;
int      g_zre_cand_count=0;      // raw candidates in the last rebuild (diagnostic)

// ---- Stage 2-8 types ------------------------------------------------
#define ZRE_MAX_SIGNALS     200   // hard cap on logged signals (signal + outcome rows)
#define ZRE_MAX_PATHS       3     // at most this many projections on the chart
#define ZRE_ALERT_RING      32    // deterministic alert ids remembered
#define ZRE_MIN_RANGE_ATR   0.50  // a rejection bar must span at least this x ATR
// ZONE REACTION SCORE weights (sum = 100). Evidence quality, not a forecast.
#define ZRE_P_ZONE          30    // zone strength scaled to 30
#define ZRE_P_REJECT        25    // wick 10 + engulfing 6 + sweep-reclaim 5 + close location 4
#define ZRE_P_VOLUME        10
#define ZRE_P_HTF           15    // HTF 9 + D1 6
#define ZRE_P_LOCATION      10    // premium/discount 4 + VWAP 3 + EMA 3
#define ZRE_P_ROOM          10    // no near barrier between entry and target
// outcome end reasons
#define ZRE_END_OPEN        0
#define ZRE_END_SL          1
#define ZRE_END_TP3         2
#define ZRE_END_TIMEOUT     3
#define ZRE_END_STALE       4     // bar history changed under the signal: excluded from statistics

enum ENUM_ZRE_STATE
{
   ZRE_ST_IDLE               = 0,
   ZRE_ST_APPROACHING        = 1,
   ZRE_ST_TOUCHED_PREVIEW    = 2,   // live candle only, NOT confirmed
   ZRE_ST_REACTION_CONFIRMED = 3,   // closed-bar rejection
   ZRE_ST_BROKEN             = 4,   // closed beyond the zone by > InpZREBreakATR x ATR
   ZRE_ST_EXPIRED            = 5,
   // v6.4.2 AUDIT-Z3: the two states the audit contract asks for were missing.
   // HELD    = a closed bar touched the role edge and the close came back on the
   //           protected side (wick reclaimed) without qualifying as a signal -
   //           "close back above support = HELD, not BROKEN".
   // FLIPPED = the zone was broken on an EARLIER closed bar and price now holds
   //           the other side; the level is then traded with the OPPOSITE role.
   ZRE_ST_HELD               = 6,
   ZRE_ST_FLIPPED            = 7
};

struct SZREParams
{
   double approach_atr;
   double break_atr;
   int    expire_bars;
   double max_pen_atr;
   double min_wick;
   bool   inside_reclaim;
   int    min_evidence;
   double vol_support;
   int    min_score;
   int    entry_mode;          // ENUM_ZRE_ENTRY_MODE
   int    project_bars;
   double stop_zone_atr;
   double conflict_gap;
   int    fresh_entry_bars;
   int    weak_zone;
   double min_rr1;
   double sl_buf_atr;
   double max_stop_atr;
   double tick;
   int    min_sample;
};

struct SZREBar
{
   double o;
   double h;
   double l;
   double c;
};

struct SZREEvidence               // direction-resolved by the caller
{
   bool   engulf;                 // engulfing candle in the trade direction
   bool   displacement;           // displacement candle in the trade direction
   bool   volume_valid;
   double volume_ratio;           // g_quant.volume_ratio
   int    htf_bias;               // +1 / 0 / -1
   int    d1_bias;                // +1 / 0 / -1
   int    pd_state;               // +1 favourable (discount for BUY, premium for SELL) / 0 / -1
   int    vwap_state;             // +1 above VWAP / -1 below / 0 at / 2 unknown
   int    ema_state;              // +1 above slow EMA / -1 below / 0 at / 2 unknown
};

struct SZRERejection
{
   bool   valid;
   bool   touched;
   bool   reclaimed;
   bool   accepted;               // closed on the wrong side of the reclaim level
   bool   wick_ok;
   bool   engulf;
   bool   sweep_reclaim;
   bool   volume_ok;
   bool   displacement;
   int    groups;                 // independent evidence groups that fired
   double wick_ratio;
   double penetration_atr;
   double close_loc;              // (close-low)/range
   string reason;                 // why not valid ("" when valid)
};

struct SZREZoneStatus              // parallel to g_zre_zones
{
   ENUM_ZRE_STATE base_state;     // from closed-bar facts only
   ENUM_ZRE_STATE state;          // base_state, or TOUCHED_PREVIEW from the live candle
   double         dist_atr;       // gap between the last close and the zone
   bool           flipped;        // role reversed by an earlier closed break
   bool           reaction;       // closed-bar rejection confirmed
   bool           live_touch;     // live candle overlaps the zone (unconfirmed)
   string         note;           // rejection reason / signal outcome text
};

struct SZRESignal                  // signal data: written once, never edited
{
   string   id;
   string   zone_id;
   bool     is_buy;
   datetime bar_time;             // closed rejection bar
   int      bar_index;
   double   zone_lo;
   double   zone_hi;
   int      zone_strength;
   string   zone_sources;
   double   atr;
   double   entry;
   double   sl;
   double   tp1;
   double   tp2;
   double   tp3;
   double   stop_lo;              // STOP ZONE (at TP3)
   double   stop_hi;
   double   rr1;
   double   rr2;
   double   rr3;
   int      score;                // ZONE REACTION SCORE 0-100
   string   score_detail;
   bool     htf_aligned;
};

struct SZREOutcome                 // outcome data: written after the fact only
{
   int      last_bar;             // last bar folded in (idempotent advance)
   int      end_reason;           // ZRE_END_*
   int      best_target;          // 0..3 highest target touched
   bool     sl_hit;
   double   mfe_r;
   double   mae_r;
   int      bars_to_tp1;          // -1 = not reached
   int      bars_to_end;
   datetime end_time;
};

struct SZREStats
{
   int    logged;
   int    resolved;               // ended by SL / TP3 / timeout
   int    open;                   // still running = censored
   int    stale;
   int    timeouts;
   int    sl_first;               // SL touched before any target
   int    tp1;
   int    tp2;
   int    tp3;
   double avg_mfe;
   double avg_mae;
   double avg_bars_tp1;
   bool   sufficient;             // resolved >= InpMinHistoricalSampleSize
};

struct SZREVerdict
{
   int    kind;                   // +1 BUY, -1 SELL, 0 NO TRADE
   int    sig_index;              // index inside the candidate array passed in
   string sig_id;
   int    score;
   double entry;
   double sl;
   double tp1;
   double tp2;
   double tp3;
   double rr1;
   bool   smc_confluence;         // display tag only
   string reason;                 // NO TRADE reason
   string label;                  // "BEST ZONE ENTRY (score X/100)"
};

SZREZoneStatus g_zre_status[];
SZRESignal     g_zre_sig[];
SZREOutcome    g_zre_out[];
SZREVerdict    g_zre_verdict;
SZREStats      g_zre_stats;
string         g_zre_alert_ring[ZRE_ALERT_RING];
int            g_zre_alert_pos=0;
string         g_zre_idle_note="";
string         g_zre_preview_sig="";
string         g_zre_path_first_obj="";
int            g_zre_draw_count=0;

//====================================================================
// v6.5.0 REACTION SIGNAL LAYER (RXN) - types
//--------------------------------------------------------------------
// WHY THIS LAYER EXISTS (audit: docs/KLJ_V6.5.0_REACTION_LAYER_AUDIT.md)
//
// ZRE (Layer D) correctly DETECTS a closed-bar zone rejection, but the only
// object it can publish (SZRESignal) is gated on full execution geometry:
// RR1 >= InpMinRR1 (:25376) and score >= InpZREMinScore (:26341). When either
// fails, ZRE_TryBuildSignal returns false, no SZRESignal is created, and
// MarkZREEntry (:26769) is never called - so a valid market reaction leaves no
// trace on the chart at all. Separately, CalculateAITradeSetup (:16183) reads
// no ZRE state whatsoever, so the reaction cannot reach the authoritative lane
// either. Measured on the audit's XAUUSD news-rally scenario the reaction score
// is 50-60 against a gate of 65, with a theoretical ceiling of 75, because a
// counter-trend zone is charged for opposing HTF/D1 twice (BUG-09) and the
// displacement evidence group is arithmetically unreachable on a rejection bar
// (BUG-02: wick/range >= 0.50 forces body/range <= 0.50 < the 0.55 required).
//
// RXN sits BETWEEN raw ZRE observation and final execution authority:
//
//   ZONE ENGINE -> LIQUIDITY ENGINE -> REJECTION ENGINE -> DISPLACEMENT ENGINE
//     -> STRUCTURE ENGINE -> [RXN: classify] -> CORE EXECUTION / RETEST LAYER
//
// CONTRACT (identical in spirit to ZRE's, guarded the same way):
//   * RXN NEVER creates, mutates, invalidates, confirms or authorizes a setup.
//   * RXN NEVER calls a trading function. There is no order anywhere in it.
//   * RXN classifies market state and publishes an evidence object. That is all.
//   * Its ONE interaction with Layer A is a request to the EXISTING terminal
//     path LifecycleInvalidateActive(), gated by InpRXNPromoteOpposite, and only
//     for a setup that has NOT confirmed yet (state ARMED / PREVIEW). This fixes
//     BUG-05 (an old BUY setup blinding a new SELL reaction for up to
//     InpRetestTimeoutBars bars) WITHOUT removing setup ownership.
//   * Every published fact is closed-bar with availability_time <= decision_time.
//   * The forming bar is preview only and can never promote a level.
//   * RXN keeps NO latched state between bars: each closed bar recomputes the
//     whole reaction track over a bounded window of closed bars. That makes
//     incremental processing and a full chronological rebuild agree by
//     construction (audit section 18 / TEST 13).
//
// SCORE SEMANTICS - do not conflate these (audit section 24.4):
//   zone_strength       ZRE's published 0-100, INCLUDES the HTF/D1 context term
//   zone_intrinsic      same scale EXCLUDING HTF/D1 (new, from ZRE_ScoreZoneEx)
//   reaction_score      RXN's 0-100 EVIDENCE QUALITY of the reaction.
//                       It is NOT a probability, NOT a win rate, NOT a forecast.
//                       The system has never been statistically calibrated and
//                       this layer does not claim otherwise.
//   setup_quality_score / confidence / reliability / causal_path_score
//                       unchanged, owned by the core engine.
//   reaction_score authorizes the RXN LEVEL. It NEVER authorizes an entry.
//====================================================================
#define RXN_MAX_RECORDS      200   // bounded reaction record ring (matches ZRE_MAX_SIGNALS)
#define RXN_ALERT_RING        32   // deterministic alert ids remembered
#define RXN_MAX_EVIDENCE_LINES 14  // cap on the rendered evidence checklist
#define RXN_MAX_PATH_NODES     8   // cap on the rendered causal-path nodes
// RXN REACTION SCORE weights (sum = 100). Evidence quality, not a forecast.
// HTF/D1 is charged exactly ONCE, in RXN_P_CONTEXT, with a non-zero floor for
// "opposed" so a counter-trend reaction can no longer be arithmetically erased.
#define RXN_P_ZONE            25   // zone_intrinsic scaled to 25
#define RXN_P_ARRIVAL         10   // penetration quality 4 + close-location quality 6
#define RXN_P_REJECT          25   // wick 10 + reclaim 8 + engulfing 4 + close-vs-zone 3
#define RXN_P_LIQUIDITY       12   // pool present 4 + swept 5 + sweep quality 3 (8 when NOT_APPLICABLE)
#define RXN_P_DISPLACEMENT    13   // follow-through displacement 7 + consequence 4 + expansion 2
#define RXN_P_STRUCTURE       10   // MSS 10 / CHoCH 8 / BOS 6 / none 0
#define RXN_P_CONTEXT          5   // HTF/D1/PD/VWAP/EMA - contextual only, never a veto

// Reaction level: the explicit three (four) signal semantics the audit requires.
// LEVEL 5 is MIRRORED from the existing execution engine, never asserted by RXN.
enum ENUM_RXN_LEVEL
{
   RXN_LEVEL_NONE              = 0,   // nothing relevant
   RXN_LEVEL_WATCH             = 1,   // price entered an important zone - NOT a recommendation
   RXN_LEVEL_REACTION          = 2,   // the market REACTED at the zone
   RXN_LEVEL_STRONG_REACTION   = 3,   // reaction + directional displacement
   RXN_LEVEL_CONFIRMED         = 4,   // reaction + displacement + structure
   RXN_LEVEL_EXECUTION_READY   = 5    // LEVEL 4 AND the core execution engine independently confirmed
};

// Causal phase machine. R0..R9 for resistance (SELL) and B0..B9 for support
// (BUY) are the SAME enum: the side only flips the comparison direction, which
// is what guarantees BUY/SELL symmetry by construction rather than by copy.
enum ENUM_RXN_PHASE
{
   RXN_P0_NO_ZONE              = 0,   // R0/B0 no relevant zone available
   RXN_P1_ZONE_ACTIVE          = 1,   // R1/B1 the zone exists (kept OR recovered)
   RXN_P2_APPROACHING          = 2,   // R2/B2 close within the approach band
   RXN_P3_ENTERED              = 3,   // R3/B3 a closed bar reached the zone
   RXN_P4_LIQUIDITY_TEST       = 4,   // R4/B4 a pool is in range (swept or NOT_APPLICABLE)
   RXN_P5_REJECTION            = 5,   // R5/B5 bounded penetration + RECLAIM (CASE B)
   RXN_P6_DISPLACEMENT         = 6,   // R6/B6 directional displacement AFTER the rejection
   RXN_P7_STRUCTURE            = 7,   // R7/B7 MSS/BOS/CHoCH available after the displacement
   RXN_P8_REACTION_CONFIRMED   = 8,   // R8/B8 P5 and P6 and P7
   RXN_P9_EXECUTION_READY      = 9    // R9/B9 mirrored from the core execution engine only
};

// Zone-interaction outcome: the BREAKOUT vs REJECTION discriminator (CASE A/B).
enum ENUM_RXN_OUTCOME
{
   RXN_OC_NONE                 = 0,   // no interaction on the evaluated bar
   RXN_OC_REJECTION            = 1,   // CASE B: traded through and closed back on the near side
   RXN_OC_ACCEPTANCE           = 2,   // CASE A: closed inside/beyond the zone - NOT a rejection
   RXN_OC_BREAKOUT             = 3    // CASE A maintained for InpRXNAcceptBars consecutive closes
};

// Liquidity applicability. "NO SWEEP must not automatically mean NO REACTION":
// when no pool is in range the evidence is NOT_APPLICABLE and is scored
// neutrally-high, so the reaction is neither rewarded nor punished for it.
enum ENUM_RXN_LIQ_APPLY
{
   RXN_LIQ_NONE                = 0,   // no pool in range -> NOT_APPLICABLE
   RXN_LIQ_PRESENT             = 1,   // a pool is in range and still resting
   RXN_LIQ_SWEPT               = 2    // the pool was traded through and closed back
};

// Execution state, reported separately from the reaction level so the panel can
// say "a reaction occurred" and "execution is not ready because X" at once.
enum ENUM_RXN_EXEC
{
   RXN_EXEC_NONE               = 0,   // no reaction, nothing to execute
   RXN_EXEC_WAITING_RETEST     = 1,   // reaction confirmed, the core has not retested
   RXN_EXEC_BLOCKED_OWNERSHIP  = 2,   // another setup owns the execution lane
   RXN_EXEC_BLOCKED_TOPDOWN    = 3,   // the veto-only D1->M5 chain withholds it
   RXN_EXEC_BLOCKED_RR         = 4,   // RR1 below the documented floor
   RXN_EXEC_BLOCKED_GEOMETRY   = 5,   // entry/SL/targets could not be ordered
   RXN_EXEC_BLOCKED_SPREAD     = 6,   // spread above InpMaxSpreadPts
   RXN_EXEC_READY              = 7    // the core engine independently confirmed
};

// One liquidity probe result. Populated ONLY from the existing liquidity master
// (g_liquidity[] via BinarySearchNearestLiquidity / g_liq_price_idx) - RXN does
// not contain a second sweep detector (audit BUG-04).
struct SRxnLiquidity
{
   int      apply;               // ENUM_RXN_LIQ_APPLY
   string   pool_type;           // EQH / EQL / PDH / PDL / PWH / PWL / SESS_H / SESS_L / BSL / SSL
   double   pool_price;
   int      pool_bar;
   datetime pool_time;
   int      pool_priority;
   bool     pool_available;      // availability_time <= the decision boundary (causality)
   bool     swept;               // traded through AND closed back on a closed bar
   int      sweep_bar;
   datetime sweep_time;
   datetime sweep_availability;  // when the sweep became knowable
   double   sweep_depth_atr;     // how far through the pool the sweep traded
   int      sweep_quality;       // 0 none / 1 weak / 2 valid / 3 high (existing ENUM_SWEEP_QUALITY scale)
   string   pool_id;
   string   sweep_id;
};

// Windowed displacement result. Fixes BUG-02: displacement is a FOLLOW-THROUGH
// property, so it is searched on bars strictly AFTER the rejection bar instead
// of on the rejection bar itself, where it is geometrically impossible.
struct SRxnDisplacement
{
   bool     detected;
   int      bar;                 // the follow-through bar that carried it
   datetime time;
   double   body_atr;
   double   range_atr;
   double   body_range_ratio;
   double   close_location;
   int      consecutive;         // same-direction bars ending at `bar`
   bool     expansion;           // range >= 1.40 ATR (existing ci.is_expansion)
   bool     fvg_created;         // a causal FVG was created by the leg
   bool     leg_validated;       // a CE_DISPLACEMENT leg exists for it
   bool     consequence;         // fvg_created || leg_validated || a structure break followed
   int      quality;             // 0..4 on the existing ENUM_DISP_QUALITY scale
   int      points;              // 0..RXN_P_DISPLACEMENT
   string   detail;
};

// Structure consequence. Read from the EXISTING structure master, never
// re-derived: g_structures[] (MSS/BOS/CHoCH) cross-checked with the causal
// graph's CE_MSS / CE_BOS / CE_CHOCH events, availability-gated.
struct SRxnStructure
{
   bool     detected;
   string   type;                // "MSS" / "CHoCH" / "BOS" / ""
   bool     aligned;             // the break agrees with the reaction direction
   int      bar;
   datetime time;
   datetime availability_time;   // must be <= the decision boundary
   int      points;              // 0..RXN_P_STRUCTURE
   string   detail;
};

// The structured evidence object required by the audit (section 24.6).
// Holds the full causal tuple so every important bar stays referenceable:
// zone entry, sweep, rejection, displacement, structure, confirmation.
struct SRxnEvidence
{
   bool     valid;
   int      direction;           // +1 BUY / -1 SELL / 0 none
   // --- zone -----------------------------------------------------------
   string   zone_id;
   double   zone_lo;
   double   zone_hi;
   int      zone_strength;       // ZRE's published strength (includes context)
   int      zone_intrinsic;      // strength excluding the HTF/D1 term
   int      zone_context;        // the HTF/D1 contribution that was removed
   bool     zone_detected;
   bool     zone_recovered;      // the zone was dropped by ZRE's min-score filter
   datetime zone_time;
   string   zone_tf;
   string   zone_sources;
   // --- arrival --------------------------------------------------------
   bool     approach_detected;
   bool     touch_detected;
   int      outcome;             // ENUM_RXN_OUTCOME
   double   penetration_atr;
   double   pen_budget;          // regime-scaled penetration budget actually applied
   bool     strict_reclaim;      // the close came back beyond the NEAR edge (not just the midpoint)
   bool     close_outside_zone;  // the close finished outside the zone on the protected side
   double   close_loc;           // (close-low)/range of the interaction bar
   double   prev_close;          // close of the bar before the interaction bar
   bool     prev_dir_reversed;   // the interaction bar closed against that prior close
   int      accept_bars;         // consecutive closes beyond the far edge
   // --- liquidity ------------------------------------------------------
   SRxnLiquidity liq;
   // --- rejection ------------------------------------------------------
   bool     rejection_detected;
   int      rejection_points;    // 0..RXN_P_REJECT
   int      wick_points;
   int      reclaim_points;
   int      close_points;
   int      engulf_points;
   double   wick_ratio;
   bool     reclaimed;
   bool     accepted;
   bool     engulf;
   int      evidence_groups;
   string   rejection_reason;
   // --- displacement / structure ---------------------------------------
   SRxnDisplacement disp;
   SRxnStructure    struct_ev;
   bool     fvg_detected;
   bool     ob_detected;
   // --- context (stamped, so the audit trail is complete) ---------------
   int      htf_alignment;       // +1 aligned / 0 neutral / -1 opposed
   int      d1_alignment;
   datetime htf_bias_time;
   datetime d1_bias_time;
   int      pd_context;          // +1 favourable / 0 neutral / -1 unfavourable
   int      vwap_state;
   int      ema_state;
   int      vol_regime;          // ENUM_VOL_CLASS of the interaction bar
   double   atr_ratio;
   int      context_points;      // 0..RXN_P_CONTEXT
   // --- result ---------------------------------------------------------
   int      arrival_points;      // 0..RXN_P_ARRIVAL
   int      zone_points;         // 0..RXN_P_ZONE
   int      liquidity_points;    // 0..RXN_P_LIQUIDITY
   int      reaction_score;      // 0..100 EVIDENCE QUALITY (not a probability)
   string   score_detail;
   // --- causal tuple ---------------------------------------------------
   int      origin_bar;          // the bar price entered the zone
   datetime origin_time;
   int      rejection_bar;
   datetime rejection_time;
   int      confirmation_bar;    // the bar the last required fact became available
   datetime confirmation_time;
   int      available_bar;
   datetime availability_time;   // decision boundary = the next bar's open
   string   causal_parent_id;
   // --- classification -------------------------------------------------
   int      phase;               // ENUM_RXN_PHASE actually reached
   int      level;               // ENUM_RXN_LEVEL
   int      exec_state;          // ENUM_RXN_EXEC
   string   suppression_reason;  // why it was NOT promoted further ("" when promoted)
   string   path_text;           // "RESISTANCE -> BSL SWEEP -> REJECTION -> ..."
};

// A persisted reaction record. Written once per (side, zone, origin bar) and
// never edited afterwards, so a rebuild cannot silently rewrite history.
struct SRxnRecord
{
   string   id;                  // deterministic: RXN|side|zone_id|origin_bar
   bool     is_buy;
   int      level;
   int      phase;
   int      reaction_score;
   int      zone_strength;
   int      zone_intrinsic;
   double   zone_lo;
   double   zone_hi;
   string   zone_sources;
   int      origin_bar;
   datetime origin_time;
   int      rejection_bar;
   datetime rejection_time;
   int      confirmation_bar;
   datetime confirmation_time;
   datetime availability_time;
   int      exec_state;
   string   exec_reason;
   string   path_text;
   string   score_detail;
   string   evidence_text;     // the checklist, newline-joined (bounded by RXN_MAX_EVIDENCE_LINES)
   int      evidence_count;
   bool     alerted;
   bool     promoted;            // this reaction released an opposite ARMED setup
};

struct SRxnParams
{
   bool   enabled;
   int    track_bars;            // bounded recomputation window
   int    confirm_window;        // displacement/structure must land within this many bars
   int    min_zone_intrinsic;    // intrinsic floor for recovering a ZRE-dropped zone
   int    min_reaction_score;    // LEVEL 1 -> 2
   int    min_strong_reaction_score;      // LEVEL 2 -> 3
   int    min_confirmed_score;   // LEVEL 3 -> 4
   int    promote_score;         // a CONFIRMED opposite reaction may release an ARMED setup
   int    max_zone_extra;        // recovered/tail zones RXN may evaluate beyond InpZREMaxZones
   int    accept_bars;           // consecutive closes beyond the far edge = maintained breakout
   double pen_vol_mult;          // penetration budget multiplier in VOL_EXTREME only
   double disp_body_extreme;     // body/range required for displacement in VOL_EXTREME
   bool   show_reaction;
   bool   show_suppression;
   bool   debug;
   bool   alerts;
   bool   promote_opposite;
   // inherited, never re-defined (audit section 23.1: no existing default moved)
   double approach_atr;
   double break_atr;
   double max_pen_atr;
   double min_wick;
   bool   inside_reclaim;
   int    min_evidence;
   double min_rr1;
   int    max_spread_pts;
   double tick;
};

// Per-bar candle primitives. Filled by the adapter from the EXISTING
// AnalyzeCandleIntelligence so RXN introduces no new candle thresholds; the
// decision logic over them is pure and therefore harness-testable.
struct SRxnBarIntel
{
   int      bar;                 // absolute bar index
   bool     valid;
   bool     up;                  // close > open
   bool     down;                // close < open
   double   body_atr;            // |close-open| / ATR
   double   range_atr;           // (high-low) / ATR
   double   body_range_ratio;    // |close-open| / (high-low)
   double   close_location;      // (close-low) / (high-low)
   bool     is_displacement;     // ci.is_displacement   (existing engine verdict)
   bool     is_expansion;        // ci.is_expansion
   bool     follow_through;      // ci.follow_through
   int      consecutive;         // ci.consecutive_directional
   bool     imbalance;           // ci.imbalance_present (FVG-creation primitive)
   bool     volume_expansion;    // ci.volume_expansion
   bool     engulfing;           // ci.is_engulfing
   double   volume_ratio;        // bar volume / trailing mean, same baseline the engine uses
   double   atr;                 // the per-bar ATR this row was measured against
   bool     fvg_created;         // adapter: a causal CE_FVG available on this bar
   bool     leg_validated;       // adapter: a causal CE_DISPLACEMENT available on this bar
};

SRxnRecord g_rxn_rec[];
SRxnEvidence g_rxn_best_sell;
SRxnEvidence g_rxn_best_buy;
SRxnEvidence g_rxn_live;             // best reaction of the current closed bar (any side)
string     g_rxn_alert_ring[RXN_ALERT_RING];
int        g_rxn_alert_pos=0;
int        g_rxn_level_sell=0;       // ENUM_RXN_LEVEL of g_rxn_best_sell
int        g_rxn_level_buy=0;        // ENUM_RXN_LEVEL of g_rxn_best_buy
string     g_rxn_suppression="";     // rendered suppression card text
int        g_rxn_evaluated=0;        // zones evaluated on the last closed bar (diagnostic)
int        g_rxn_recovered=0;        // ...of those, how many were ZRE-dropped and recovered
datetime   g_rxn_built_time=0;
string     g_rxn_draw_sig="";
bool       g_rxn_live_at_zone=false;   // forming candle is back at the reacting zone (PREVIEW ONLY)
SRxnBarIntel g_rxn_intel[];            // shared per-bar candle primitives for the track window
int        g_rxn_intel_closed=-1;      // the closed bar the window was built for (-1 = none)
int        g_rxn_draw_count=0;
SZREZone   g_rxn_extra_zones[];      // zones ZRE dropped/truncated that RXN still evaluates

